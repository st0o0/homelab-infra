{#- Grouped diff of secret key changes with rename detection -#}
{%- set _hosts = groups['all'] | sort -%}
{%- set _host_re = '^(' ~ _hosts | join('|') ~ ')_' -%}
{%- set _global_added = _added | reject('match', _host_re) | sort | list -%}
{%- set _global_removed = _removed | reject('match', _host_re) | sort | list -%}

=== Secret key changes ===
{% if _global_added or _global_removed %}
── Global ──
{%- for k in _global_added %}
  + {{ k }}
{%- endfor %}
{%- for k in _global_removed %}
  - {{ k }}
{%- endfor %}
{% endif %}
{%- for host in _hosts -%}
{%- set ha = _added | select('match', '^' ~ host ~ '_') | sort | list -%}
{%- set hr = _removed | select('match', '^' ~ host ~ '_') | sort | list -%}
{%- if ha or hr %}
── {{ host }} ──
{%- set ns = namespace(renames=[], used_a=[], used_r=[]) -%}
{%- for a in ha -%}
{%- set ap = a[(host | length + 1):].split('_') -%}
{%- for r in hr -%}
{%- if r not in ns.used_r and a not in ns.used_a -%}
{%- set rp = r[(host | length + 1):].split('_') -%}
{%- if ap[0] == rp[0] and ap[-1] == rp[-1] and ap | length == rp | length and a != r -%}
{%- set ns.renames = ns.renames + [{'old': r[(host | length + 1):], 'new': a[(host | length + 1):]}] -%}
{%- set ns.used_a = ns.used_a + [a] -%}
{%- set ns.used_r = ns.used_r + [r] -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- for r in ns.renames %}
  ~ {{ r.old }} → {{ r.new }}
{%- endfor %}
{%- for k in ha | reject('in', ns.used_a) %}
  + {{ k[(host | length + 1):] }}
{%- endfor %}
{%- for k in hr | reject('in', ns.used_r) %}
  - {{ k[(host | length + 1):] }}
{%- endfor %}
{% endif -%}
{%- endfor %}
Summary: +{{ _added | length }}  -{{ _removed | length }}  ~{{ _unchanged_count }} unchanged