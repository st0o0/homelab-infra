# Managed by Ansible -- do not edit manually.
x-logging: &default-logging
  driver: json-file
  options:
    max-size: 10m
    max-file: "3"

services:
{% if agent_bifrost %}
  bifrost:
    image: ghcr.io/st0o0/bifrost:{{ agent_bifrost_image_tag }}
    container_name: agent-bifrost
    restart: unless-stopped
    logging: *default-logging
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - BIFROST_PRIVATE_KEY=${BIFROST_PRIVATE_KEY}
      - BIFROST_ADDRESS=${BIFROST_ADDRESS}
      - BIFROST_LISTEN_PORT=${BIFROST_LISTEN_PORT}
      - BIFROST_MTU=${BIFROST_MTU}
      - BIFROST_PEER_PUBLIC_KEY=${BIFROST_PEER_PUBLIC_KEY}
      - BIFROST_PEER_ENDPOINT=${BIFROST_PEER_ENDPOINT}
      - BIFROST_PEER_ALLOWED_IPS=${BIFROST_PEER_ALLOWED_IPS}
      - BIFROST_PEER_KEEPALIVE=${BIFROST_PEER_KEEPALIVE}
      - BIFROST_PEER_PRESHARED_KEY=${BIFROST_PEER_PRESHARED_KEY}
      - BIFROST_INTERFACE=wg0
      - BIFROST_CHECK_INTERVAL=30
      - BIFROST_STALE_AFTER=135
      - BIFROST_RESOLVE=on
      - BIFROST_RECONNECT=on
      - BIFROST_HEALTHCHECK=on
      - BIFROST_PROBE=off
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 256M
        reservations:
          memory: 128M

  eir:
    image: ghcr.io/st0o0/eir:latest
    container_name: agent-eir
    restart: unless-stopped
    logging: *default-logging
    depends_on:
      bifrost:
        condition: service_started
    environment:
      - EIR_MASTERS=agent-bifrost
      - EIR_DISCOVERY_MODE=inspect
      - EIR_STABILIZE_WAIT=15s
      - EIR_MAX_RETRIES=3
      - EIR_RETRY_BACKOFF=5s
      - EIR_LOG_LEVEL=info
      - EIR_LOG_FORMAT=text
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    deploy:
      resources:
        limits:
          cpus: "0.10"
          memory: 64M
        reservations:
          memory: 32M

{% endif %}
  agent:
    image: ghcr.io/moghtech/komodo-periphery:${KOMODO_IMAGE_TAG:-2}
    container_name: ${PERIPHERY_CONTAINER_NAME:-agent}
    init: true
    restart: unless-stopped
    logging: *default-logging
{% if agent_bifrost %}
    network_mode: service:bifrost
    depends_on:
      bifrost:
        condition: service_started
{% endif %}
    environment:
      PERIPHERY_CORE_ADDRESS: ${PERIPHERY_CORE_ADDRESS:?PERIPHERY_CORE_ADDRESS is required}
      PERIPHERY_CONNECT_AS: ${PERIPHERY_CONNECT_AS:?PERIPHERY_CONNECT_AS is required}
      PERIPHERY_ONBOARDING_KEY: ${PERIPHERY_ONBOARDING_KEY:-}
      PERIPHERY_CORE_PUBLIC_KEYS: file:/config/keys/core.pub
      PERIPHERY_ROOT_DIRECTORY: ${PERIPHERY_ROOT_DIRECTORY:-/etc/komodo}
      PERIPHERY_INCLUDE_DISK_MOUNTS: ${PERIPHERY_INCLUDE_DISK_MOUNTS:-/etc/hostname}
      PERIPHERY_DISABLE_TERMINALS: ${PERIPHERY_DISABLE_TERMINALS:-false}
      PERIPHERY_DISABLE_CONTAINER_TERMINALS: ${PERIPHERY_DISABLE_CONTAINER_TERMINALS:-false}
      TZ: ${TZ:-Europe/Berlin}
    volumes:
      - keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      - ${PERIPHERY_ROOT_DIRECTORY:-./data}:${PERIPHERY_ROOT_DIRECTORY:-/etc/komodo}
{% for mount in agent_extra_disk_mounts %}
      - {{ mount }}:{{ mount }}:ro
{% endfor %}
    deploy:
      resources:
        limits:
          cpus: "0.25"
          memory: 128M
        reservations:
          memory: 32M

volumes:
  keys:
