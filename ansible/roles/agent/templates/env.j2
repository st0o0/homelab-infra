# Managed by Ansible -- do not edit manually.
TZ={{ agent_tz }}

# Image
KOMODO_IMAGE_TAG={{ agent_image_tag }}

# Periphery
PERIPHERY_CORE_ADDRESS={{ agent_core_address }}
PERIPHERY_CONNECT_AS={{ agent_connect_as }}
PERIPHERY_ONBOARDING_KEY={{ agent_onboarding_key }}
PERIPHERY_ROOT_DIRECTORY={{ agent_root_directory }}
PERIPHERY_INCLUDE_DISK_MOUNTS={{ agent_include_disk_mounts }}
PERIPHERY_DISABLE_TERMINALS={{ agent_disable_terminals | lower }}
PERIPHERY_DISABLE_CONTAINER_TERMINALS={{ agent_disable_container_terminals | lower }}
{% if agent_bifrost %}

# Bifrost
BIFROST_PRIVATE_KEY={{ bifrost_private_key }}
BIFROST_ADDRESS={{ bifrost_address }}
BIFROST_LISTEN_PORT={{ bifrost_listen_port }}
BIFROST_MTU={{ bifrost_mtu }}
BIFROST_PEER_PUBLIC_KEY={{ bifrost_peer_public_key }}
BIFROST_PEER_ENDPOINT={{ bifrost_peer_endpoint }}
BIFROST_PEER_ALLOWED_IPS={{ bifrost_peer_allowed_ips }}
BIFROST_PEER_KEEPALIVE={{ bifrost_peer_keepalive }}
BIFROST_PEER_PRESHARED_KEY={{ bifrost_peer_preshared_key }}
{% endif %}
