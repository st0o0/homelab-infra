# ============================================================
# Required — stack will not start without these
# ============================================================
DBGATE_LOGINS=admin
DBGATE_PATH_DATA=/docker/dbgate/data

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# DBGATE_LOGIN_PERMISSIONS=admin:admin
# DBGATE_CONNECTIONS=pg,mongo
# DBGATE_PORT=3100
# TZ=Europe/Berlin
