# ============================================================
# Required -- stack will not start without these
# ============================================================
VALKEY_PASS=changeme
VALKEY_PATH_DATA=./data

# ============================================================
# Optional -- uncomment to override defaults
# ============================================================
# VALKEY_PORT=6379
# VALKEY_MAXMEMORY=64mb
# VALKEY_MAXMEMORY_POLICY=noeviction

# Timezone (IANA); shared Komodo variable `tz`, default Europe/Berlin
# TZ=Europe/Berlin
