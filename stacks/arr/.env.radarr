# =============================================================================
# ghcr.io/radarr/radarr
# https://github.com/Radarr/Radarr
# =============================================================================

# --- Paths ---
# RADARR_PORT=1078
# RADARR_PATH_CONFIG=./data/radarr/config
# ARR_MEDIA_PATH=/data/media

# --- API Key (32-char hex, set via RADARR__AUTH__APIKEY) ---
# RADARR_API_KEY=

# --- PostgreSQL (required) ---
# RADARR_POSTGRES_HOST=
# RADARR_POSTGRES_USER=
# RADARR_POSTGRES_PASS=

# Note: PUID/PGID NOT supported - use 'user:' in compose instead
