# =============================================================================
# redis (for tracearr-redis)
# https://hub.docker.com/_/redis
# =============================================================================

# Redis is configured via CLI flags in the compose command, not environment
# variables. Common flags:
#
#   --requirepass <password>
#   --maxmemory <bytes>
#   --maxmemory-policy allkeys-lru
#   --appendonly yes
#   --save 60 1000
#
# Set these in the compose.yml 'command:' directive.
