# Required
SONARR_API_KEY=changeme
RADARR_API_KEY=changeme
TRACEARR_JWT_SECRET=changeme
TRACEARR_COOKIE_SECRET=changeme

# CIFS shares (media library + completed downloads — shared with the media
# and downloader stacks respectively, see komodo/README.md)
CIFS_MEDIA_HOST=changeme
CIFS_MEDIA_SHARE=changeme
CIFS_MEDIA_USER=changeme
CIFS_MEDIA_PASSWORD=changeme
CIFS_DOWNLOADS_HOST=changeme
CIFS_DOWNLOADS_SHARE=changeme
CIFS_DOWNLOADS_USER=changeme
CIFS_DOWNLOADS_PASSWORD=changeme

# Ports
# SONARR_PORT=1089
# RADARR_PORT=1078
# PROWLARR_PORT=1096
# SEERR_PORT=1055
# DASHBOARD_PORT=1005
# RECYCLARR_PORT=7879
# MEDIATHEKARR_PORT=1007
# FLARESOLVERR_PORT=8191
# TRACEARR_PORT=3300
# Config paths
# SONARR_CONFIG_PATH=./data/sonarr/config
# RADARR_CONFIG_PATH=./data/radarr/config
# PROWLARR_CONFIG_PATH=./data/prowlarr/config
# SEERR_CONFIG_PATH=./data/seerr/config
# DASHBOARD_CONFIG_PATH=./data/arrdashboard/config
# RECYCLARR_CONFIG_PATH=./data/recyclarr/config
# RECYCLARR_BACKUP_PATH=./data/recyclarr/backups
# MEDIATHEKARR_CONFIG_PATH=./data/mediathekarr/config
# MEDIATHEKARR_TEMP_PATH=./data/mediathekarr/temp
# MEDIA_PATH=/data/media

# Optional
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin
# SONARR_API_URL=http://sonarr:8989
# RADARR_API_URL=http://radarr:7878
# SEERR_LOG_LEVEL=debug
# FLARESOLVERR_LOG_LEVEL=info
# MEDIATHEKARR_CATEGORIES=series,movies,custom
# MEDIATHEKARR_API_BASE_URL=https://mediathekarr.pcjones.de/api/v1
# TRACEARR_DB_PASSWORD=tracearr
# TRACEARR_CORS_ORIGIN=*
# TRACEARR_LOG_LEVEL=info
