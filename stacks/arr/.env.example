# ============================================================
# Required — stack will not start without these
# ============================================================
SONARR_API_KEY=changeme
RADARR_API_KEY=changeme
PROWLARR_API_KEY=changeme
CIFS_MEDIA_HOST=changeme
CIFS_MEDIA_SHARE=changeme
CIFS_MEDIA_USER=changeme
CIFS_MEDIA_PASS=changeme
CIFS_DOWNLOADS_HOST=changeme
CIFS_DOWNLOADS_SHARE=changeme
CIFS_DOWNLOADS_USER=changeme
CIFS_DOWNLOADS_PASS=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================

# Ports
# SONARR_PORT=1089
# RADARR_PORT=1078
# PROWLARR_PORT=1096
# SEERR_PORT=1055
# MEDIATHEKARR_PORT=1007
# PINCHFLAT_PORT=8945

# Config paths
# SONARR_PATH_CONFIG=./data/sonarr/config
# RADARR_PATH_CONFIG=./data/radarr/config
# PROWLARR_PATH_CONFIG=./data/prowlarr/config
# SEERR_PATH_CONFIG=./data/seerr/config
# CONFIGARR_PATH_CONFIG=./configarr
# SEEKARR_PATH_CONFIG=./data/seekarr/config.yml
# SEEKARR_PATH_DATA=./data/seekarr/data
# MEDIATHEKARR_PATH_CONFIG=./data/mediathekarr/config
# MEDIATHEKARR_PATH_TEMP=./data/mediathekarr/temp
# PINCHFLAT_PATH_CONFIG=./data/pinchflat/config
# ARR_MEDIA_PATH=/data/media

# Service config
# SONARR_API_URL=http://sonarr:8989
# RADARR_API_URL=http://radarr:7878
# PROWLARR_API_URL=http://prowlarr:9696

# PostgreSQL (required)
# SONARR_POSTGRES_HOST=
# SONARR_POSTGRES_USER=
# SONARR_POSTGRES_PASS=
# RADARR_POSTGRES_HOST=
# RADARR_POSTGRES_USER=
# RADARR_POSTGRES_PASS=
# PROWLARR_POSTGRES_HOST=
# PROWLARR_POSTGRES_USER=
# PROWLARR_POSTGRES_PASS=
# SEERR_DB_HOST=
# SEERR_DB_USER=
# SEERR_DB_PASS=
# SEERR_DB_NAME=seerr
# MEDIATHEKARR_CATEGORIES=series,movies,custom
# MEDIATHEKARR_API_BASE_URL=https://mediathekarr.pcjones.de/api/v1
# TZ=Europe/Berlin

# User mapping (used by 'user:' in compose, not PUID/PGID env vars)
# PUID=1000
# PGID=1000
