# =============================================================================
# ghcr.io/connorgallopo/tracearr
# https://github.com/connorgallopo/tracearr
# =============================================================================

# --- Database ---
DATABASE_URL=CHANGE_ME

# --- Redis ---
# REDIS_URL=redis://tracearr-redis:6379
# REDIS_PREFIX=tracearr:

# --- Auth Secrets ---
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# --- Server ---
# PORT=3000
# HOST=0.0.0.0
# BASE_PATH=
# TRUST_PROXY=false
# GZIP_ENABLED=true

# --- Logging ---
# LOG_LEVEL=info

# --- CORS ---
# CORS_ORIGIN=*

# --- DNS ---
# DNS_CACHE_MAX_TTL=300

# --- Backup ---
# BACKUP_DIR=./backups

# --- Setup ---
# CLAIM_CODE=
# MOBILE_BETA_MODE=false

# --- OIDC (OpenID Connect) ---
# OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_SCOPE=openid profile email
# OIDC_AUTO_REGISTER=false
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_NAME_CLAIM=name
# OIDC_EMAIL_CLAIM=email
