# --- Paths ---
# SEEKARR_PATH_CONFIG=./data/seekarr/config.yml
# SEEKARR_PATH_DATA=./data/seekarr/data

# --- Search config (used by pre-deploy script) ---
# SEEKARR_SEARCH_MODE=both
# SEEKARR_SONARR_LIMIT=10
# SEEKARR_RADARR_LIMIT=15
# SEEKARR_FREQUENCY_HOURS=1
# SEEKARR_INTERVAL_MINUTES=60

# Note: API keys are injected from SONARR_API_KEY / RADARR_API_KEY
# via scripts/pre-deploy.sh
