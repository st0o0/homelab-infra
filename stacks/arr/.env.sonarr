# =============================================================================
# ghcr.io/sonarr/sonarr
# https://github.com/Sonarr/Sonarr
# =============================================================================

# --- Paths ---
# SONARR_PORT=1089
# SONARR_PATH_CONFIG=./data/sonarr/config
# ARR_MEDIA_PATH=/data/media

# --- API Key (32-char hex, set via SONARR__AUTH__APIKEY) ---
# SONARR_API_KEY=

# --- PostgreSQL (required) ---
# SONARR_POSTGRES_HOST=
# SONARR_POSTGRES_USER=
# SONARR_POSTGRES_PASS=

# Note: PUID/PGID NOT supported - use 'user:' in compose instead
