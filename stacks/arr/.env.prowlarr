# =============================================================================
# ghcr.io/prowlarr/prowlarr
# https://github.com/Prowlarr/Prowlarr
# =============================================================================

# --- Paths ---
# PROWLARR_PORT=1096
# PROWLARR_PATH_CONFIG=./data/prowlarr/config

# --- API Key (32-char hex, set via PROWLARR__AUTH__APIKEY) ---
# PROWLARR_API_KEY=

# --- PostgreSQL (required) ---
# PROWLARR_POSTGRES_HOST=
# PROWLARR_POSTGRES_USER=
# PROWLARR_POSTGRES_PASS=

# Note: PUID/PGID NOT supported - use 'user:' in compose instead
