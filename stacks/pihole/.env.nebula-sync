###############################################################################
# Nebula Sync Environment Variables
# https://github.com/lovelaze/nebula-sync
#
# Syncs Pi-hole configuration between primary and secondary instances.
###############################################################################

# =============================================================================
# Required
# =============================================================================

# Primary Pi-hole instance (source of truth)
# Format: http(s)://host_or_ip[:port]|password
PRIMARY=CHANGE_ME

# Secondary Pi-hole instances (comma-separated)
# Format: http(s)://host_or_ip[:port]|password[,...]
SECONDARIES=CHANGE_ME

# =============================================================================
# General
# =============================================================================

# Sync interval in minutes (0 = run once and exit)
# INTERVAL=30

# Run initial sync on startup before waiting for interval
# INITIAL_SYNC=true

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Full sync (overwrite secondary completely) vs. differential sync
# FULL_SYNC=false

# =============================================================================
# Selective Sync - Configuration
# =============================================================================

# Sync DNS settings
# SYNC_CONFIG_DNS=true

# Sync DHCP settings
# SYNC_CONFIG_DHCP=true

# Sync NTP settings
# SYNC_CONFIG_NTP=true

# Sync resolver settings
# SYNC_CONFIG_RESOLVER=true

# Sync database settings
# SYNC_CONFIG_DATABASE=true

# Sync web/API/CLI settings
# SYNC_CONFIG_WEBSERVER=true

# Sync privacy settings
# SYNC_CONFIG_MISC=true

# =============================================================================
# Selective Sync - Gravity / Block Lists
# =============================================================================

# Sync adlist (block list URLs)
# SYNC_GRAVITY_ADLIST=true

# Sync domain lists (whitelist/blacklist)
# SYNC_GRAVITY_DOMAINLIST=true

# Sync local DNS records (A/AAAA)
# SYNC_GRAVITY_LOCALDNSRECORDS=true

# Sync local CNAME records
# SYNC_GRAVITY_LOCALCNAMERECORDS=true

# Sync group assignments
# SYNC_GRAVITY_GROUP=true

# Sync clients
# SYNC_GRAVITY_CLIENT=true

# Sync group-client associations
# SYNC_GRAVITY_CLIENTGROUPASSIGNMENT=true

# Sync adlist-group assignments
# SYNC_GRAVITY_ADLISTGROUPASSIGNMENT=true

# =============================================================================
# Config Include / Exclude Filters
# =============================================================================

# Include only specific config keys (comma-separated, supports wildcards)
# Overrides individual SYNC_CONFIG_* toggles when set
# CONFIG_INCLUDE=

# Exclude specific config keys (comma-separated, supports wildcards)
# CONFIG_EXCLUDE=

# Include only specific DNS config keys
# CONFIG_INCLUDE_DNS=

# Exclude specific DNS config keys
# CONFIG_EXCLUDE_DNS=

# Include only specific DHCP config keys
# CONFIG_INCLUDE_DHCP=

# Exclude specific DHCP config keys
# CONFIG_EXCLUDE_DHCP=

# Include only specific NTP config keys
# CONFIG_INCLUDE_NTP=

# Exclude specific NTP config keys
# CONFIG_EXCLUDE_NTP=

# Include only specific resolver config keys
# CONFIG_INCLUDE_RESOLVER=

# Exclude specific resolver config keys
# CONFIG_EXCLUDE_RESOLVER=

# Include only specific webserver config keys
# CONFIG_INCLUDE_WEBSERVER=

# Exclude specific webserver config keys
# CONFIG_EXCLUDE_WEBSERVER=

# Include only specific misc config keys
# CONFIG_INCLUDE_MISC=

# Exclude specific misc config keys
# CONFIG_EXCLUDE_MISC=

# =============================================================================
# Webhooks
# =============================================================================

# Webhook URL to call on sync success
# WEBHOOK_URL_SUCCESS=

# Webhook URL to call on sync failure
# WEBHOOK_URL_FAILURE=

# Webhook URL to call on every sync attempt
# WEBHOOK_URL_ALWAYS=

# HTTP method for webhook calls
# WEBHOOK_METHOD=POST

# Webhook request timeout in seconds
# WEBHOOK_TIMEOUT=10

# Include sync details in webhook body
# WEBHOOK_INCLUDE_BODY=true

# Custom webhook headers (JSON format)
# WEBHOOK_HEADERS=

# Webhook retry count on failure
# WEBHOOK_RETRY_COUNT=0

# Webhook retry delay in seconds
# WEBHOOK_RETRY_DELAY=5

# =============================================================================
# Docker Secrets
# =============================================================================

# Path to file containing PRIMARY value
# PRIMARY_FILE=

# Path to file containing SECONDARIES value
# SECONDARIES_FILE=
