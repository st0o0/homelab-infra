###############################################################################
# Pi-hole Environment Variables (v6+)
# https://docs.pi-hole.net/docker/configuration/
#
# Pi-hole v6 uses FTLCONF_ prefix for FTL configuration.
# ~148 total FTLCONF vars available; only the most important are listed here.
# Full reference: https://docs.pi-hole.net/ftldns/configfile/
###############################################################################

# =============================================================================
# Docker-Specific
# =============================================================================

# Timezone (IANA format)
TZ=CHANGE_ME

# Tail the FTL log on container start (useful for docker logs)
# TAIL_FTL_LOG=1

# Run Pi-hole process as this UID
# PIHOLE_UID=999

# Run Pi-hole process as this GID
# PIHOLE_GID=999

# FTL engine command override
# FTL_CMD=no-daemon

# User to run dnsmasq as
# DNSMASQ_USER=pihole

# Additional Alpine packages to install on startup (space-separated)
# ADDITIONAL_PACKAGES=

# =============================================================================
# DNS Configuration (FTLCONF_)
# =============================================================================

# Upstream DNS servers (semicolon-separated)
# FTLCONF_dns_upstreams=8.8.8.8;8.8.4.4

# DNS listening port
# FTLCONF_dns_port=53

# DNS listening mode: all, local, single, bind
# FTLCONF_dns_listeningMode=all

# Enable DNSSEC validation
# FTLCONF_dns_dnssec=false

# Enable query logging
# FTLCONF_dns_queryLogging=true

# Enable DNS blocking
# FTLCONF_dns_blocking_active=true

# Blocking mode: NULL, IP-NODATA-AAAA, IP, NXDOMAIN, NODATA
# FTLCONF_dns_blocking_mode=NULL

# DNS cache size (number of entries)
# FTLCONF_dns_cache_size=10000

# Rate limit: max queries per interval
# FTLCONF_dns_rateLimit_count=1000

# Rate limit: interval in seconds
# FTLCONF_dns_rateLimit_interval=60

# Never forward non-FQDN queries
# FTLCONF_dns_domainNeeded=true

# Never forward reverse lookups for private ranges
# FTLCONF_dns_bogusPriv=true

# Conditional forwarding (enable to resolve local hostnames)
# FTLCONF_dns_revServers=

# =============================================================================
# Web Interface (FTLCONF_)
# =============================================================================

# Web admin password (set on first run, use pihole setpassword to change)
FTLCONF_webserver_api_password=CHANGE_ME

# Web interface port (add 's' suffix for HTTPS, e.g., 443s)
# FTLCONF_webserver_port=80

# Domain for the web interface
# FTLCONF_webserver_domain=pi.hole

# Web UI theme: default-auto, default-light, default-dark
# FTLCONF_webserver_interface_theme=default-auto

# =============================================================================
# Database / Privacy (FTLCONF_)
# =============================================================================

# Maximum days to keep queries in database (0 = indefinite)
# FTLCONF_database_maxDBdays=365

# Privacy level: 0=show everything, 1=hide domains, 2=hide domains+clients,
# 3=anonymous, 4=disabled
# FTLCONF_misc_privacylevel=0

# =============================================================================
# DHCP (FTLCONF_)
# =============================================================================

# Enable built-in DHCP server
# FTLCONF_dhcp_active=false

# DHCP range start
# FTLCONF_dhcp_start=

# DHCP range end
# FTLCONF_dhcp_end=

# DHCP router/gateway IP
# FTLCONF_dhcp_router=

# DHCP lease time in hours
# FTLCONF_dhcp_leaseTime=24

# DHCP domain
# FTLCONF_dhcp_domain=lan
