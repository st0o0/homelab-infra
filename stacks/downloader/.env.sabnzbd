# =============================================================================
# lscr.io/linuxserver/sabnzbd — Environment Variable Reference
# Docs: https://docs.linuxserver.io/images/docker-sabnzbd
# =============================================================================

# --- LinuxServer Standard ---
# User ID for file permissions (run: id -u)
PUID=CHANGE_ME
# Group ID for file permissions (run: id -g)
PGID=CHANGE_ME
# Timezone (e.g. America/New_York, Europe/London)
TZ=CHANGE_ME
# UMASK=022                            # File creation umask

# --- LinuxServer Mods ---
# DOCKER_MODS=                         # Pipe-separated list of Docker mods to apply

# --- Application ---
# HOME=/config                         # Home directory inside the container
# PYTHONIOENCODING=utf-8               # Python I/O encoding
