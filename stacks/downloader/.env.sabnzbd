# =============================================================================
# SABnzbd — Environment Variable Reference
# Image: ghcr.io/home-operations/sabnzbd
# All values shown are defaults from pre-deploy.sh — override in Komodo TOML
# =============================================================================

# --- Container (used in compose.yml) ---
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin

# --- Keys (injected by container on every start) ---
# SABNZBD_API_KEY=                        # required
# SABNZBD_NZB_KEY=                        # required

# --- Paths (used in compose.yml) ---
# SABNZBD_PORT=8080                       # Port exposed on gluetun
# SABNZBD_PATH_CONFIG=./sabnzbd/config    # Config directory
# SABNZBD_PATH_INCOMPLETE=./sabnzbd/incomplete  # Temp download dir (SSD)

# --- Network ---
# SABNZBD_HOST_WHITELIST=sabnzbd, gluetun, localhost
# SABNZBD_LOCAL_RANGES=

# --- Bandwidth / Disk ---
# SABNZBD_BANDWIDTH_MAX=                  # e.g. 40M — empty = unlimited
# SABNZBD_BANDWIDTH_PERC=100
# SABNZBD_CACHE_LIMIT=512M
# SABNZBD_DOWNLOAD_FREE=50G              # Pause when incomplete disk < this
# SABNZBD_COMPLETE_FREE=100G             # Pause when complete disk < this

# --- Downloads ---
# SABNZBD_DIRECT_UNPACK=1
# SABNZBD_DIRECT_UNPACK_THREADS=3
# SABNZBD_FLAT_UNPACK=1
# SABNZBD_PRE_CHECK=1
# SABNZBD_TOP_ONLY=1
# SABNZBD_MAX_ART_TRIES=3

# --- Duplicates ---
# SABNZBD_NO_DUPES=4                     # 0=off 1=reject 2=pause 3=fail 4=tag
# SABNZBD_NO_SERIES_DUPES=0
# SABNZBD_NO_SMART_DUPES=4
# SABNZBD_PAUSE_ON_PWRAR=1

# --- Extensions ---
# SABNZBD_UNWANTED_EXTENSIONS=ade, adp, ...
# SABNZBD_ACTION_ON_UNWANTED_EXT=2       # 0=off 1=warn 2=delete

# --- Schedule ---
# SABNZBD_SCHEDLINES=                    # e.g. "1 30 23 1234567 pause_all ", "1 0 2 1234567 resume "

# --- Sorting ---
# SABNZBD_ENABLE_SEASON_SORTING=0

# --- UI ---
# SABNZBD_WEB_DIR=Glitter
# SABNZBD_WEB_COLOR=Auto
# SABNZBD_LANGUAGE=en
# SABNZBD_REFRESH_RATE=1
# SABNZBD_QUEUE_LIMIT=20
# SABNZBD_HISTORY_LIMIT=10
# SABNZBD_HISTORY_RETENTION=30
# SABNZBD_HISTORY_RETENTION_OPTION=all

# --- Logging ---
# SABNZBD_LOG_LEVEL=1
# SABNZBD_MAX_LOG_SIZE=5242880
# SABNZBD_LOG_BACKUPS=5

# --- News Server ---
# SABNZBD_SERVER1_NAME=newsserver
# SABNZBD_SERVER1_HOST=                  # required
# SABNZBD_SERVER1_PORT=563
# SABNZBD_SERVER1_USERNAME=              # required
# SABNZBD_SERVER1_PASSWORD=              # required
# SABNZBD_SERVER1_CONNECTIONS=20
# SABNZBD_SERVER1_SSL=1

# --- Categories (dynamic, add as many as needed) ---
# SABNZBD_CAT_1_NAME=sonarr
# SABNZBD_CAT_1_DIR=sonarr
# SABNZBD_CAT_1_PP=3
# SABNZBD_CAT_1_SCRIPT=Default
# SABNZBD_CAT_1_PRIORITY=-100
