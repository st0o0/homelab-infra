# =============================================================================
# NZBGet — Environment Variable Reference
# Image: ghcr.io/nzbgetcom/nzbget
# All values shown are defaults from pre-deploy.sh — override in Komodo TOML
# =============================================================================

# --- Container (used in compose.yml) ---
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin

# --- Auth (passed to container + pre-deploy) ---
# NZBGET_USER=nzbget                      # Web-UI username
# NZBGET_PASS=                            # Web-UI password

# --- Paths: host mounts (used in compose.yml) ---
# NZBGET_PORT=6789                        # Port exposed on gluetun
# NZBGET_PATH_CONFIG=./nzbget/config      # Config directory
# NZBGET_PATH_TMP=./nzbget/tmp            # Download chunks (SSD)
# NZBGET_PATH_INTERMEDIATE=./nzbget/intermediate  # Unpack workspace (SSD)

# --- Paths: container-internal (used in nzbget.conf) ---
# NZBGET_MAIN_DIR=/config                 # Base dir for NzbDir, QueueDir, logs
# NZBGET_DEST_DIR=/data/completed         # Completed downloads (CIFS)
# NZBGET_INTER_DIR=/data/intermediate     # Unpack workspace
# NZBGET_TEMP_DIR=/data/tmp               # Download chunks
# NZBGET_NZB_DIR=/config/nzb             # NZB file backups
# NZBGET_QUEUE_DIR=/config/queue          # Queue persistence

# --- Bandwidth ---
# NZBGET_DOWNLOAD_RATE=0                  # KB/s, 0=unlimited

# --- News Server ---
# NZBGET_SERVER1_NAME=newsserver
# NZBGET_SERVER1_HOST=                    # required
# NZBGET_SERVER1_PORT=563
# NZBGET_SERVER1_USERNAME=                # required
# NZBGET_SERVER1_PASSWORD=                # required
# NZBGET_SERVER1_CONNECTIONS=20

# --- Categories (dynamic, add as many as needed) ---
# NZBGET_CAT_1_NAME=sonarr
# NZBGET_CAT_1_DIR=series
# NZBGET_CAT_1_UNPACK=yes
# NZBGET_CAT_1_ALIASES=

# --- Schedule (dynamic tasks) ---
# NZBGET_TASK_1_TIME=23:30
# NZBGET_TASK_1_WEEKDAYS=1-7
# NZBGET_TASK_1_COMMAND=PauseDownload
# NZBGET_TASK_1_PARAM=
