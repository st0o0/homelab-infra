# =============================================================================
# nzbgetcom/nzbget — Environment Variable Reference
# Docs: https://github.com/nzbgetcom/nzbget
# =============================================================================

# --- Container ---
# User ID for file permissions (run: id -u)
PUID=CHANGE_ME
# Group ID for file permissions (run: id -g)
PGID=CHANGE_ME
# Timezone (e.g. Europe/Berlin)
TZ=CHANGE_ME

# --- Web UI Auth ---
# NZBGET_USER=                           # Web UI username
# NZBGET_PASS=                           # Web UI password

# --- Paths (NZBOP_*) ---
# NZBOP_MAINDIR=/data                    # Root directory for all data
# NZBOP_DESTDIR=/data/complete           # Final download destination
# NZBOP_INTERDIR=/data/ssd/inter         # Intermediate directory (post-processing)
# NZBOP_TEMPDIR=/data/ssd/tmp            # Temporary download directory

# --- News Server ---
# NZBOP_SERVER1_HOST=                    # Usenet server hostname
# NZBOP_SERVER1_PORT=563                 # Server port (563 = SSL, 119 = plain)
# NZBOP_SERVER1_USERNAME=                # Server username
# NZBOP_SERVER1_PASSWORD=                # Server password
# NZBOP_SERVER1_CONNECTIONS=10           # Number of connections
# NZBOP_SERVER1_ENCRYPTION=yes           # Enable SSL/TLS
# NZBOP_SERVER1_CIPHER=                  # TLS cipher (empty = auto)
# NZBOP_SERVER1_RETENTION=0              # Server retention days (0 = unlimited)
# NZBOP_SERVER1_LEVEL=0                  # Priority level (0 = primary)
# NZBOP_SERVER1_GROUP=0                  # Server group (0 = default)

# --- Categories ---
# NZBOP_CATEGORY1_NAME=sonarr            # Category name used by Sonarr
# NZBOP_CATEGORY1_DESTDIR=/data/complete/sonarr
# NZBOP_CATEGORY1_UNPACK=yes             # Auto-unpack after download
# NZBOP_CATEGORY1_ALIASES=               # Alternative category names (CSV)

# NZBOP_CATEGORY2_NAME=radarr            # Category name used by Radarr
# NZBOP_CATEGORY2_DESTDIR=/data/complete/radarr
# NZBOP_CATEGORY2_UNPACK=yes

# NZBOP_CATEGORY3_NAME=mediathek         # Category name for Mediathekarr
# NZBOP_CATEGORY3_DESTDIR=/data/complete/mediathek
# NZBOP_CATEGORY3_UNPACK=yes

# --- Performance ---
# NZBOP_ARTICLECACHE=256                 # Article cache size in MB
# NZBOP_DIRECTWRITE=yes                  # Write directly to output file
# NZBOP_WRITEBUFER=1024                  # Write buffer size in KB
# NZBOP_PARREPAIR=auto                   # Par repair (auto/yes/no)
# NZBOP_PARSCAN=auto                     # Par scan (auto/limited/full)
# NZBOP_UNPACK=yes                       # Auto-unpack
# NZBOP_DIRECTUNPACK=yes                 # Unpack during download

# --- Logging ---
# NZBOP_WRITELOGKIND=detail              # Log detail level (none/detail/info)
# NZBOP_LOGLEVEL=1                       # Log level (0=none, 1=info, 2=detail, 3=debug)

# --- Network ---
# NZBOP_CONTROLIP=0.0.0.0               # Web server bind address
# NZBOP_CONTROLPORT=6789                 # Web server port
