# =============================================================================
# NZBGet — Environment Variable Reference
# Image: ghcr.io/nzbgetcom/nzbget
# All values shown are defaults from pre-deploy.sh — override in Komodo TOML
# =============================================================================

# --- Container (used in compose.yml) ---
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin

# --- Auth (passed to container + pre-deploy) ---
# NZBGET_USER=nzbget                      # Web-UI username
# NZBGET_PASS=                            # Web-UI password

# --- Paths: host mounts (used in compose.yml) ---
# NZBGET_PORT=6789                        # Port exposed on gluetun
# NZBGET_PATH_CONFIG=./nzbget/config      # Config directory
# NZBGET_PATH_TMP=./nzbget/tmp            # Download chunks (SSD)
# NZBGET_PATH_INTERMEDIATE=./nzbget/intermediate  # Unpack workspace (SSD)