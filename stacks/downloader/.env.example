# Required
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=changeme

# CIFS share (completed downloads — shared with the arr stack's mediathekarr
# volume, see komodo/README.md)
CIFS_DOWNLOADS_HOST=changeme
CIFS_DOWNLOADS_SHARE=changeme
CIFS_DOWNLOADS_USER=changeme
CIFS_DOWNLOADS_PASSWORD=changeme

