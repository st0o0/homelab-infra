# =============================================================================
# ghcr.io/qdm12/gluetun — Environment Variable Reference
# Docs: https://github.com/qdm12/gluetun-wiki
# =============================================================================

# --- VPN Core ---
# VPN provider name (e.g. mullvad, nordvpn, protonvpn, custom)
VPN_SERVICE_PROVIDER=CHANGE_ME
# wireguard or openvpn
VPN_TYPE=CHANGE_ME
# VPN_INTERFACE=tun0                   # Custom network interface name
# VPN_UP_COMMAND=                      # Command to run when VPN connects (supports {{VPN_INTERFACE}})
# VPN_DOWN_COMMAND=                    # Command to run when VPN disconnects

# --- WireGuard ---
# WireGuard client private key (base64)
WIREGUARD_PRIVATE_KEY=CHANGE_ME
# Interface address in CIDR (e.g. 10.64.0.1/32)
WIREGUARD_ADDRESSES=CHANGE_ME
# WIREGUARD_PUBLIC_KEY=                # Server public key (provider-dependent)
# WIREGUARD_PRESHARED_KEY=             # Pre-shared key for additional security
# WIREGUARD_ENDPOINT_IP=              # Target VPN server IP
# WIREGUARD_ENDPOINT_PORT=            # Target VPN server port
# WIREGUARD_ALLOWED_IPS=0.0.0.0/0,::/0  # Peer allowed IPs (CSV)
# WIREGUARD_IMPLEMENTATION=auto       # auto, kernelspace, or userspace
# WIREGUARD_MTU=                      # MTU value (typically up to 1440)
# WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=  # Keepalive interval (e.g. 25s)

# --- OpenVPN ---
# OPENVPN_USER=                        # OpenVPN username
# OPENVPN_PASSWORD=                    # OpenVPN password
# OPENVPN_PROTOCOL=udp                 # udp or tcp
# OPENVPN_VERSION=2.6                  # OpenVPN version to run
# OPENVPN_ENDPOINT_IP=                 # Target VPN server IP
# OPENVPN_ENDPOINT_PORT=               # Target VPN server port
# OPENVPN_VERBOSITY=1                  # Log verbosity level (0-11)
# OPENVPN_FLAGS=                       # Space-delimited extra flags for openvpn
# OPENVPN_ROOT=no                      # Run OpenVPN as root
# OPENVPN_CIPHERS=                     # Custom cipher (sets ncp-disable for AES GCM with PIA)
# OPENVPN_AUTH=                        # Custom auth algorithm
# OPENVPN_MSSFIX=0                     # MSS fix parameter (0 = use defaults)
# OPENVPN_CERT=                        # Client certificate (base64 part only)
# OPENVPN_KEY=                         # Client key (base64 part only)
# OPENVPN_ENCRYPTED_KEY=               # Encrypted key (base64 part only)
# OPENVPN_KEY_PASSPHRASE=              # Passphrase to decrypt encrypted key
# OPENVPN_PROCESS_USER=root            # User to run the OpenVPN subprocess
# OPENVPN_CUSTOM_CONFIG=               # Path to custom OpenVPN config file (custom provider)

# --- AmneziaWG ---
# AMNEZIAWG_PRIVATE_KEY=               # AmneziaWG client private key (base58)
# AMNEZIAWG_ADDRESSES=                 # Interface address in CIDR
# AMNEZIAWG_PUBLIC_KEY=                # Server public key (base58)
# AMNEZIAWG_ENDPOINT_IP=              # Target VPN server IP
# AMNEZIAWG_ENDPOINT_PORT=            # Target VPN server port
# AMNEZIAWG_PRESHARED_KEY=            # Pre-shared key (base64)
# AMNEZIAWG_ALLOWED_IPS=0.0.0.0/0,::/0  # Peer allowed IPs (CSV)
# AMNEZIAWG_MTU=                      # MTU value (typically up to 1440)
# AMNEZIAWG_PERSISTENT_KEEPALIVE_INTERVAL=  # Keepalive interval (e.g. 25s)
# AMNEZIAWG_JC=0                      # Junk packets count before handshake
# AMNEZIAWG_JMIN=0                    # Min size (bytes) of random junk data prefix
# AMNEZIAWG_JMAX=0                    # Max size (bytes) of random junk data prefix
# AMNEZIAWG_S1=0                      # Padding for handshake initiation packets
# AMNEZIAWG_S2=0                      # Padding for handshake response packets
# AMNEZIAWG_S3=0                      # Padding for handshake cookie reply packets
# AMNEZIAWG_S4=0                      # Padding for encrypted transport data packets
# AMNEZIAWG_H1=0                      # Header for handshake initiation
# AMNEZIAWG_H2=0                      # Header for handshake response
# AMNEZIAWG_H3=0                      # Header for cookie reply
# AMNEZIAWG_H4=0                      # Header for transport data
# AMNEZIAWG_I1=                       # Custom signature packet config
# AMNEZIAWG_I2=                       # Custom signature packet config
# AMNEZIAWG_I3=                       # Custom signature packet config
# AMNEZIAWG_I4=                       # Custom signature packet config
# AMNEZIAWG_I5=                       # Custom signature packet config

# --- Server Filtering ---
# SERVER_COUNTRIES=                    # Comma-separated list of countries
# SERVER_REGIONS=                      # Comma-separated list of regions
# SERVER_CITIES=                       # Comma-separated list of cities
# SERVER_HOSTNAMES=                    # Comma-separated server hostnames (narrowest filter)
# SERVER_NAMES=                        # Comma-separated server names (PIA and others)
# SERVER_CATEGORIES=                   # Comma-separated categories (NordVPN)
# ISP=                                 # Comma-separated list of ISPs (Mullvad)
# OWNED_ONLY=no                        # Only provider-owned servers (Mullvad; yes/no)
# FREE_ONLY=off                        # Free-tier servers only (ProtonVPN)
# STREAM_ONLY=off                      # Streaming servers only (ProtonVPN)
# SECURE_CORE_ONLY=off                 # Secure Core servers only (ProtonVPN)
# TOR_ONLY=off                         # TOR servers only (ProtonVPN)
# PORT_FORWARD_ONLY=off                # Port-forwarding-capable servers only (ProtonVPN, PIA)

# --- Port Forwarding ---
# VPN_PORT_FORWARDING=off              # Enable port forwarding (on/off, provider must support it)
# VPN_PORT_FORWARDING_PROVIDER=        # Override port forwarding code (useful with custom provider)
# VPN_PORT_FORWARDING_PORTS_COUNT=1    # Number of ports to forward (up to 5 for ProtonVPN)
# VPN_PORT_FORWARDING_STATUS_FILE=/tmp/gluetun/forwarded_port  # File to write forwarded port
# VPN_PORT_FORWARDING_LISTENING_PORTS= # Port redirections (do NOT use with torrent clients)
# VPN_PORT_FORWARDING_UP_COMMAND=      # Command to run when port forwarding is set up
# VPN_PORT_FORWARDING_DOWN_COMMAND=    # Command to run when port forwarding tears down
# VPN_PORT_FORWARDING_USERNAME=        # Username for PIA WireGuard port forwarding
# VPN_PORT_FORWARDING_PASSWORD=        # Password for PIA WireGuard port forwarding

# --- Firewall ---
# FIREWALL_VPN_INPUT_PORTS=            # Ports to allow from the VPN server side (CSV)
# FIREWALL_INPUT_PORTS=                # Ports to allow through default interface (CSV, needed for k8s sidecars)
# FIREWALL_OUTBOUND_SUBNETS=           # Subnets containers can access outside VPN (CSV of CIDRs)
# FIREWALL_IPTABLES_LOG_LEVEL=         # iptables log level (defaults to info unless global is debug)

# --- DNS ---
# DNS_UPSTREAM_RESOLVER_TYPE=dot       # How to connect upstream: dot (DNS over TLS), doh, or plain
# DNS_UPSTREAM_RESOLVERS=cloudflare    # Comma-separated upstream DNS providers
# DNS_UPSTREAM_PLAIN_ADDRESSES=        # Forward queries to plaintext DNS addresses
# DNS_CACHING=on                       # Enable DNS response caching
# DNS_UPSTREAM_IPV6=off                # Enable IPv6 DNS resolution
# DNS_UPDATE_PERIOD=24h                # Interval to update block lists and restart DNS server
# DNS_BLOCK_IPS=                       # IPs to block in DNS responses (CSV)
# DNS_BLOCK_IP_PREFIXES=               # CIDRs to block in DNS responses (CSV)
# DNS_REBINDING_PROTECTION_EXEMPT_HOSTNAMES=  # Hostnames exempt from rebinding protection (CSV)
# DNS_UNBLOCK_HOSTNAMES=               # Domain names to leave unblocked from filtering (CSV)
# BLOCK_MALICIOUS=on                   # Block known malicious hostnames and IPs
# BLOCK_SURVEILLANCE=off               # Block known surveillance hostnames and IPs
# BLOCK_ADS=off                        # Block known ad hostnames and IPs

# --- Healthcheck ---
# HEALTH_TARGET_ADDRESSES=cloudflare.com:443,github.com:443  # TCP+TLS dial targets
# HEALTH_ICMP_TARGET_IPS=1.1.1.1,8.8.8.8  # ICMP ping targets (every minute)
# HEALTH_SERVER_ADDRESS=127.0.0.1:9999     # Internal health check server address
# HEALTH_RESTART_VPN=on               # Auto-restart VPN on health failure

# --- HTTP Proxy ---
# HTTPPROXY=off                        # Enable built-in HTTP proxy
# HTTPPROXY_LOG=off                    # Log every tunnel request
# HTTPPROXY_LISTENING_ADDRESS=:8888    # HTTP proxy listen address
# HTTPPROXY_USER=                      # Proxy authentication username
# HTTPPROXY_PASSWORD=                  # Proxy authentication password
# HTTPPROXY_STEALTH=off                # Stealth mode: do not add proxy headers to requests

# --- Shadowsocks ---
# SHADOWSOCKS=off                      # Enable built-in Shadowsocks proxy
# SHADOWSOCKS_LOG=off                  # Enable Shadowsocks logging
# SHADOWSOCKS_LISTENING_ADDRESS=:8388  # Shadowsocks listen address
# SHADOWSOCKS_PASSWORD=                # Shadowsocks connection password
# SHADOWSOCKS_CIPHER=chacha20-ietf-poly1305  # AEAD cipher to use

# --- Control Server ---
# HTTP_CONTROL_SERVER_ADDRESS=:8000    # Control server listen address
# HTTP_CONTROL_SERVER_LOG=on           # Log HTTP requests to control server
# HTTP_CONTROL_SERVER_AUTH_CONFIG_FILEPATH=  # Path to TOML auth config file

# --- Updater ---
# UPDATER_PERIOD=0                     # Server data update interval (0 = disabled, min 360h recommended)
# UPDATER_PREFER_DIRECT_DOWNLOAD=no   # Prefer direct download from gluetun-servers
# UPDATER_MIN_RATIO=0.8               # Min ratio of servers found for update to succeed
# UPDATER_VPN_SERVICE_PROVIDERS=       # Providers to update (CSV, defaults to current provider)
# UPDATER_PROTONVPN_EMAIL=            # ProtonVPN email for paid server data
# UPDATER_PROTONVPN_PASSWORD=         # ProtonVPN password for paid server data

# --- Storage ---
# STORAGE_SERVERS_ENABLED=yes          # Enable reading/writing servers to disk
# STORAGE_SERVERS_DIRECTORY_PATH=/gluetun/servers  # Directory for server data files

# --- Provider-Specific ---
# PRIVATE_INTERNET_ACCESS_OPENVPN_ENCRYPTION_PRESET=strong  # PIA encryption: normal or strong

# --- General ---
# LOG_LEVEL=info                       # Log verbosity (debug, info, warning, error)
# TZ=                                  # Timezone for log timestamps (e.g. America/New_York)
# PUID=1000                            # User ID for file ownership
# PGID=1000                            # Group ID for file ownership
# PUBLICIP_ENABLED=true                # Check public IP on VPN connection
# PUBLICIP_API=ipinfo,ifconfigco,ip2location,cloudflare  # Public IP lookup services (CSV)
# PUBLICIP_API_TOKEN=                  # API token for public IP service rate limiting
# PUBLICIP_FILE=/tmp/gluetun/ip        # File to store assigned public IP
# VERSION_INFORMATION=on               # Log when newer gluetun version is available
# BORINGPOLL_GLUETUNCOM=off           # Periodic polling to support gluetun community
