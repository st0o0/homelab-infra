# Required
GRAFANA_ADMIN_PASSWORD=changeme

# Optional — defaults shown
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/
# HOST_HOSTNAME=homelab
# SCRAPE_INTERVAL=30s
# VM_RETENTION=90d
# VL_RETENTION=31d
# VL_MAX_DISK_GB=0
# VM_BIND_IP=127.0.0.1
# VLOGS_BIND_IP=127.0.0.1

# Grafana external DB (optional, default SQLite)
# GRAFANA_DB_TYPE=sqlite3
# GRAFANA_DB_HOST=
# GRAFANA_DB_NAME=grafana
# GRAFANA_DB_USER=
# GRAFANA_DB_PASSWORD=
# GRAFANA_DB_SSL_MODE=disable

# TZ=Europe/Berlin
