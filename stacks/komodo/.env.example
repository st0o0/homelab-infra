# Required
KOMODO_DATABASE_USERNAME=changeme
KOMODO_DATABASE_PASSWORD=changeme
KOMODO_INIT_ADMIN_PASSWORD=changeme
KOMODO_JWT_SECRET=changeme
KOMODO_WEBHOOK_SECRET=changeme

# SOPS secrets — path to decrypted core.config.toml with [secrets] block
# Contains stack secrets (IPs, credentials, endpoints) for [[SECRET]] interpolation
# Generate with: cd komodo && ./decrypt.sh
# KOMODO_SECRETS_FILE=/etc/komodo/core.secrets.toml

# Optional
# KOMODO_IMAGE_TAG=2
# KOMODO_HOST=https://komodo.local
# KOMODO_TITLE=Homelab
# KOMODO_PORT=9120
# KOMODO_BIND_IP=127.0.0.1
# KOMODO_FIRST_SERVER_NAME=FeelsCozyMan
# KOMODO_MONITORING_INTERVAL=15-sec
# KOMODO_RESOURCE_POLL_INTERVAL=5-min
# KOMODO_LOCAL_AUTH=true
# KOMODO_INIT_ADMIN_USERNAME=admin
# KOMODO_DISABLE_USER_REGISTRATION=true
# KOMODO_DISABLE_CONFIRM_DIALOG=false
# KOMODO_BACKUPS_PATH=komodo-backups

# Containers
# MONGO_CONTAINER_NAME=komodo-mongo
# CORE_CONTAINER_NAME=komodo-core
# PERIPHERY_CONTAINER_NAME=komodo-periphery
# MONGO_CACHE_SIZE_GB=0.25

# Periphery (local agent on the same host as Core)
# PERIPHERY_ROOT_DIRECTORY=/etc/komodo
# PERIPHERY_DISABLE_TERMINALS=false
# PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

# TZ=Europe/Berlin
