# ============================================================
# Required — stack will not start without these
# ============================================================
VW_PATH_DATA=changeme
VW_DB_HOST=changeme
VW_DB_USER=changeme
VW_DB_PASS=changeme
VW_DB_NAME=changeme

# ============================================================
# Optional — uncomment to override container defaults
# ============================================================
# VW_DOMAIN=https://vault.example.com
# VW_DISABLE_ADMIN_TOKEN=true
# VW_SIGNUPS_ALLOWED=false
# VW_DB_ENGINE=postgresql   # postgresql or mysql
# VW_DB_PORT=5432   # 3306 for mysql
# VW_DATABASE_MAX_CONNS=10   # tune up when the DB has connection limits to spare
# VW_PORT=3002
# TZ=Europe/Berlin
# PUID=1000
# PGID=1000
# VW_WEBSOCKET_ENABLED=true

# SSO via Authentik — see stacks/authentik/blueprints/30-app-vaultwarden.yaml
# VW_DOMAIN must exactly match AUTHENTIK_PROVIDER_VAULTWARDEN_REDIRECT_URI's origin
# VW_SSO_ENABLED=false
# VW_SSO_ONLY=false
# VW_SSO_AUTHORITY=https://authentik.example.com/application/o/vaultwarden/
# VW_SSO_CLIENT_ID=  # same value as AUTHENTIK_PROVIDER_VAULTWARDEN_CLIENT_ID
# VW_SSO_CLIENT_SECRET=  # same value as AUTHENTIK_PROVIDER_VAULTWARDEN_CLIENT_SECRET

# SMTP — invites, email 2FA, emergency access notifications
# VW_SMTP_HOST=
# VW_SMTP_PORT=587
# VW_SMTP_SECURITY=starttls
# VW_SMTP_FROM=vaultwarden@example.com
# VW_SMTP_FROM_NAME=Vaultwarden
# VW_SMTP_USER=
# VW_SMTP_PASS=
# VW_SMTP_AUTH_MECHANISM=Plain   # Plain, Login, or Xoauth2
# VW_SMTP_TIMEOUT=15
# VW_SMTP_ACCEPT_INVALID_CERTS=false
# VW_SMTP_ACCEPT_INVALID_HOSTNAMES=false
# VW_SMTP_EMBED_IMAGES=true   # embed images instead of linking (avoids external image loads in mail clients)
# VW_SMTP_DEBUG=false
# VW_SMTP_HELO_NAME=   # only needed if your SMTP server requires a specific HELO/EHLO hostname
