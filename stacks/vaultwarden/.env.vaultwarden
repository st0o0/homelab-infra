###############################################################################
# Vaultwarden Environment Variables
# https://github.com/dani-garcia/vaultwarden/wiki
#
# All variables support the _FILE suffix for Docker secrets.
# Example: DATABASE_URL_FILE=/run/secrets/db_url
###############################################################################

# =============================================================================
# Data Folders
# =============================================================================

# Main data folder
# DATA_FOLDER=/data

# Database connection string (SQLite default, supports PostgreSQL/MySQL)
# SQLite: data/db.sqlite3 | PostgreSQL: postgresql://user:pass@host/db
# MySQL: mysql://user:pass@host/db
# DATABASE_URL=data/db.sqlite3

# Maximum number of database connections
# DATABASE_MAX_CONNS=10

# Web vault files location
# WEB_VAULT_FOLDER=web-vault/

# Enable the web vault interface
# WEB_VAULT_ENABLED=true

# Icon cache folder
# ICON_CACHE_FOLDER=data/icon_cache

# Attachments storage folder
# ATTACHMENTS_FOLDER=data/attachments

# Sends storage folder
# SENDS_FOLDER=data/sends

# Temporary files folder
# TMP_FOLDER=data/tmp

# =============================================================================
# General Settings
# =============================================================================

# Domain URL (required for proper link generation)
DOMAIN=https://CHANGE_ME

# Allow new user signups
# SIGNUPS_ALLOWED=true

# Require email verification for signups
# SIGNUPS_VERIFY=false

# Restrict signups to specific email domains (comma-separated)
# SIGNUPS_DOMAINS_WHITELIST=

# Allow existing users to invite new users
# INVITATIONS_ALLOWED=true

# Organization name used in invitation emails
# INVITATION_ORG_NAME=Vaultwarden

# Show password hints on the login page
# SHOW_PASSWORD_HINT=false

# Allow password hints
# PASSWORD_HINTS_ALLOWED=true

# Default KDF iterations for new users
# PASSWORD_ITERATIONS=600000

# Restrict org creation to specific users (comma-separated emails, empty = all)
# ORG_CREATION_USERS=

# Enable group support for organizations
# ORG_GROUPS_ENABLED=false

# Enable event logging for organizations
# ORG_EVENTS_ENABLED=false

# Allow emergency access feature
# EMERGENCY_ACCESS_ALLOWED=true

# Allow Bitwarden Send feature
# SENDS_ALLOWED=true

# =============================================================================
# Admin Panel
# =============================================================================

# Admin panel authentication token (use argon2 hash in production)
# Generate with: vaultwarden hash --preset owasp
# ADMIN_TOKEN=CHANGE_ME

# Disable admin token (NOT recommended)
# DISABLE_ADMIN_TOKEN=false

# Admin session lifetime in minutes
# ADMIN_SESSION_LIFETIME=20

# Rate limiting: seconds between admin login attempts
# ADMIN_RATELIMIT_SECONDS=60

# Rate limiting: max burst attempts
# ADMIN_RATELIMIT_MAX_BURST=3

# =============================================================================
# SMTP / Email
# =============================================================================

# SMTP server hostname
# SMTP_HOST=

# SMTP server port
# SMTP_PORT=587

# Sender email address
# SMTP_FROM=

# Sender display name
# SMTP_FROM_NAME=Vaultwarden

# SMTP security: starttls, force_tls, off
# SMTP_SECURITY=starttls

# SMTP authentication username
# SMTP_USERNAME=

# SMTP authentication password
# SMTP_PASSWORD=

# SMTP auth mechanism: Plain, Login, Xoauth2
# SMTP_AUTH_MECHANISM=Plain

# SMTP connection timeout in seconds
# SMTP_TIMEOUT=15

# Accept invalid TLS certificates (not recommended)
# SMTP_ACCEPT_INVALID_CERTS=false

# Accept invalid hostnames in TLS certificates
# SMTP_ACCEPT_INVALID_HOSTNAMES=false

# Enable SMTP debug logging
# SMTP_DEBUG=false

# Embed images in emails instead of linking
# SMTP_EMBED_IMAGES=true

# Use sendmail instead of SMTP
# USE_SENDMAIL=false

# Sendmail command path
# SENDMAIL_COMMAND=sendmail

# HELO name for SMTP
# HELO_NAME=

# =============================================================================
# SSO / OpenID Connect
# =============================================================================

# Enable SSO authentication
# SSO_ENABLED=false

# Only allow SSO login (disable password login)
# SSO_ONLY=false

# OIDC issuer/authority URL
# SSO_AUTHORITY=

# OIDC client ID
# SSO_CLIENT_ID=

# OIDC client secret
# SSO_CLIENT_SECRET=

# OIDC scopes (space-separated)
# SSO_SCOPES=openid email profile

# Enable PKCE for OIDC
# SSO_PKCE=false

# Trusted OIDC audience
# SSO_AUDIENCE_TRUSTED=

# =============================================================================
# Rocket Web Server
# =============================================================================

# Listening address
# ROCKET_ADDRESS=0.0.0.0

# Listening port
# ROCKET_PORT=80

# TLS configuration (JSON: {certs:"path",key:"path"})
# ROCKET_TLS=

# Number of worker threads
# ROCKET_WORKERS=10

# Request size limits (JSON)
# ROCKET_LIMITS={json=10485760}

# =============================================================================
# WebSocket (for live sync)
# =============================================================================

# Enable WebSocket notifications
# WEBSOCKET_ENABLED=false

# WebSocket listening address
# WEBSOCKET_ADDRESS=0.0.0.0

# WebSocket port
# WEBSOCKET_PORT=3012

# =============================================================================
# Push Notifications (Bitwarden relay)
# =============================================================================

# Enable push notifications
# PUSH_ENABLED=false

# Push relay URI
# PUSH_RELAY_URI=https://push.bitwarden.com

# Push identity URI
# PUSH_IDENTITY_URI=https://identity.bitwarden.com

# Installation ID (from https://bitwarden.com/host/)
# PUSH_INSTALLATION_ID=

# Installation key
# PUSH_INSTALLATION_KEY=

# =============================================================================
# Icons
# =============================================================================

# Icon download service: internal, bitwarden, duckduckgo, google
# ICON_SERVICE=internal

# Disable icon downloading
# DISABLE_ICON_DOWNLOAD=false

# Icon redirect on error: true returns redirect, false returns 404
# ICON_REDIRECT_CODE=302

# Icon blacklist regex
# ICON_BLACKLIST_REGEX=

# Icon download timeout in seconds
# ICON_DOWNLOAD_TIMEOUT=10

# Icon cache TTL in seconds (0 = indefinite)
# ICON_CACHE_TTL=2592000

# Negative icon cache TTL in seconds
# ICON_CACHE_NEGTTL=259200

# =============================================================================
# Logging
# =============================================================================

# Log level: trace, debug, info, warn, error, off
# LOG_LEVEL=info

# Enable extended logging
# EXTENDED_LOGGING=true

# Log timestamps
# LOG_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S.%3f

# Log to file path (in addition to stdout)
# LOG_FILE=

# Enable syslog logging
# USE_SYSLOG=false

# =============================================================================
# Rate Limiting
# =============================================================================

# Login rate limit seconds
# LOGIN_RATELIMIT_SECONDS=60

# Login rate limit max burst
# LOGIN_RATELIMIT_MAX_BURST=10

# =============================================================================
# Two-Factor Authentication
# =============================================================================

# Enable authenticator 2FA (TOTP)
# AUTHENTICATOR_DISABLE_TIME_DRIFT=false

# Enable email 2FA
# EMAIL_TOKEN_SIZE=6

# Email token expiration in seconds
# EMAIL_EXPIRATION_TIME=600

# Max email token attempts
# EMAIL_ATTEMPTS_LIMIT=3

# Enable Duo 2FA
# DUO_ENABLED=false

# Enable YubiKey 2FA
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
# YUBICO_SERVER=

# =============================================================================
# Miscellaneous
# =============================================================================

# IP header for reverse proxy (e.g., X-Real-IP, X-Forwarded-For)
# IP_HEADER=X-Real-IP

# Reload templates on each request (dev only)
# RELOAD_TEMPLATES=false

# Disable 2FA remember
# DISABLE_2FA_REMEMBER=false

# Require device email for new logins
# REQUIRE_DEVICE_EMAIL=false

# Trash auto-delete days (0 = disabled)
# TRASH_AUTO_DELETE_DAYS=0

# Incomplete 2FA time limit in minutes
# INCOMPLETE_2FA_TIME_LIMIT=3

# Org attachment limit in KB (0 = unlimited)
# ORG_ATTACHMENT_LIMIT=0

# User attachment limit in KB (0 = unlimited)
# USER_ATTACHMENT_LIMIT=0

# User send limit in KB (0 = unlimited)
# USER_SEND_LIMIT=0
