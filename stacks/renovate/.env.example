# GitHub PAT (fine-grained) with repo contents:rw, pull-requests:rw, workflows:rw
RENOVATE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repository to manage (JSON array)
RENOVATE_REPOSITORIES=["st0o0/homelab-infra"]

# Git author for Renovate commits
RENOVATE_GIT_AUTHOR=Renovate Bot <bot@renovateapp.com>

# Log level: debug, info, warn, error
RENOVATE_LOG_LEVEL=info
