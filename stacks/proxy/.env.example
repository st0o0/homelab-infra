# ============================================================
# Required — stack will not start without these
# ============================================================

# --- Bifrost (WireGuard tunnel) ---
BIFROST_PRIVATE_KEY=changeme
BIFROST_ADDRESS=changeme
BIFROST_PEER_PUBLIC_KEY=changeme
BIFROST_PEER_ENDPOINT=changeme
BIFROST_PEER_ALLOWED_IPS=changeme

# --- CrowdSec ---
CROWDSEC_BOUNCER_API_KEY=changeme
CROWDSEC_ENROLL_KEY=changeme

# --- ran (honeypot) ---
RAN_CROWDSEC_MACHINE_ID=changeme
RAN_CROWDSEC_PASSWORD=changeme

# --- Alloy (observability) ---
ALLOY_REMOTE_WRITE_URL=changeme
ALLOY_LOGS_PUSH_URL=changeme

# --- GeoIP (MaxMind) ---
GEOIPUPDATE_ACCOUNT_ID=changeme
GEOIPUPDATE_LICENSE_KEY=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================

# --- Alloy ---
# ALLOY_HOSTNAME=myhost

# --- Bifrost tuning ---
# BIFROST_PEER_PRESHARED_KEY=
# BIFROST_LISTEN_PORT=51821
# BIFROST_MTU=1420
# BIFROST_INTERFACE=wg1
# BIFROST_PEER_KEEPALIVE=25
# BIFROST_CHECK_INTERVAL=30
# BIFROST_STALE_AFTER=135
# BIFROST_RESOLVE=on
# BIFROST_RECONNECT=on
# BIFROST_HEALTHCHECK=on
# BIFROST_PROBE=off
# BIFROST_METRICS=on
# BIFROST_METRICS_ADDR=:9586

# --- GeoIP tuning ---
# GEOIPUPDATE_FREQUENCY=24

# --- Eir ---
# EIR_STABILIZE_WAIT=15s
# EIR_MAX_RETRIES=3
# EIR_RETRY_BACKOFF=5s
# EIR_LOG_LEVEL=info
# EIR_LOG_FORMAT=text

# --- Caddy reverse proxy (one domain+target pair per sites/*.caddy file) ---
# CADDY_DOMAIN_JELLYFIN=jellyfin.example.com
# CADDY_TARGET_JELLYFIN=10.x.x.x:8096

# --- ran (honeypot) tuning ---
# RAN_LOG_LEVEL=info
# RAN_SESSION_TIMEOUT=30s
# RAN_MAX_SESSIONS=500
# RAN_MAX_PER_IP=10
# RAN_CROWDSEC_BAN_DURATION=4h

# --- System ---
# PGID=1000
