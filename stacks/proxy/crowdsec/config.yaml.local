api:
  server:
    listen_uri: 0.0.0.0:8180

db_config:
  flush:
    # GetDecisionsCount (ban escalation) counts only decisions of alerts still in the database, so history must
    # cover the longest escalation step (168h); the ran honeypot alone creates about 4000 alerts per day
    max_items: 30000
    max_age: 14d

prometheus:
  enabled: true
  level: full
  listen_addr: 0.0.0.0
  listen_port: 6060

plugin_config:
  user: root
  group: root
