// ── Outputs ─────────────────────────────────────────────────

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("REMOTE_WRITE_URL")
  }
  external_labels = {
    host = sys.env("HOST_HOSTNAME"),
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("LOGS_PUSH_URL")
  }
  external_labels = {
    host = sys.env("HOST_HOSTNAME"),
  }
}

// ── Host Metrics ────────────────────────────────────────────

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"

  filesystem {
    mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker/.+)($|/)"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    replacement  = "node"
    target_label = "job"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.relabel.host.receiver]
  scrape_interval = "30s"
}

// ── Container Metrics (cAdvisor) ────────────────────────────

prometheus.exporter.cadvisor "containers" {
  docker_host            = "unix:///var/run/docker.sock"
  docker_only            = true
  store_container_labels = true
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
}

// ── Proxy Metrics ───────────────────────────────────────────

prometheus.scrape "caddy" {
  targets         = [{ __address__ = "localhost:2019" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
  job_name        = "caddy"
  metrics_path    = "/metrics"
}

prometheus.scrape "crowdsec" {
  targets         = [{ __address__ = "localhost:6060" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
  job_name        = "crowdsec"
  metrics_path    = "/metrics"
}

prometheus.scrape "fail2ban" {
  targets         = [{ __address__ = "localhost:9191" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "30s"
  job_name        = "fail2ban"
  metrics_path    = "/metrics"
}

// ── Self Monitoring ─────────────────────────────────────────

prometheus.scrape "alloy" {
  targets         = [{ __address__ = "localhost:12345" }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "60s"
}

// ── Docker Container Logs ───────────────────────────────────

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  labels        = { job = "docker" }
  forward_to    = [loki.write.central.receiver]
}

// ── System Logs ─────────────────────────────────────────────

local.file_match "system" {
  path_targets = [
    {__path__ = "/var/log/host/syslog", job = "syslog"},
    {__path__ = "/var/log/host/auth.log", job = "auth"},
    {__path__ = "/var/log/host/kern.log", job = "kernel"},
  ]
}

loki.source.file "system" {
  targets    = local.file_match.system.targets
  forward_to = [loki.process.system.receiver]
}

loki.process "system" {
  stage.regex {
    expression = "^(?P<timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})"
  }

  stage.timestamp {
    source = "timestamp"
    format = "Jan  2 15:04:05"
  }

  forward_to = [loki.write.central.receiver]
}

// ── Security Logs ───────────────────────────────────────────

local.file_match "security" {
  path_targets = [
    {__path__ = "/var/log/host/fail2ban.log",       job = "fail2ban"},
    {__path__ = "/var/log/host/clamav/scan.log",    job = "clamav"},
    {__path__ = "/var/log/host/lynis.log",          job = "lynis"},
    {__path__ = "/var/log/host/ufw.log",            job = "ufw"},
  ]
}

loki.source.file "security" {
  targets    = local.file_match.security.targets
  forward_to = [loki.write.central.receiver]
}

// ── Caddy Access Logs ───────────────────────────────────────

local.file_match "caddy_access" {
  path_targets = [
    {__path__ = "/var/log/host/caddy/access.log", job = "caddy-access"},
  ]
}

loki.source.file "caddy_access" {
  targets    = local.file_match.caddy_access.targets
  forward_to = [loki.process.caddy_access.receiver]
}

loki.process "caddy_access" {
  stage.json {
    expressions = {
      ts = "ts",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  forward_to = [loki.write.central.receiver]
}
