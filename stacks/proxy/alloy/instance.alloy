import.file "modules" {
  filename = "/etc/alloy/modules"
}

modules.syslog "default" {
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.ssh "default" {
  enabled    = "true"
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.sudo "default" {
  enabled    = "true"
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.fail2ban "default" {
  enabled    = "true"
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.ufw "default" {
  enabled    = "true"
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.security "default" {
  enabled    = "true"
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.caddy "default" {
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.honeypot "default" {
  forward_to = [loki.secretfilter.redact.receiver]
}


modules.crowdsec "default" {
  forward_to = [loki.secretfilter.redact.receiver]
}

modules.appsec "default" {
  forward_to = [loki.secretfilter.redact.receiver]
}
