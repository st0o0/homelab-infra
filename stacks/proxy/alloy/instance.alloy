import.file "modules" {
  filename = "/etc/alloy/modules"
}

modules.syslog "default" {
  forward_to = [loki.write.central.receiver]
}

modules.ssh "default" {
  enabled    = "true"
  forward_to = [loki.process.geoip.receiver]
}

modules.sudo "default" {
  enabled    = "true"
  forward_to = [loki.write.central.receiver]
}

modules.fail2ban "default" {
  enabled    = "true"
  forward_to = [loki.process.geoip.receiver]
}

modules.ufw "default" {
  enabled    = "true"
  forward_to = [loki.process.geoip.receiver]
}

modules.security "default" {
  enabled    = "true"
  forward_to = [loki.write.central.receiver]
}

modules.caddy "default" {
  forward_to = [loki.write.central.receiver]
}

modules.waf "default" {
  forward_to = [loki.write.central.receiver]
}

modules.crowdsec "default" {
  forward_to = [loki.write.central.receiver]
}
