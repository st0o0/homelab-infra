{
	order coraza_waf first
	order crowdsec after coraza_waf
	order rate_limit after crowdsec

	crowdsec {
		api_url http://localhost:8080
		api_key {$CROWDSEC_BOUNCER_API_KEY}
	}

	metrics {
		per_host
	}

	log {
		level INFO
	}

	layer4 {
		:23 {
			route {
				proxy localhost:10023
			}
		}
		:445 {
			route {
				proxy localhost:10445
			}
		}
		:1883 {
			route {
				proxy localhost:11883
			}
		}
		:2222 {
			route {
				proxy localhost:12222
			}
		}
		:3307 {
			route {
				proxy localhost:13307
			}
		}
		:3389 {
			route {
				proxy localhost:13389
			}
		}
		:5900 {
			route {
				proxy localhost:15900
			}
		}
		:6379 {
			route {
				proxy localhost:16379
			}
		}
	}

	servers :2019 {
		name metrics
	}
	servers :8888 {
		name health
	}
	servers :443 {
		name proxy
	}
}

:2019 {
	metrics /metrics
}

(crowdsec) {
	crowdsec
}

(access-geo-dach) {
	@geo-blocked not maxmind_geolocation {
		db_path /geoip/GeoLite2-City.mmdb
		allow_countries DE AT CH
	}
	abort @geo-blocked
}

(authentik) {
	forward_auth {$CADDY_TARGET_AUTHENTIK} {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
		trusted_proxies private_ranges
	}
}

(ratelimit-strict) {
	rate_limit {
		zone strict_{args[0]} {
			key {remote_host}
			events 30
			window 1m
		}
	}
}

(ratelimit-default) {
	rate_limit {
		zone default_{args[0]} {
			key {remote_host}
			events 100
			window 1m
		}
	}
}

(ratelimit-media) {
	rate_limit {
		zone media_{args[0]} {
			key {remote_host}
			events 300
			window 1m
		}
	}
}

(waf) {
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine On
			SecAuditEngine RelevantOnly
			SecAuditLog /var/log/caddy/waf-audit.log
			SecAuditLogFormat json
		`
	}
}

(waf-exclusions-authentik) {
	coraza_waf {
		directives `
			SecRule REQUEST_URI "^/(if|api|ws|outpost\.goauthentik\.io|static)/" "id:10000,phase:1,nolog,pass,ctl:ruleRemoveById=920170,ctl:ruleRemoveById=920230,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=941100-941999,ctl:ruleRemoveById=942100-942999,ctl:ruleRemoveById=949110"
		`
	}
}

(waf-exclusions-paperless) {
	coraza_waf {
		directives `
			SecRule REQUEST_URI "^/api/" "id:10100,phase:1,nolog,pass,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=921110-921160,ctl:ruleRemoveById=941100-941999,ctl:ruleRemoveById=942100-942999,ctl:ruleRemoveById=949110"
		`
	}
}

(waf-exclusions-jellyfin) {
	coraza_waf {
		directives `
			SecRule REQUEST_URI "^/(web|Items|Videos|Audio|Sessions|System|socket)/" "id:10200,phase:1,nolog,pass,ctl:ruleRemoveById=920230,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=941100-941999,ctl:ruleRemoveById=949110"
		`
	}
}

(waf-exclusions-arr) {
	coraza_waf {
		directives `
			SecRule REQUEST_URI "^/api/" "id:10300,phase:1,nolog,pass,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=941100-941999,ctl:ruleRemoveById=942100-942999,ctl:ruleRemoveById=949110"
		`
	}
}

(defaults) {
	import waf
	import crowdsec
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json {
			time_format iso8601
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

import /etc/caddy/sites/*.caddy
