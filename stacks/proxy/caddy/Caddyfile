{
	order crowdsec first
	order appsec after crowdsec
	order rate_limit after appsec

	crowdsec {
		api_url http://localhost:8180
		api_key {$CROWDSEC_BOUNCER_API_KEY}
		appsec_url http://localhost:7422
	}

	metrics {
		per_host
	}

	log {
		level INFO
	}

	servers :2019 {
		name metrics
	}
	servers :8888 {
		name health
	}
	servers :443 {
		name proxy
	}
	servers :80 {
		name honeypot
	}
}

:2019 {
	metrics /metrics
}

(crowdsec) {
	crowdsec
}

(access-geo-dach) {
	@geo-blocked not maxmind_geolocation {
		db_path /geoip/GeoLite2-City.mmdb
		allow_countries DE AT CH
	}
	abort @geo-blocked
}

(authentik) {
	reverse_proxy /outpost.goauthentik.io/* {$CADDY_TARGET_AUTHENTIK}
	forward_auth {$CADDY_TARGET_AUTHENTIK} {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
		trusted_proxies private_ranges
	}
}

(ratelimit-strict) {
	rate_limit {
		zone strict_{args[0]} {
			key {remote_host}
			events 30
			window 1m
		}
	}
}

(ratelimit-default) {
	rate_limit {
		zone default_{args[0]} {
			key {remote_host}
			events 100
			window 1m
		}
	}
}

(ratelimit-media) {
	rate_limit {
		zone media_{args[0]} {
			key {remote_host}
			events 300
			window 1m
		}
	}
}

(appsec) {
	appsec
}

(block-bots) {
	@bot header_regexp User-Agent "(?i)(GPTBot|ChatGPT-User|ChatGPT|ClaudeBot|anthropic-ai|Bytespider|PerplexityBot|Cohere-ai|cohere-crawler|Google-Extended|Applebot-Extended|Meta-ExternalAgent|FacebookBot|Amazonbot|AI2Bot|Ai2Bot-Dolma|Googlebot|Bingbot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Qwantify|SeznamBot|ia_archiver|AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot)"
	abort @bot
}

(defaults) {
	import crowdsec
	import appsec
	import block-bots
	handle /robots.txt {
		header Content-Type "text/plain"
		respond "User-agent: *
Disallow: /" 200
	}
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			wrap json {
				time_format iso8601
			}
			fields {
				request>uri query {
					replace access_token REDACTED
					replace api_key REDACTED
					replace ApiKey REDACTED
					replace token REDACTED
					replace DeviceId REDACTED
					replace deviceId REDACTED
					replace PlaySessionId REDACTED
					replace SessionId REDACTED
					replace client_id REDACTED
					replace state REDACTED
				}
			}
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

import /etc/caddy/sites/*.caddy
