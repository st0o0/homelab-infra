{$CADDY_DOMAIN_AUTHENTIK} {
	import defaults
	import log-service authentik
	import access-geo
	@staticAssets path /static/dist/*.js /static/dist/chunks/*.js
	header @staticAssets Content-Type "application/javascript"
	@flow path /api/v3/flows/executor/* /if/flow/*
	route @flow {
		import ratelimit-strict authentik_flow
		import proxy {$CADDY_TARGET_AUTHENTIK}
	}
	route {
		import ratelimit-media authentik
		import proxy {$CADDY_TARGET_AUTHENTIK}
	}
}
