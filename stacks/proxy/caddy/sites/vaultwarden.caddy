{$CADDY_DOMAIN_VAULTWARDEN} {
	import defaults
	import access-geo-dach

	header {
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
	}

	@api path /api/* /identity/* /icons/* /notifications/hub /alive
	route @api {
		import ratelimit-default vaultwarden_api
		reverse_proxy {$CADDY_TARGET_VAULTWARDEN} {
			header_up X-Real-IP {remote_host}
		}
	}

	route {
		import ratelimit-strict vaultwarden
		import authentik

		reverse_proxy {$CADDY_TARGET_VAULTWARDEN} {
			header_up X-Real-IP {remote_host}
		}
	}
}
