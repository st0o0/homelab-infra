{$CADDY_DOMAIN_VAULTWARDEN} {
	import defaults
	import log-service vaultwarden
	import access-geo
	@admin path /admin*
	respond @admin 404
	@identity path /identity/*
	route @identity {
		import ratelimit-strict vaultwarden_identity
		import proxy {$CADDY_TARGET_VAULTWARDEN}
	}
	@websocket path /notifications/hub
	route @websocket {
		import ratelimit-media vaultwarden_ws
		import proxy {$CADDY_TARGET_VAULTWARDEN}
	}
	@api path /api/* /icons/* /alive
	route @api {
		import ratelimit-default vaultwarden_api
		request_body {
			max_size 600MB
		}
		import proxy {$CADDY_TARGET_VAULTWARDEN}
	}
	route {
		import ratelimit-strict vaultwarden
		import authentik
		import proxy {$CADDY_TARGET_VAULTWARDEN}
	}
}
