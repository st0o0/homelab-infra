{$CADDY_DOMAIN_VAULTWARDEN} {
	import defaults
	import ratelimit-strict vaultwarden
	import access-geo-dach

	header {
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow"
	}

	@api path /api/* /identity/* /icons/* /notifications/hub /alive
	reverse_proxy @api {$CADDY_TARGET_VAULTWARDEN} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	route {
		import authentik

		reverse_proxy {$CADDY_TARGET_VAULTWARDEN} {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}
}
