# ============================================================
# Required — stack will not start without these
# ============================================================
PAPERLESS_SECRET_KEY=changeme
PAPERLESS_DB_HOST=changeme
PAPERLESS_DB_NAME=changeme
PAPERLESS_DB_USER=changeme
PAPERLESS_DB_PASS=changeme
PAPERLESS_REDIS_HOST=changeme
PAPERLESS_REDIS_PASSWORD=changeme
PAPERLESS_PATH_DATA=changeme
PAPERLESS_PATH_MEDIA=changeme

# ============================================================
# Optional — uncomment to override container defaults
# ============================================================
# PAPERLESS_PORT=8000
# PAPERLESS_URL=
# PAPERLESS_ADMIN_USER=
# PAPERLESS_ADMIN_PASS=
# PAPERLESS_DB_PORT=5432
# PAPERLESS_REDIS_PORT=6379
# PAPERLESS_REDIS_DBINDEX=0
# PAPERLESS_REDIS_PREFIX=PAPERLESS
# PAPERLESS_OCR_LANGUAGE=deu+eng
# PAPERLESS_TIKA_ENABLED=true
# PAPERLESS_TASK_WORKERS=2
# PAPERLESS_THREADS_PER_WORKER=2
# PAPERLESS_WEBSERVER_WORKERS=2
# PAPERLESS_PATH_CONSUME=/docker/paperless/consume
# PAPERLESS_PATH_EXPORT=/docker/paperless/export
# TZ=Europe/Berlin
# PUID=1000
# PGID=1000
