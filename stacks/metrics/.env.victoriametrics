###############################################################################
# VictoriaMetrics Environment Variables
# https://docs.victoriametrics.com/single-server-victoriametrics/
#
# VictoriaMetrics uses CLI flags natively. With -envflag.enable, flags
# become environment variables by uppercasing and replacing dots/dashes:
#   -storageDataPath  ->  storageDataPath (or VICTORIA_METRICS_storageDataPath)
#
# Set -envflag.prefix to add a custom prefix (e.g., VM_).
# Listed below as env var names (no prefix, use -envflag.enable).
###############################################################################

# =============================================================================
# Environment Flag Support
# =============================================================================

# Enable reading flags from environment variables
# Pass as CLI flag: -envflag.enable
# envflag.enable=true

# Prefix for environment variables (e.g., VM_)
# envflag.prefix=

# =============================================================================
# Storage
# =============================================================================

# Path to data storage directory
# storageDataPath=/victoria-metrics-data

# Data retention period (months by default, supports h/d/w/y suffixes)
# retentionPeriod=1

# Max disk space usage (supports KB, MB, GB, TB suffixes; 0 = unlimited)
# retentionMaxDiskSpaceUsage=0

# =============================================================================
# Network
# =============================================================================

# HTTP listen address
# httpListenAddr=:8428

# Enable TLS for incoming requests
# tls=false

# TLS certificate file path
# tlsCertFile=

# TLS key file path
# tlsKeyFile=

# =============================================================================
# Data Ingestion
# =============================================================================

# Min scrape interval for deduplication (0s = disabled)
# dedup.minScrapeInterval=0s

# Max labels per time series
# maxLabelsPerTimeseries=30

# Max label name length
# maxLabelNameLen=256

# Max label value length
# maxLabelValueLen=16384

# =============================================================================
# Self-Monitoring
# =============================================================================

# Self-scrape interval (0s = disabled)
# selfScrapeInterval=0s

# Self-scrape job name
# selfScrapeJob=victoria-metrics

# Self-scrape instance name
# selfScrapeInstance=

# =============================================================================
# Search / Query
# =============================================================================

# Max number of unique time series per search query
# search.maxUniqueTimeseries=300000

# Max number of raw samples per search query
# search.maxSamplesPerQuery=1000000000

# Max duration for query execution
# search.maxQueryDuration=30s

# Max number of points per timeseries returned by /api/v1/query_range
# search.maxPointsPerTimeseries=30000

# Max lookback delta for instant queries
# search.maxLookback=0s

# =============================================================================
# Memory / Cache
# =============================================================================

# Max memory percentage for merge operations
# memory.allowedPercent=60

# Max bytes for in-memory cache (0 = auto based on available memory)
# search.cacheTimestampOffset=5m

# =============================================================================
# vmagent-Compatible Flags
# =============================================================================

# Scrape config file path (Prometheus format)
# promscrape.config=

# Scrape config check interval
# promscrape.configCheckInterval=0s

# Max scrape body size
# promscrape.maxScrapeSize=16777216

# =============================================================================
# Logging
# =============================================================================

# Log level: INFO, WARN, ERROR, FATAL, PANIC
# loggerLevel=INFO

# Log format: default, json
# loggerFormat=default

# Disable timestamps in log output
# loggerDisableTimestamps=false
