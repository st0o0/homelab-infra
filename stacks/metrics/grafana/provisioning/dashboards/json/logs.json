{
  "uid": "logs-explorer",
  "title": "Logs Explorer",
  "tags": ["homelab", "logs"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "uid": "victorialogs", "type": "victoriametrics-logs-datasource" },
        "query": "host",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "multi": false
      },
      {
        "name": "job",
        "type": "custom",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "options": [
          { "text": "docker", "value": "docker", "selected": false },
          { "text": "syslog", "value": "syslog", "selected": false },
          { "text": "auth", "value": "auth", "selected": false },
          { "text": "kernel", "value": "kernel", "selected": false }
        ],
        "query": "docker,syslog,auth,kernel",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "uid": "victorialogs", "type": "victoriametrics-logs-datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "host:~\"$host\" AND job:~\"$job\" | stats by (host) count() as logs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 6 },
      "datasource": { "uid": "victorialogs", "type": "victoriametrics-logs-datasource" },
      "targets": [
        {
          "expr": "host:~\"$host\" AND job:~\"$job\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39
}
