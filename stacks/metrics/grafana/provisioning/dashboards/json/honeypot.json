{
  "uid": "honeypot",
  "title": "Honeypot",
  "tags": [
    "honeypot",
    "ran",
    "security"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "🏥 Health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Version",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^version$/", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ran_build_info{job=\"ran\"}"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Sessions/h",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
