{
  "uid": "authentik",
  "title": "Authentik",
  "description": "Authentik identity provider metrics and performance.",
  "tags": [
    "authentik"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {},
  "schemaVersion": 38,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "🔐 Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Version",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (version) (authentik_tasks_workers{job=\"authentik\"})",
          "instant": true,
          "legendFormat": "{{ version }}"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Workers",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [{ "options": { "0": { "text": "None" } }, "type": "value" }]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(authentik_admin_workers{job=\"authentik\"})",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Outposts",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [{ "options": { "0": { "text": "None" } }, "type": "value" }]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(authentik_outposts_connected{job=\"authentik\"})",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Policies cached",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(authentik_policies_cached{job=\"authentik\"})",
          "instant": true
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Flows cached",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(authentik_flows_cached{job=\"authentik\"})",
          "instant": true
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Tasks queued",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(authentik_tasks_queued{job=\"authentik\"})"
        }
      ],
      "id": 7
    },

    {
      "type": "row",
      "title": "🔑 Authentication Activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 50
    },
    {
      "type": "stat",
      "title": "Logins",
      "gridPos": { "h": 3, "w": 6, "x": 0, "y": 6 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"login\" | stats count() as logins",
          "queryType": "stats"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "logins" }] } }
      ],
      "id": 51
    },
    {
      "type": "stat",
      "title": "Failed Logins",
      "gridPos": { "h": 3, "w": 6, "x": 6, "y": 6 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"login_failed\" | stats count() as failed",
          "queryType": "stats"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "failed" }] } }
      ],
      "id": 52
    },
    {
      "type": "stat",
      "title": "App Authorizations",
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 6 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"authorize_application\" | stats count() as authorizations",
          "queryType": "stats"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "authorizations" }] } }
      ],
      "id": 53
    },
    {
      "type": "stat",
      "title": "Logouts",
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 6 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"logout\" | stats count() as logouts",
          "queryType": "stats"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "logouts" }] } }
      ],
      "id": 54
    },
    {
      "type": "bargauge",
      "title": "Authorizations per App",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^authorizations$/", "values": true },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"authorize_application\" | stats by (msg.context.authorized_application.name) count() as authorizations | sort by (authorizations) desc",
          "queryType": "instant"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": { "includeByName": { "msg.context.authorized_application.name": true, "authorizations": true }, "renameByName": { "msg.context.authorized_application.name": "App" } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "authorizations" }] } }
      ],
      "id": 55
    },
    {
      "type": "timeseries",
      "title": "Auth Events Timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "login" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "authorize_application" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "login_failed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "logout" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:in(login, login_failed, authorize_application, logout) | stats by (_time:5m, msg.action) count() as events",
          "queryType": "statsRange"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "events" }] } },
        { "id": "renameByRegex", "options": { "regex": "events\\{msg.action=\"(.*)\"\\}", "renamePattern": "$1" } }
      ],
      "id": 56
    },
    {
      "type": "timeseries",
      "title": "Failed Login Trend",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"login_failed\" | stats by (_time:1h) count() as failed",
          "queryType": "statsRange"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "format": "json", "source": "labels" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "detected_level": true, "id": true, "labels": true, "streamId": true, "streams": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "failed" }] } }
      ],
      "id": 57
    },
    {
      "type": "bargauge",
      "title": "Geo Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^logins$/", "values": true },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:=\"authorize_application\" | stats by (msg.context.geo.country, msg.context.geo.city) count() as logins | sort by (logins) desc | limit 10",
          "queryType": "instant"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": { "includeByName": { "msg.context.geo.country": true, "msg.context.geo.city": true, "logins": true }, "renameByName": { "msg.context.geo.country": "Country", "msg.context.geo.city": "City" } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "logins" }] } }
      ],
      "id": 58
    },
    {
      "type": "logs",
      "title": "Recent Auth Events",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"authentik-server\"} msg.action:in(login, login_failed, authorize_application, logout)"
        }
      ],
      "id": 59
    },

    {
      "type": "row",
      "title": "📊 HTTP Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dest) (rate(authentik_main_request_duration_seconds_count{job=\"authentik\"}[5m]))",
          "legendFormat": "{{ dest }}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(authentik_main_request_duration_seconds_bucket{job=\"authentik\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(authentik_main_request_duration_seconds_bucket{job=\"authentik\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(authentik_main_request_duration_seconds_bucket{job=\"authentik\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "🌐 Proxy Outpost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "id": 20
    },
    {
      "type": "timeseries",
      "title": "Proxy requests by host",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "reqps"
