{
  "uid": "containerlogs",
  "title": "Container Logs",
  "description": "Docker container log analysis via VictoriaLogs.",
  "tags": [
    "docker",
    "logs",
    "victorialogs"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 42,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "📊 Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Total Logs",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "id": true, "labels": true, "streams": true, "streamId": true, "detected_level": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "logs", "destinationType": "number" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} | count()",
          "queryType": "stats"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Errors",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "id": true, "labels": true, "streams": true, "streamId": true, "detected_level": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "errors", "destinationType": "number" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} level:error | stats count() as errors",
          "queryType": "stats"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Warnings",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "id": true, "labels": true, "streams": true, "streamId": true, "detected_level": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "warnings", "destinationType": "number" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} level:warn | stats count() as warnings",
          "queryType": "stats"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Info",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "id": true, "labels": true, "streams": true, "streamId": true, "detected_level": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "info", "destinationType": "number" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} level:info | stats count() as info",
          "queryType": "stats"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Log Volume by Level",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" },
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json" } },
        { "id": "organize", "options": { "excludeByName": { "Line": true, "id": true, "labels": true, "streams": true, "streamId": true, "detected_level": true } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "logs", "destinationType": "number" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} | stats by (_time:5m, level) count() as logs",
          "queryType": "statsRange"
        }
      ],
      "id": 6
    },
    {
      "type": "row",
      "title": "📦 Container Breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 100
    },
    {
      "type": "bargauge",
      "title": "Top Containers by Volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "links": [
            {
              "title": "Explore logs for ${__field.labels.container}",
              "url": "/explore?schemaVersion=1&panes={\"one\":{\"datasource\":\"victorialogs\",\"queries\":[{\"expr\":\"{job=\\\"docker\\\", container=\\\"${__field.labels.container}\\\"}\",\"refId\":\"A\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}",
              "targetBlank": true
            }
          ]
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^hits$/", "values": true },
        "showUnfilled": true,
        "text": {}
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": { "includeByName": { "container": true, "hits": true }, "indexByName": { "container": 0, "hits": 1 } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "hits" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} | top 10 by (container)",
          "queryType": "instant"
        }
      ],
      "id": 101
    },
    {
      "type": "bargauge",
      "title": "Top Containers by Errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "links": [
            {
              "title": "Explore errors for ${__field.labels.container}",
              "url": "/explore?schemaVersion=1&panes={\"one\":{\"datasource\":\"victorialogs\",\"queries\":[{\"expr\":\"{job=\\\"docker\\\", container=\\\"${__field.labels.container}\\\"} level:error\",\"refId\":\"A\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}",
              "targetBlank": true
            }
          ]
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^hits$/", "values": true },
        "showUnfilled": true,
        "text": {}
      },
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        { "id": "organize", "options": { "includeByName": { "container": true, "hits": true }, "indexByName": { "container": 0, "hits": 1 } } },
        { "id": "convertFieldType", "options": { "conversions": [{ "destinationType": "number", "targetField": "hits" }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"} level:error | top 10 by (container)",
          "queryType": "instant"
        }
      ],
      "id": 102
    },
    {
      "type": "row",
      "title": "🔍 Log Explorer",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 200
    },
    {
      "type": "logs",
      "title": "Logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\"}"
        }
      ],
      "id": 201
    }
  ]
}
