    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "datasource": {
                    "type": "victoriametrics-logs-datasource",
                    "uid": "victorialogs"
                  },
                  "hidden": false,
                  "query": {
                    "kind": "victoriametrics-logs-datasource",
                    "spec": {
                      "expr": "{job=\"docker\", host=~\"$host\", container=~\"$container\"} | count()",
                      "queryType": "stats"
                    }
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 1,
        "links": [],
        "title": "Total Logs",
        "vizConfig": {
          "kind": "stat",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    }
                  ]
                },
                "unit": "short"
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ],
                "fields": "",
                "values": false
              },
              "textMode": "auto"
            },
            "pluginVersion": ""
          }
        }
      }
    },
    "panel-10": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "datasource": {
                    "type": "victoriametrics-logs-datasource",
                    "uid": "victorialogs"
                  },
                  "hidden": false,
                  "query": {
                    "kind": "victoriametrics-logs-datasource",
                    "spec": {
                      "expr": "{job=\"docker\", host=~\"$host\", container=~\"$container\"} error | stats by (_time:5m) count() as errors",
                      "queryType": "statsRange"
                    }
                  },
                  "refId": "A"
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "datasource": {
                    "type": "victoriametrics-logs-datasource",
                    "uid": "victorialogs"
                  },
                  "hidden": false,
                  "query": {
                    "kind": "victoriametrics-logs-datasource",
                    "spec": {
                      "expr": "{job=\"docker\", host=~\"$host\", container=~\"$container\"} warn | stats by (_time:5m) count() as warnings",
                      "queryType": "statsRange"
                    }
                  },
                  "refId": "B"
                }
              }
            ],
            "queryOptions": {},
            "transformations": [
              {
                "kind": "extractFields",
                "spec": {
                  "id": "extractFields",
                  "options": {
                    "format": "json",
                    "source": "labels"
                  }
                }
              },
              {
                "kind": "organize",
                "spec": {
                  "id": "organize",
                  "options": {
                    "excludeByName": {
                      "Line": true,
                      "detected_level": true,
                      "id": true,
                      "labels": true,
                      "streamId": true,
                      "streams": true
                    }
                  }
                }
              },
              {
                "kind": "convertFieldType",
                "spec": {
                  "id": "convertFieldType",
                  "options": {
                    "conversions": [
                      {
                        "destinationType": "number",
                        "targetField": "errors"
                      },
                      {
                        "destinationType": "number",
                        "targetField": "warnings"
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "description": "",
        "id": 10,
        "links": [],
        "title": "Error & Warning Trend",
        "vizConfig": {
          "kind": "timeseries",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "custom": {
                  "fillOpacity": 20,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false
                },
                "unit": "short"
              },
              "overrides": [
                {
                  "matcher": {
                    "id": "byName",
                    "options": "errors"
                  },
                  "properties": [
                    {
                      "id": "color",
                      "value": {
                        "fixedColor": "red",
                        "mode": "fixed"
                      }
                    }
                  ]
                },
                {
                  "matcher": {
                    "id": "byName",
                    "options": "warnings"
                  },
                  "properties": [
                    {
                      "id": "color",
                      "value": {
                        "fixedColor": "orange",
                        "mode": "fixed"
                      }
                    }
                  ]
                }
              ]
            },
            "options": {
              "legend": {
                "calcs": [
                  "mean",
                  "max"
                ],
                "displayMode": "table",
                "placement": "bottom"
              },
              "tooltip": {
                "mode": "multi",
                "sort": "desc"
              }
            },
            "pluginVersion": ""
          }
        }
      }
    },
