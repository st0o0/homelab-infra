{
  "uid": "alloy",
  "title": "Alloy",
  "description": "Grafana Alloy pipeline health and internals.",
  "tags": [
    "alloy",
    "pipeline",
    "monitoring"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {},
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "allValue": ".*",
        "definition": "label_values(alloy_config_last_load_successful,host)",
        "hide": 0,
        "includeAll": true,
        "label": "Alloy Host",
        "multi": true,
        "name": "alloy_host",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(alloy_config_last_load_successful,host)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📊 Pipeline Health",
