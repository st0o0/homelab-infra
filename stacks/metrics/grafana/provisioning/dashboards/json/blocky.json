        { "expr": "sum by (blocky) (rate(blocky_cache_hits_total{blocky=~\"$blocky\"}[$__rate_interval]))", "legendFormat": "Hit {{blocky}}", "refId": "A" },
        { "expr": "sum by (blocky) (rate(blocky_cache_misses_total{blocky=~\"$blocky\"}[$__rate_interval]))", "legendFormat": "Miss {{blocky}}", "refId": "B" }
