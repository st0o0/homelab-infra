      "targets": [
        { "expr": "pihole_dns_queries_total{pihole=~\"$pihole\"}", "legendFormat": "{{pihole}} Total", "refId": "A" },
        { "expr": "pihole_ads_blocked_total{pihole=~\"$pihole\"}", "legendFormat": "{{pihole}} Blocked", "refId": "B" },
        { "expr": "pihole_queries_cached{pihole=~\"$pihole\"}", "legendFormat": "{{pihole}} Cached", "refId": "C" },
        { "expr": "pihole_queries_forwarded{pihole=~\"$pihole\"}", "legendFormat": "{{pihole}} Forwarded", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
