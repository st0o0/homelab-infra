{
  "uid": "containers",
  "title": "Containers",
  "description": "Docker container resource usage via cAdvisor.",
  "tags": ["cadvisor", "docker"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "timezone": "browser",
  "timepicker": {},
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
        "allValue": ".*",
        "definition": "label_values({__name__=~\"container.*\"},instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Docker Host",
        "multi": true,
        "name": "docker_host",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({__name__=~\"container.*\"},instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
        "allValue": ".*",
        "definition": "label_values({__name__=~\"container.*\", instance=~\"$docker_host\"},name)",
        "hide": 0,
        "includeAll": true,
        "label": "Container Name",
        "multi": true,
        "name": "container_name",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({__name__=~\"container.*\", instance=~\"$docker_host\"},name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🏥 Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Running Containers",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_last_seen{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(changes(container_start_time_seconds{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[24h]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "OOM Events (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {"text": "0"}
              },
              "type": "special"
            }
          ],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]
          }
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(container_oom_events_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[24h]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "CPU Throttled %",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[10m])) / sum(rate(container_cpu_cfs_periods_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[10m])) * 100",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Offenders (24h)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Container"},
            "properties": [
              {"id": "custom.width", "value": 200},
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Logs",
                    "url": "/d/containerlogs/container-logs?var-container=${__data.fields.Container}&${__url_time_range}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Host"},
            "properties": [{"id": "custom.width", "value": 160}]
          },
          {
            "matcher": {"id": "byName", "options": "Restarts"},
            "properties": [
              {"id": "custom.width", "value": 90},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 1},
                    {"color": "red", "value": 5}
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-background", "mode": "basic"}
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "OOM"},
            "properties": [
              {"id": "custom.width", "value": 80},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-background", "mode": "basic"}
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Health"},
            "properties": [
              {"id": "custom.width", "value": 100},
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {"text": "healthy", "color": "green"}
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "1": {"text": "unhealthy", "color": "red"}
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-text"}
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "enablePagination": false,
          "reducer": [],
          "show": true
        },
        "sortBy": [{"desc": true, "displayName": "Restarts"}]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Time 1": true, "Time 2": true, "Time 3": true},
            "indexByName": {"name": 0, "instance": 1, "Value #B": 2, "Value #C": 3, "Value #A": 4},
            "renameByName": {
              "name": "Container",
              "instance": "Host",
              "Value #A": "Health",
              "Value #B": "Restarts",
              "Value #C": "OOM"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, name) (container_health_state{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"})",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum by (instance, name) (changes(container_start_time_seconds{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[24h]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false,
          "hide": false
        },
        {
          "refId": "C",
          "expr": "sum by (instance, name) (increase(container_oom_events_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[24h]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false,
          "hide": false
        }
      ]
    },
    {
      "type": "row",
      "title": "⚖️ Resource Limits",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}
    },
    {
      "type": "bargauge",
      "title": "Memory Usage vs Limit",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum(container_memory_working_set_bytes{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}) by (instance, name) / sum(container_spec_memory_limit_bytes{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"} > 0) by (instance, name) * 100)",
          "legendFormat": "{{instance}} / {{name}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Throttling by Container",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum(rate(container_cpu_cfs_throttled_periods_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[10m])) by (instance, name) / sum(rate(container_cpu_cfs_periods_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[10m])) by (instance, name) * 100)",
          "legendFormat": "{{instance}} / {{name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "📊 Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (% by Core)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "links": [
            {
              "title": "View Logs",
              "url": "/d/containerlogs/container-logs?var-container=${__field.labels.name}&${__url_time_range}",
              "targetBlank": true
            }
          ],
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum(rate(container_cpu_usage_seconds_total{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}[10m])) by (instance, name) * 100)",
          "legendFormat": "{{instance}} / {{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage by Instance",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
      "datasource": {"type": "victoriametrics-metrics-datasource", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {"legend": false, "tooltip": false, "viz": false},
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"group": "A", "mode": "none"},
            "thresholdsStyle": {"mode": "off"}
          },
          "unit": "decbytes"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{instance=~\"$docker_host\",name=~\"$container_name\",name=~\".+\"}) by (instance)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "🔥 Pressure (PSI)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35}
    },
