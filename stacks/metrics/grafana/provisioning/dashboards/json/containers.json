{
  "uid": "containers-overview",
  "title": "Container Overview",
  "tags": ["homelab", "containers", "docker"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": { "uid": "victoriametrics", "type": "prometheus" },
        "query": "label_values(container_cpu_percent, host)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "multi": false
      },
      {
        "name": "container",
        "type": "query",
        "datasource": { "uid": "victoriametrics", "type": "prometheus" },
        "query": "label_values(container_cpu_percent{host=~\"$host\"}, container_name)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1,
        "multi": true
      },
      {
        "name": "interval",
        "type": "interval",
        "current": { "text": "1m", "value": "1m" },
        "options": [
          { "text": "30s", "value": "30s", "selected": false },
          { "text": "1m", "value": "1m", "selected": true },
          { "text": "5m", "value": "5m", "selected": false }
        ],
        "query": "30s,1m,5m"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "victoriametrics", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "container_cpu_percent{container_name=~\"$container\", host=~\"$host\"}",
          "legendFormat": "{{ host }}/{{ container_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "victoriametrics", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "container_memory_usage_total{container_name=~\"$container\", host=~\"$host\"}",
          "legendFormat": "{{ host }}/{{ container_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Container Network — Received",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "victoriametrics", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(container_network_io_usage_rx_bytes_total{container_name=~\"$container\", host=~\"$host\"}[$interval])",
          "legendFormat": "{{ host }}/{{ container_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container Network — Transmitted",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "victoriametrics", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(container_network_io_usage_tx_bytes_total{container_name=~\"$container\", host=~\"$host\"}[$interval])",
          "legendFormat": "{{ host }}/{{ container_name }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Container Memory Limit Usage %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "uid": "victoriametrics", "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "container_memory_percent{container_name=~\"$container\", host=~\"$host\"} > 0",
          "legendFormat": "{{ host }}/{{ container_name }}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
