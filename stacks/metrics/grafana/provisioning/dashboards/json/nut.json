    {
      "type": "state-timeline",
      "title": "UPS Status Flags",
      "id": 301,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": { "color": "transparent", "text": "—" },
                "1": { "color": "orange", "text": "Active" }
              },
              "type": "value"
            }
          ],
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "OL" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "color": "red", "text": "Offline" }, "1": { "color": "green", "text": "Online" } }, "type": "value" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "OB" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "color": "transparent", "text": "—" }, "1": { "color": "red", "text": "On Battery" } }, "type": "value" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "LB" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "color": "transparent", "text": "—" }, "1": { "color": "red", "text": "Low Battery" } }, "type": "value" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CHRG" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "color": "transparent", "text": "—" }, "1": { "color": "blue", "text": "Charging" } }, "type": "value" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "DISCHRG" },
            "properties": [
              {
