###############################################################################
# Grafana Alloy Environment Variables
# https://grafana.com/docs/alloy/latest/
#
# Alloy is configured primarily via its configuration file (config.alloy)
# and CLI flags. Only one native environment variable exists.
# Go runtime variables and CLI flags can also be set as env vars.
###############################################################################

# =============================================================================
# Alloy Native
# =============================================================================

# Deploy mode label for self-monitoring metrics
# Values: flow, static (default: flow)
# ALLOY_DEPLOY_MODE=flow

# =============================================================================
# Go Runtime (optional tuning)
# =============================================================================

# Max OS threads for Go runtime
# GOMAXPROCS=

# Garbage collector target percentage
# GOGC=100

# Memory limit for Go runtime (supports suffixes: 100MiB, 1GiB)
# GOMEMLIMIT=

# =============================================================================
# Notes
# =============================================================================
# Alloy is configured via CLI flags and config files, not env vars.
# Key CLI flags (pass via Docker command/entrypoint):
#   --config.file=/etc/alloy/config.alloy
#   --server.http.listen-addr=0.0.0.0:12345
#   --storage.path=/var/lib/alloy/data
#   --stability.level=generally-available
#   --config.extra-args="..."
#
# See: https://grafana.com/docs/alloy/latest/reference/cli/run/
