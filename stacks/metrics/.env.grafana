###############################################################################
# Grafana Environment Variables (GF_* prefix)
# https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/
#
# 200+ total vars available. Only the top ~50 most commonly used are listed.
# Full reference: https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/#override-configuration-with-environment-variables
# Format: GF_<SECTION>_<KEY> (all uppercase, dots become underscores)
###############################################################################

# =============================================================================
# Server
# =============================================================================

# Protocol: http, https, h2, socket
# GF_SERVER_PROTOCOL=http

# Listening address
# GF_SERVER_HTTP_ADDR=0.0.0.0

# Listening port
# GF_SERVER_HTTP_PORT=3000

# Domain for links and redirects
# GF_SERVER_DOMAIN=localhost

# Full root URL (used for OAuth callbacks, email links)
# GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s:%(http_port)s/

# Serve Grafana from subpath (must match ROOT_URL path)
# GF_SERVER_SERVE_FROM_SUB_PATH=false

# Enable gzip compression
# GF_SERVER_ENABLE_GZIP=false

# TLS certificate file path
# GF_SERVER_CERT_FILE=

# TLS key file path
# GF_SERVER_CERT_KEY=

# =============================================================================
# Security
# =============================================================================

# Admin username
# GF_SECURITY_ADMIN_USER=admin

# Admin password (set on first start)
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Secret key for signing (change in production)
# GF_SECURITY_SECRET_KEY=SW2YcwTIb9zpOOhoPsMm

# Disable initial admin password change prompt
# GF_SECURITY_DISABLE_INITIAL_ADMIN_CREATION=false

# Allow embedding Grafana in iframes
# GF_SECURITY_ALLOW_EMBEDDING=false

# Cookie secure flag (requires HTTPS)
# GF_SECURITY_COOKIE_SECURE=false

# Cookie SameSite attribute: lax, strict, none, disabled
# GF_SECURITY_COOKIE_SAMESITE=lax

# Disable gravatar
# GF_SECURITY_DISABLE_GRAVATAR=false

# =============================================================================
# Users
# =============================================================================

# Allow user signups
# GF_USERS_ALLOW_SIGN_UP=false

# Allow org creation by non-admin users
# GF_USERS_ALLOW_ORG_CREATE=false

# Auto-assign org ID for new users
# GF_USERS_AUTO_ASSIGN_ORG=true

# Auto-assign role for new users: Viewer, Editor, Admin
# GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer

# Default UI theme: dark, light, system
# GF_USERS_DEFAULT_THEME=dark

# =============================================================================
# Authentication
# =============================================================================

# Disable login form
# GF_AUTH_DISABLE_LOGIN_FORM=false

# Disable signout menu
# GF_AUTH_DISABLE_SIGNOUT_MENU=false

# OAuth auto login (redirect to OAuth provider)
# GF_AUTH_OAUTH_AUTO_LOGIN=false

# Anonymous access
# GF_AUTH_ANONYMOUS_ENABLED=false
# GF_AUTH_ANONYMOUS_ORG_NAME=Main Org.
# GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# Generic OAuth
# GF_AUTH_GENERIC_OAUTH_ENABLED=false
# GF_AUTH_GENERIC_OAUTH_NAME=OAuth
# GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
# GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
# GF_AUTH_GENERIC_OAUTH_AUTH_URL=
# GF_AUTH_GENERIC_OAUTH_TOKEN_URL=
# GF_AUTH_GENERIC_OAUTH_API_URL=
# GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=

# =============================================================================
# Database
# =============================================================================

# Database type: sqlite3, mysql, postgres
# GF_DATABASE_TYPE=sqlite3

# Database host (host:port)
# GF_DATABASE_HOST=127.0.0.1:3306

# Database name
# GF_DATABASE_NAME=grafana

# Database user
# GF_DATABASE_USER=root

# Database password
# GF_DATABASE_PASSWORD=

# Database SSL mode (postgres: disable, require, verify-full)
# GF_DATABASE_SSL_MODE=disable

# SQLite database path
# GF_DATABASE_PATH=grafana.db

# =============================================================================
# Analytics
# =============================================================================

# Enable usage reporting to Grafana
# GF_ANALYTICS_REPORTING_ENABLED=false

# Enable check for updates
# GF_ANALYTICS_CHECK_FOR_UPDATES=true

# Enable check for plugin updates
# GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=true

# =============================================================================
# Dashboards
# =============================================================================

# Minimum dashboard refresh interval
# GF_DASHBOARDS_MIN_REFRESH_INTERVAL=5s

# Default home dashboard path
# GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=

# =============================================================================
# Alerting
# =============================================================================

# Enable Grafana Alerting
# GF_UNIFIED_ALERTING_ENABLED=true

# Enable legacy alerting (deprecated)
# GF_ALERTING_ENABLED=false

# Alert evaluation timeout
# GF_UNIFIED_ALERTING_EVALUATION_TIMEOUT=30s

# Max concurrent alert evaluations
# GF_UNIFIED_ALERTING_MAX_ATTEMPTS=3

# =============================================================================
# SMTP / Email
# =============================================================================

# Enable email notifications
# GF_SMTP_ENABLED=false

# SMTP server host:port
# GF_SMTP_HOST=localhost:25

# SMTP username
# GF_SMTP_USER=

# SMTP password
# GF_SMTP_PASSWORD=

# Sender email address
# GF_SMTP_FROM_ADDRESS=admin@grafana.localhost

# Sender name
# GF_SMTP_FROM_NAME=Grafana

# Skip TLS verification
# GF_SMTP_SKIP_VERIFY=false

# STARTTLS policy: OpportunisticStartTLS, MandatoryStartTLS, NoStartTLS
# GF_SMTP_STARTTLS_POLICY=

# =============================================================================
# Plugins
# =============================================================================

# Install plugins on startup (comma-separated: id, id@version)
# GF_INSTALL_PLUGINS=

# Allow loading unsigned plugins (comma-separated plugin IDs)
# GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=

# Plugin catalog URL
# GF_PLUGINS_PLUGIN_CATALOG_URL=https://grafana.com/grafana/plugins/

# =============================================================================
# Paths
# =============================================================================

# Data directory
# GF_PATHS_DATA=/var/lib/grafana

# Logs directory
# GF_PATHS_LOGS=/var/log/grafana

# Plugins directory
# GF_PATHS_PLUGINS=/var/lib/grafana/plugins

# Provisioning directory
# GF_PATHS_PROVISIONING=/etc/grafana/provisioning

# =============================================================================
# Logging
# =============================================================================

# Log mode: console, file, syslog
# GF_LOG_MODE=console

# Log level: debug, info, warn, error, critical
# GF_LOG_LEVEL=info

# Log line format: text, console, json
# GF_LOG_CONSOLE_FORMAT=console
