###############################################################################
# VictoriaLogs Environment Variables
# https://docs.victoriametrics.com/victorialogs/
#
# VictoriaLogs uses CLI flags natively. With -envflag.enable, flags
# become environment variables by uppercasing and replacing dots/dashes.
# Set -envflag.prefix to add a custom prefix.
###############################################################################

# =============================================================================
# Environment Flag Support
# =============================================================================

# Enable reading flags from environment variables
# Pass as CLI flag: -envflag.enable
# envflag.enable=true

# Prefix for environment variables
# envflag.prefix=

# =============================================================================
# Storage
# =============================================================================

# Path to data storage directory
# storageDataPath=/victoria-logs-data

# Data retention period (supports h/d/w/y suffixes)
# retentionPeriod=7d

# Max disk space usage (supports KB, MB, GB, TB suffixes; 0 = unlimited)
# retentionMaxDiskSpaceUsage=0

# =============================================================================
# Network
# =============================================================================

# HTTP listen address
# httpListenAddr=:9428

# Enable TLS for incoming requests
# tls=false

# TLS certificate file path
# tlsCertFile=

# TLS key file path
# tlsKeyFile=

# =============================================================================
# Ingestion
# =============================================================================

# Max length of a single log line
# insert.maxLineSizeBytes=67108864

# Max number of fields per log entry
# insert.maxFieldsPerLine=1000

# =============================================================================
# Search / Query
# =============================================================================

# Max number of concurrent select queries
# search.maxConcurrentRequests=6

# Max duration for a query
# search.maxQueryDuration=30s

# Max lines returned per query
# search.maxLines=1000

# =============================================================================
# Memory
# =============================================================================

# Max memory percentage for VictoriaLogs
# memory.allowedPercent=60

# =============================================================================
# Logging
# =============================================================================

# Log level: INFO, WARN, ERROR, FATAL, PANIC
# loggerLevel=INFO

# Log format: default, json
# loggerFormat=default

# Disable timestamps in log output
# loggerDisableTimestamps=false
