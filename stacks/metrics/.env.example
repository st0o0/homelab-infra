# ============================================================
# Required — stack will not start without these
# ============================================================
GRAFANA_ADMIN_PASS=changeme
GRAFANA_PATH_DATA=changeme
VM_PATH_DATA=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================

# Grafana
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ALLOW_SIGN_UP=false
# GRAFANA_ANALYTICS_REPORTING=false
# GRAFANA_CHECK_FOR_UPDATES=false
# GRAFANA_NEWS_FEED=false
# GRAFANA_DB_WAL=true

# Grafana alerting (Discord webhook for alert notifications)
# DISCORD_WEBHOOK_URL=

# Grafana external DB (optional, default SQLite)
# GRAFANA_DB_TYPE=sqlite3
# GRAFANA_DB_HOST=
# GRAFANA_DB_NAME=grafana
# GRAFANA_DB_USER=
# GRAFANA_DB_PASS=
# GRAFANA_DB_SSL_MODE=disable

# VictoriaMetrics
# VM_PORT=8428
# VM_RETENTION=90d
# VM_SCRAPE_INTERVAL=30s
# VM_SELF_SCRAPE_INTERVAL=1m

# VictoriaLogs
# VL_PORT=9428
# VL_RETENTION=90d
# VL_MAX_DISK_GB=0
# VL_PATH_DATA=./data/victorialogs

# TZ=Europe/Berlin
