# Keycloak Database
# JDBC format: jdbc:postgresql://<host>:<port>/<database>
KC_DB_URL=jdbc:postgresql://10.0.0.5:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=changeme

# Keycloak Admin
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme

# Keycloak Settings
KC_PORT=8080
KC_LOG_LEVEL=warn

# step-ca Certificate Authority
STEPCA_DNS_NAMES=step-ca.example.com,step-ca,localhost
STEPCA_PASSWORD=changeme
STEPCA_PROVISIONER_NAME=admin
STEPCA_NAME=Sloth Homelab CA
STEPCA_PORT=9000

# SMTP (for password reset and enrollment emails)
KC_SMTP_HOST=smtp.example.com
KC_SMTP_PORT=587
KC_SMTP_FROM=noreply@example.com
KC_SMTP_USER=noreply@example.com
KC_SMTP_PASSWORD=changeme

# OIDC Clients — per app: ID, secret, redirect URI(s)
KC_CLIENT_JELLYFIN_ID=jellyfin
KC_CLIENT_JELLYFIN_SECRET=changeme
KC_CLIENT_JELLYFIN_REDIRECT_URI=https://jellyfin.example.com/sso/OID/redirect/keycloak

KC_CLIENT_AUDIOBOOKSHELF_ID=audiobookshelf
KC_CLIENT_AUDIOBOOKSHELF_SECRET=changeme
KC_CLIENT_AUDIOBOOKSHELF_REDIRECT_URI=https://audiobookshelf.example.com/auth/openid/callback

KC_CLIENT_IMMICH_ID=immich
KC_CLIENT_IMMICH_SECRET=changeme
KC_CLIENT_IMMICH_REDIRECT_URI_1=https://immich.example.com/auth/login
KC_CLIENT_IMMICH_REDIRECT_URI_2=https://immich.example.com/user-settings
KC_CLIENT_IMMICH_REDIRECT_URI_3=app.immich:/

KC_CLIENT_MEALIE_ID=mealie
KC_CLIENT_MEALIE_SECRET=changeme
KC_CLIENT_MEALIE_REDIRECT_URI=https://mealie.example.com/login

KC_CLIENT_PAPERLESS_ID=paperless
KC_CLIENT_PAPERLESS_SECRET=changeme
KC_CLIENT_PAPERLESS_REDIRECT_URI=https://paperless.example.com/accounts/oidc/keycloak/login/callback/

KC_CLIENT_VAULTWARDEN_ID=vaultwarden
KC_CLIENT_VAULTWARDEN_SECRET=changeme
KC_CLIENT_VAULTWARDEN_REDIRECT_URI=https://vaultwarden.example.com/identity/connect/oidc-signin

KC_CLIENT_PANGOLIN_ID=pangolin
KC_CLIENT_PANGOLIN_SECRET=changeme
KC_CLIENT_PANGOLIN_REDIRECT_URI=https://pangolin.example.com/auth/callback

KC_CLIENT_KOMODO_ID=komodo
KC_CLIENT_KOMODO_SECRET=changeme
KC_CLIENT_KOMODO_REDIRECT_URI=https://komodo.example.com/auth/oidc/callback

# step-ca OIDC provisioner
KC_CLIENT_STEPCA_SECRET=changeme
