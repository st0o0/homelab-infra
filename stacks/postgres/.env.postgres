###############################################################################
# PostgreSQL (Official Image) Environment Variables
# https://hub.docker.com/_/postgres
###############################################################################

# =============================================================================
# Required
# =============================================================================

# Superuser password (required unless POSTGRES_HOST_AUTH_METHOD=trust)
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================================
# Database Initialization
# =============================================================================

# Superuser username (default: postgres)
# POSTGRES_USER=postgres

# Default database name (default: value of POSTGRES_USER)
# POSTGRES_DB=postgres

# Additional initdb arguments (e.g., --data-checksums --locale=en_US.UTF-8)
# POSTGRES_INITDB_ARGS=

# WAL directory location (separate disk for performance)
# POSTGRES_INITDB_WALDIR=

# =============================================================================
# Authentication
# =============================================================================

# Host auth method for pg_hba.conf: trust, md5, scram-sha-256, reject
# WARNING: trust allows passwordless connections
# POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# =============================================================================
# Data Directory
# =============================================================================

# Data directory inside the container
# PGDATA=/var/lib/postgresql/data
