###############################################################################
# CloudBeaver Environment Variables
# https://dbeaver.com/docs/cloudbeaver/
#
# All variables use the CLOUDBEAVER_ prefix.
###############################################################################

# =============================================================================
# Server Configuration
# =============================================================================

# Server hostname
# CLOUDBEAVER_SERVER_HOST=0.0.0.0

# Server port
# CLOUDBEAVER_SERVER_PORT=8978

# Server name displayed in the UI
# CLOUDBEAVER_SERVER_NAME=CloudBeaver

# Root URI (for reverse proxy, e.g., /cloudbeaver)
# CLOUDBEAVER_SERVER_ROOT_URI=/

# External URL for redirects
# CLOUDBEAVER_SERVER_URL=http://localhost:8978

# Workspace location
# CLOUDBEAVER_WORKSPACE_LOCATION=/opt/cloudbeaver/workspace

# Content root path
# CLOUDBEAVER_CONTENT_ROOT=/opt/cloudbeaver/web

# Drivers location
# CLOUDBEAVER_DRIVERS_LOCATION=/opt/cloudbeaver/drivers

# =============================================================================
# Database (Internal Metadata DB)
# =============================================================================

# Internal database driver: h2_embedded, postgres
# CLOUDBEAVER_DB_DRIVER=h2_embedded

# Database URL (for PostgreSQL backend)
# CLOUDBEAVER_DB_URL=

# Database host (for PostgreSQL backend)
# CLOUDBEAVER_DB_HOST=

# Database port
# CLOUDBEAVER_DB_PORT=5432

# Database name
# CLOUDBEAVER_DB_DATABASE=cloudbeaver

# Database user
# CLOUDBEAVER_DB_USER=

# Database password
# CLOUDBEAVER_DB_PASSWORD=

# Database schema
# CLOUDBEAVER_DB_SCHEMA=public

# =============================================================================
# Application Settings
# =============================================================================

# Enable anonymous access
# CLOUDBEAVER_APP_ANONYMOUS_ACCESS_ENABLED=true

# Enable user authentication
# CLOUDBEAVER_APP_AUTHENTICATION_ENABLED=true

# Supports custom connections from users
# CLOUDBEAVER_APP_SUPPORTS_CUSTOM_CONNECTIONS=true

# Enable public credentials sharing
# CLOUDBEAVER_APP_PUBLIC_CREDENTIALS=true

# Enable admin credentials saving
# CLOUDBEAVER_APP_ADMIN_CREDENTIALS_SAVE_ENABLED=true

# Enable user credentials saving
# CLOUDBEAVER_APP_USER_CREDENTIALS_SAVE_ENABLED=true

# Default navigator view: simple, system
# CLOUDBEAVER_APP_DEFAULT_NAVIGATOR_VIEW=simple

# Enable resource manager
# CLOUDBEAVER_APP_RESOURCE_MANAGER_ENABLED=true

# =============================================================================
# Security
# =============================================================================

# Admin user name
CLOUDBEAVER_ADMIN_NAME=CHANGE_ME

# Admin user password
CLOUDBEAVER_ADMIN_PASSWORD=CHANGE_ME

# Session expiration time in milliseconds
# CLOUDBEAVER_SECURITY_SESSION_EXPIRE_TIME=1800000

# Max number of failed login attempts
# CLOUDBEAVER_SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=10

# Lockout duration after max failed attempts (ms)
# CLOUDBEAVER_SECURITY_LOGIN_BLOCK_PERIOD=300000

# Enable HTTPS redirect
# CLOUDBEAVER_SECURITY_REDIRECT_TO_HTTPS=false

# =============================================================================
# Quotas / Limits
# =============================================================================

# Max data export file size in bytes
# CLOUDBEAVER_QUOTA_DATA_EXPORT_FILE_LIMIT=10000000

# Max number of result-set rows
# CLOUDBEAVER_QUOTA_RESULT_SET_ROW_LIMIT=200

# Max number of resources per user
# CLOUDBEAVER_QUOTA_RESOURCE_QUOTA=100

# Max number of connections per user
# CLOUDBEAVER_QUOTA_MAX_CONNECTIONS_PER_USER=10

# SQL query result limit
# CLOUDBEAVER_QUOTA_SQL_RESULT_SET_LIMIT=100000

# Max SQL query text length
# CLOUDBEAVER_QUOTA_SQL_TEXT_PREVIEW_MAX_LENGTH=4096

# SQL query execution timeout in seconds
# CLOUDBEAVER_QUOTA_SQL_QUERY_TIMEOUT=60

# =============================================================================
# Logging
# =============================================================================

# Log level: trace, debug, info, warn, error
# CLOUDBEAVER_LOG_LEVEL=info

# Log file path
# CLOUDBEAVER_LOG_FILE=

# =============================================================================
# SMTP (for notifications)
# =============================================================================

# SMTP server host
# CLOUDBEAVER_SMTP_HOST=

# SMTP server port
# CLOUDBEAVER_SMTP_PORT=25

# SMTP username
# CLOUDBEAVER_SMTP_USER=

# SMTP password
# CLOUDBEAVER_SMTP_PASSWORD=

# SMTP sender address
# CLOUDBEAVER_SMTP_FROM=
