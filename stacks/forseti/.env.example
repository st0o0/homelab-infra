# ============================================================
# Required -- stack will not start without these
# ============================================================
FORSETI_MIKROTIK_HOST=mikrotik.example.com
FORSETI_MIKROTIK_PASSWORD=changeme
FORSETI_PIZERO_HOST=pizero.example.com
FORSETI_PIZERO_PASSWORD=changeme

# ============================================================
# Optional -- uncomment to override defaults
# ============================================================
# FORSETI_METRICS_PORT=9099
# FORSETI_MIKROTIK_PORT=80
# FORSETI_PIZERO_PORT=80

# Timezone (IANA); shared Komodo variable `tz`, default Europe/Berlin
# TZ=Europe/Berlin
