# ============================================================
# Required — stack will not start without these
# ============================================================
AUTHENTIK_KEY=changeme
AUTHENTIK_DB_PASS=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# AUTHENTIK_DB_HOST=authentik-db
# AUTHENTIK_DB_USER=authentik
# AUTHENTIK_DB_NAME=authentik
# AUTHENTIK_PORT_HTTP=9000
# AUTHENTIK_PORT_HTTPS=9443
# AUTHENTIK_PATH_MEDIA=./media
# AUTHENTIK_PATH_TEMPLATES=./custom-templates
# AUTHENTIK_PATH_CERTS=./certs

# ============================================================
# Email (SMTP) — required for password recovery flow
# ============================================================
# AUTHENTIK_EMAIL_HOST=smtp.example.com
# AUTHENTIK_EMAIL_PORT=587
# AUTHENTIK_EMAIL_USER=authentik@example.com
# AUTHENTIK_EMAIL_PASS=changeme
# AUTHENTIK_EMAIL_USE_TLS=true
# AUTHENTIK_EMAIL_FROM=authentik@example.com

# ============================================================
# Reverse proxy / Forward Auth
# ============================================================
# AUTHENTIK_COOKIE_DOMAIN=example.com
# AUTHENTIK_TRUSTED_PROXY_CIDRS=10.x.x.x/32

# ============================================================
# Optional — logging
# ============================================================
# AUTHENTIK_LOG_LEVEL=warning

# ============================================================
# Brand — domain identifier for the default brand
# ============================================================
AUTHENTIK_BRAND_DOMAIN=auth.example.com

# ============================================================
# Blueprint Providers — required for SSO blueprints
# ============================================================

# AudioBookshelf
AUTHENTIK_PROVIDER_AUDIOBOOKSHELF_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_AUDIOBOOKSHELF_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_AUDIOBOOKSHELF_REDIRECT_URI_1=https://audio.example.com/auth/openid/callback
AUTHENTIK_PROVIDER_AUDIOBOOKSHELF_REDIRECT_URI_2=https://audio.example.com/auth/openid/mobile-redirect

# Immich
AUTHENTIK_PROVIDER_IMMICH_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_IMMICH_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_IMMICH_REDIRECT_URI_1=https://immich.example.com/auth/login
AUTHENTIK_PROVIDER_IMMICH_REDIRECT_URI_2=https://immich.example.com/user-settings
AUTHENTIK_PROVIDER_IMMICH_REDIRECT_URI_3=app.immich:///oauth-callback

# Jellyfin
AUTHENTIK_PROVIDER_JELLYFIN_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_JELLYFIN_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_JELLYFIN_REDIRECT_URI=https://media.example.com/sso/OID/redirect/authentik

# Mealie
AUTHENTIK_PROVIDER_MEALIE_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_MEALIE_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_MEALIE_REDIRECT_URI_1=https://mealie.example.com/login
AUTHENTIK_PROVIDER_MEALIE_REDIRECT_URI_2=https://mealie.example.com/login?direct=1

# Pangolin
AUTHENTIK_PROVIDER_PANGOLIN_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_PANGOLIN_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_PANGOLIN_REDIRECT_URI=https://pangolin.example.com/auth/idp/1/oidc/callback

# Paperless-ngx
AUTHENTIK_PROVIDER_PAPERLESS_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_PAPERLESS_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_PAPERLESS_REDIRECT_URI=https://paperless.example.com/accounts/oidc/authentik/login/callback/

# Vaultwarden
AUTHENTIK_PROVIDER_VAULTWARDEN_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_VAULTWARDEN_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_VAULTWARDEN_REDIRECT_URI=https://vault.example.com/identity/connect/oidc-signin
AUTHENTIK_PROVIDER_VAULTWARDEN_EXTERNAL_HOST=https://vault.example.com

# Komodo
AUTHENTIK_PROVIDER_KOMODO_CLIENT_ID=changeme
AUTHENTIK_PROVIDER_KOMODO_CLIENT_SECRET=changeme
AUTHENTIK_PROVIDER_KOMODO_REDIRECT_URI=https://komodo.example.com/auth/oidc/callback

# Jellyseer (app-only, no provider)
AUTHENTIK_APP_JELLYSEER_LAUNCH_URL=https://jellyseer.example.com

