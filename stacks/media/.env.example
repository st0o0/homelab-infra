# Ports
# JELLYFIN_PORT=8096
# AUDIOBOOKSHELF_PORT=13378

# Jellyfin paths
# JELLYFIN_CONFIG_PATH=./data/jellyfin/config
# JELLYFIN_CACHE_PATH=./data/jellyfin/cache
# JELLYFIN_PREVIEW_PATH=./data/jellyfin/preview
# JELLYFIN_VIDEO_PATH=./data/jellyfin/video

# Audiobookshelf paths
# AUDIOBOOKSHELF_CONFIG_PATH=./data/audiobookshelf/config
# AUDIOBOOKSHELF_METADATA_PATH=./data/audiobookshelf/metadata

# CIFS shares
# Media library (shared with the arr stack's sonarr/radarr volume)
CIFS_MEDIA_HOST=changeme
CIFS_MEDIA_SHARE=changeme
CIFS_MEDIA_USER=changeme
CIFS_MEDIA_PASSWORD=changeme
# Audiobooks (standalone, not shared with any other stack)
CIFS_AUDIOS_HOST=changeme
CIFS_AUDIOS_SHARE=changeme
CIFS_AUDIOS_USER=changeme
CIFS_AUDIOS_PASSWORD=changeme

# Optional
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin
