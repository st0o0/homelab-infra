# =============================================================================
# jellyfin/jellyfin — Environment Variable Reference
# Image: jellyfin/jellyfin (official, NOT linuxserver — no PUID/PGID/TZ)
# Docs:  https://jellyfin.org/docs/general/installation/container
# =============================================================================

# --- Directories ---
# JELLYFIN_DATA_DIR=/config
# JELLYFIN_CONFIG_DIR=/config/config
# JELLYFIN_CACHE_DIR=/cache
# JELLYFIN_LOG_DIR=/config/log
# JELLYFIN_WEB_DIR=/jellyfin/jellyfin-web
# JELLYFIN_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg

# --- Network ---
# JELLYFIN_PublishedServerUrl=          # URL for auto-discovery (e.g. http://jellyfin.example.com)
# HEALTHCHECK_URL=http://localhost:8096/health

# --- Locale ---
# LC_ALL=en_US.UTF-8
# LANG=en_US.UTF-8
# LANGUAGE=en_US:en

# --- GPU (NVIDIA) ---
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

# --- Performance ---
# MALLOC_TRIM_THRESHOLD_=131072

# --- Advanced ---
# JELLYFIN_NOWEBCONTENT=               # set true to disable built-in web client
