# =============================================================================
# ghcr.io/advplyr/audiobookshelf — Environment Variable Reference
# Docs: https://www.audiobookshelf.org/docs
# =============================================================================

# --- Server ---
# PORT=80                              # HTTP listen port inside container
# HOST=0.0.0.0                         # Bind address
# NODE_ENV=production                  # Node environment (production|development)
# SOURCE=docker                        # Source identifier

# --- Paths ---
# CONFIG_PATH=/config                  # Path to config directory
# METADATA_PATH=/metadata              # Path to metadata directory

# --- Routing ---
# ROUTER_BASE_PATH=/                   # Base path for reverse proxy sub-path hosting

# --- Network / Security ---
# ALLOW_CORS=0                         # Set 1 to enable CORS headers
# USE_X_ACCEL=0                        # Set 1 to use Nginx X-Accel-Redirect for file serving
# EXP_PROXY_SUPPORT=0                  # Set 1 for experimental reverse proxy support
# DISABLE_SSRF_REQUEST_FILTER=0        # Set 1 to disable SSRF request filtering
# SSRF_REQUEST_FILTER_WHITELIST=       # Comma-separated list of allowed hosts for SSRF filter

# --- Podcasts ---
# PODCAST_DOWNLOAD_TIMEOUT=60000       # Podcast episode download timeout in ms
# MAX_FAILED_EPISODE_CHECKS=5          # Max consecutive failed episode checks before disabling

# --- Experimental ---
# REACT_CLIENT_PATH=                   # Path to alternative React client build
