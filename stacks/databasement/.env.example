# ============================================================
# Required — stack will not start without these
# ============================================================
DATABASEMENT_APP_KEY=base64:changeme
DATABASEMENT_DB_PASS=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# DATABASEMENT_APP_URL=http://localhost:2226
# DATABASEMENT_APP_ENV=production
# DATABASEMENT_APP_DEBUG=false
# DATABASEMENT_DB_HOST=postgres
# DATABASEMENT_DB_PORT=5432
# DATABASEMENT_DB_NAME=databasement
# DATABASEMENT_DB_USER=postgres
# DATABASEMENT_QUEUE_CONNECTION=database
# DATABASEMENT_CACHE_STORE=database
# DATABASEMENT_SESSION_DRIVER=database
# DATABASEMENT_PORT=2226
# DATABASEMENT_BIND_IP=127.0.0.1
# DATABASEMENT_PATH_DATA=./data
# TZ=Europe/Berlin
