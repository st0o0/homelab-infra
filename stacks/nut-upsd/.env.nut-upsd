###############################################################################
# NUT-UPSd (Network UPS Tools Server) Environment Variables
# https://github.com/instantlinux/docker-tools/tree/main/images/nut-upsd
###############################################################################

# =============================================================================
# UPS Driver Configuration
# =============================================================================

# UPS driver name (e.g., usbhid-ups, snmp-ups, blazer_usb)
DRIVER=CHANGE_ME

# UPS name (used in NUT client connections)
NAME=CHANGE_ME

# UPS driver port (auto for USB, hostname for SNMP)
# PORT=auto

# Polling interval in seconds
# POLLINTERVAL=2

# Additional driver description
# DESCRIPTION=UPS

# Serial number of the UPS (for disambiguation with multiple USB UPS)
# SERIAL=

# Vendor ID for USB matching
# VENDORID=

# Product ID for USB matching
# PRODUCTID=

# =============================================================================
# API / User Access
# =============================================================================

# NUT API username
API_USER=CHANGE_ME

# NUT API password
API_PASSWORD=CHANGE_ME

# API user role: admin, master, slave
# API_USER_ROLE=admin

# =============================================================================
# Server Settings
# =============================================================================

# Server listen address
# SERVER=0.0.0.0

# Server listen port
# SERVER_PORT=3493

# Max login attempts
# MAXAGE=15

# Max retry count
# MAXRETRY=3

# =============================================================================
# Container Settings
# =============================================================================

# Container user ID
# PUID=0

# Container group ID
# PGID=0

# Timezone
# TZ=UTC

# =============================================================================
# Shutdown
# =============================================================================

# Shutdown command to run
# SHUTDOWNCMD=/sbin/shutdown -h +0

# Enable UPS shutdown on host shutdown
# UPSDRVCTL_UPS_SHUTDOWN=false
