###############################################################################
# Peanut (NUT Web UI) Environment Variables
# https://github.com/Brandawg93/PeaNUT
###############################################################################

# =============================================================================
# Web Interface
# =============================================================================

# Web UI port
# WEB_PORT=8080

# Web UI host
# WEB_HOST=0.0.0.0

# Base path for reverse proxy (e.g., /peanut)
# BASE_PATH=

# =============================================================================
# NUT Connection (Single UPS)
# =============================================================================

# NUT server hostname
NUT_HOST=CHANGE_ME

# NUT server port
# NUT_PORT=3493

# UPS name on the NUT server
NUT_UPS_NAME=CHANGE_ME

# NUT username for authentication
# NUT_USERNAME=

# NUT password for authentication
# NUT_PASSWORD=

# =============================================================================
# NUT Connection (Multiple UPS)
# =============================================================================

# JSON array of NUT servers for multi-UPS monitoring
# Format: [{"host":"ip1","port":3493,"name":"ups1"},{"host":"ip2","port":3493,"name":"ups2"}]
# NUT_SERVERS=

# =============================================================================
# InfluxDB Integration
# =============================================================================

# Enable InfluxDB data export
# INFLUX_ENABLED=false

# InfluxDB server URL
# INFLUX_HOST=

# InfluxDB server port
# INFLUX_PORT=8086

# InfluxDB authentication token
# INFLUX_TOKEN=

# InfluxDB organization
# INFLUX_ORG=

# InfluxDB bucket name
# INFLUX_BUCKET=

# InfluxDB write interval in seconds
# INFLUX_INTERVAL=10

# =============================================================================
# Display Preferences
# =============================================================================

# Preferred voltage display unit: V, kV
# VOLTAGE_UNIT=V

# Preferred power display unit: W, kW
# POWER_UNIT=W

# Preferred runtime display unit: minutes, hours
# RUNTIME_UNIT=minutes

# Preferred temperature display unit: C, F
# TEMPERATURE_UNIT=C

# Preferred frequency display unit: Hz, kHz
# FREQUENCY_UNIT=Hz

# Number of decimal places for values
# DECIMAL_PLACES=1

# =============================================================================
# Notifications
# =============================================================================

# Enable notifications
# NOTIFICATIONS_ENABLED=false

# Notification on battery threshold (percentage)
# NOTIFICATION_BATTERY_THRESHOLD=50

# Notification on UPS status change
# NOTIFICATION_STATUS_CHANGE=true

# =============================================================================
# Container Settings
# =============================================================================

# Timezone
# TZ=UTC

# Container user ID
# PUID=1000

# Container group ID
# PGID=1000
