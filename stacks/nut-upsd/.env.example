# ============================================================
# Required — stack will not start without these
# ============================================================
NUT_DRIVER=changeme
NUT_API_USER=changeme
NUT_API_PASS=changeme
NUT_PATH_CONFIG=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# NUT_NAME=ups
# NUT_DRIVER_PORT=auto
# NUT_PORT=3493
# NUT_POLL_INTERVAL=15
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin
