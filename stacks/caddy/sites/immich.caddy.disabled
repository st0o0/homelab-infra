{$CADDY_DOMAIN_IMMICH} {
	import defaults

	request_body {
		max_size 50GB
	}

	reverse_proxy {$CADDY_TARGET_IMMICH} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
		transport http {
			read_timeout 600s
		}
	}
}
