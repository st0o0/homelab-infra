# =============================================================================
# Home Assistant  (ghcr.io/home-assistant/home-assistant)
# =============================================================================
# Home Assistant is primarily configured via configuration.yaml and the web UI.
# Very few settings are controlled through environment variables.

# --- General ---
# TZ=Europe/Berlin                     # IANA timezone used for automations, UI, and logs

# --- Performance ---
# PYTHONMALLOC=mimalloc                # alternative allocator; use "pymalloc" for the built-in one
# PYTHONDONTWRITEBYTECODE=1            # skip writing .pyc files (reduces disk I/O)
# PYTHONUNBUFFERED=1                   # force unbuffered stdout/stderr (useful for log drivers)
