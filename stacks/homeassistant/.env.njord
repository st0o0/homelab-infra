# =============================================================================
# Njord  (ghcr.io/st0o0/njord)  — solar forecast aggregator
# =============================================================================
# ASP.NET Core app using Microsoft.Extensions.Configuration binding.
# Array values use __N suffix: Njord__Horizons__0=1, Njord__Horizons__1=2, ...

# --- ASP.NET Core ---
# listening URL (scheme://host:port)
ASPNETCORE_URLS=http://+:9090

# --- Kestrel Health Endpoint ---
# Separate port for health/readiness probes (keeps health off the main port)
Kestrel__Endpoints__health__Url=http://+:9091

# --- Polling ---
# Njord__PollInterval=01:00:00         # TimeSpan — how often to refresh forecasts
# Njord__ForecastDays=7                # number of days to fetch per poll

# --- Forecast Horizons (hours ahead) ---
# Array of integer hour offsets; extend with __N suffixes.
# Njord__Horizons__0=1
# Njord__Horizons__1=2
# Njord__Horizons__2=3
# Njord__Horizons__3=6
# Njord__Horizons__4=12
# Njord__Horizons__5=24
# Njord__Horizons__6=48
# ...

# --- Weather Models ---
# Array of Open-Meteo model identifiers; extend with __N suffixes.
# Njord__Models__0=icon_global
# Njord__Models__1=ecmwf_ifs025
# Njord__Models__2=icon_eu
# Njord__Models__3=gfs_seamless
# ...

# --- Locations ---
# Each location is an object with Name, Latitude, Longitude, and optional
# per-location Models override.  Use __N__Field syntax:
#
# Njord__Locations__0__Name=vreden
# Njord__Locations__0__Latitude=52.0379
# Njord__Locations__0__Longitude=6.828
# Njord__Locations__0__Models__0=knmi_harmonie_arome_netherlands
# Njord__Locations__0__Models__1=icon_d2

# --- Parameter Groups ---
# Njord__Parameters__Groups__0=Weather

# --- Enrichment: Consensus ---
# Njord__Enrichment__Consensus__Enabled=true

# --- Enrichment: Alerts ---
# Njord__Enrichment__Alerts__Enabled=true
# Njord__Enrichment__Alerts__PressureDropThreshold=1

# --- Enrichment: Indices ---
# Njord__Enrichment__Indices__Enabled=true
