# =============================================================================
# matter.js Server  (ghcr.io/matter-js/matterjs-server)
# =============================================================================

# --- Storage ---
# STORAGE_PATH=/data                   # persistent data directory

# --- Network ---
# PORT=5540                            # Matter commissioning port
# LISTEN_ADDRESS=                      # bind address; empty = all interfaces
# PRIMARY_INTERFACE=                   # preferred network interface name

# --- Logging ---
# LOG_LEVEL=info                       # debug | info | notice | warn | error | fatal
# LOG_FILE=                            # path to log file; empty = stdout only

# --- Commissioning / Identity ---
# VENDOR_ID=0xFFF1                     # Matter vendor ID (test range: 0xFFF1-0xFFF4)
# FABRIC_ID=                           # fabric identifier

# --- Dashboard ---
# DISABLE_DASHBOARD=false              # set true to disable the built-in web dashboard

# --- Runtime ---
# PRODUCTION_MODE=false                # enable production hardening
# NODE_OPTIONS=                        # Node.js runtime flags (e.g. --max-old-space-size=512)
# TZ=Europe/Berlin                     # IANA timezone

# --- Bluetooth / BLE ---
# BLUETOOTH_ADAPTER=                   # HCI adapter index (e.g. hci0)
# BLE_PROXY=true                       # proxy BLE commissioning through the server
# NOBLE_BINDINGS=                      # noble BLE binding override

# --- OTA Updates ---
# DISABLE_OTA=false                    # disable OTA provider functionality
# OTA_PROVIDER_DIR=                    # directory containing OTA firmware images

# --- DCL (Distributed Compliance Ledger) ---
# ENABLE_TEST_NET_DCL=false            # use the test-net DCL instead of production
# DISABLE_DCL_SEED=false               # disable seeding from DCL on startup

# --- Time ---
# ENABLE_TIME_SYNC=false               # enable the Time Sync cluster
