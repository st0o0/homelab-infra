# =============================================================================
# Zigbee2MQTT  (ghcr.io/koenkk/zigbee2mqtt)
# =============================================================================
# Native env vars plus the ZIGBEE2MQTT_CONFIG_* override convention.
# Any configuration.yaml key can be set via env using the pattern:
#   ZIGBEE2MQTT_CONFIG_<SECTION>_<KEY>=value   (double underscore = nesting)
#
# Env vars take precedence over configuration.yaml values.

# --- Native ---
# TZ=Europe/Berlin                     # IANA timezone
# ZIGBEE2MQTT_DATA=/app/data           # path to data directory inside the container

# --- MQTT Connection ---
# e.g. mqtt://mosquitto:1883
ZIGBEE2MQTT_CONFIG_MQTT_SERVER=CHANGE_ME
# ZIGBEE2MQTT_CONFIG_MQTT_BASE_TOPIC=zigbee2mqtt
# ZIGBEE2MQTT_CONFIG_MQTT_USER=
# ZIGBEE2MQTT_CONFIG_MQTT_PASSWORD=
# ZIGBEE2MQTT_CONFIG_MQTT_CLIENT_ID=zigbee2mqtt
# ZIGBEE2MQTT_CONFIG_MQTT_KEEPALIVE=60
# ZIGBEE2MQTT_CONFIG_MQTT_VERSION=5    # MQTT protocol version (4 or 5)
# ZIGBEE2MQTT_CONFIG_MQTT_REJECT_UNAUTHORIZED=true

# --- Serial / Adapter ---
# e.g. /dev/ttyUSB0 or tcp://slzb-06:6638
ZIGBEE2MQTT_CONFIG_SERIAL_PORT=CHANGE_ME
# ZIGBEE2MQTT_CONFIG_SERIAL_ADAPTER=auto       # auto | zstack | deconz | ezsp | ember | zboss
# ZIGBEE2MQTT_CONFIG_SERIAL_BAUDRATE=115200
# ZIGBEE2MQTT_CONFIG_SERIAL_RTSCTS=false

# --- Frontend ---
# ZIGBEE2MQTT_CONFIG_FRONTEND_ENABLED=true
# ZIGBEE2MQTT_CONFIG_FRONTEND_PORT=8080
# ZIGBEE2MQTT_CONFIG_FRONTEND_HOST=0.0.0.0
# ZIGBEE2MQTT_CONFIG_FRONTEND_AUTH_TOKEN=      # set to require token-based auth
# ZIGBEE2MQTT_CONFIG_FRONTEND_URL=             # external URL for OAuth redirects

# --- Advanced ---
# ZIGBEE2MQTT_CONFIG_ADVANCED_LOG_LEVEL=info   # debug | info | warn | error
# ZIGBEE2MQTT_CONFIG_ADVANCED_LOG_OUTPUT=console  # console | file | syslog (comma-separated)
# ZIGBEE2MQTT_CONFIG_ADVANCED_LOG_DIRECTORY=/app/data/log
# ZIGBEE2MQTT_CONFIG_ADVANCED_CHANNEL=11       # Zigbee channel (11, 15, 20, 25 recommended)
# ZIGBEE2MQTT_CONFIG_ADVANCED_NETWORK_KEY=GENERATE  # 16-byte hex array or GENERATE
# ZIGBEE2MQTT_CONFIG_ADVANCED_PAN_ID=GENERATE
# ZIGBEE2MQTT_CONFIG_ADVANCED_EXT_PAN_ID=GENERATE
# ZIGBEE2MQTT_CONFIG_ADVANCED_LAST_SEEN=disable  # disable | ISO_8601 | ISO_8601_local | epoch
# ZIGBEE2MQTT_CONFIG_ADVANCED_ELAPSED=false
# ZIGBEE2MQTT_CONFIG_ADVANCED_TRANSMIT_POWER=   # adapter-dependent, e.g. 20 for CC2652P
# ZIGBEE2MQTT_CONFIG_ADVANCED_ADAPTER_CONCURRENT_LIMIT=16

# --- Home Assistant Integration ---
# ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_ENABLED=true
# ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_DISCOVERY_TOPIC=homeassistant
# ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_STATUS_TOPIC=homeassistant/status
# ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_LEGACY_ENTITY_ATTRIBUTES=true
# ZIGBEE2MQTT_CONFIG_HOMEASSISTANT_LEGACY_TRIGGERS=true

# --- Availability ---
# ZIGBEE2MQTT_CONFIG_AVAILABILITY_ENABLED=true
# ZIGBEE2MQTT_CONFIG_AVAILABILITY_ACTIVE_TIMEOUT=10    # minutes for mains-powered devices
# ZIGBEE2MQTT_CONFIG_AVAILABILITY_PASSIVE_TIMEOUT=1500 # minutes for battery devices

# --- Device Options (defaults applied to all devices) ---
# ZIGBEE2MQTT_CONFIG_DEVICE_OPTIONS_RETAIN=false
# ZIGBEE2MQTT_CONFIG_DEVICE_OPTIONS_FRIENDLY_NAME=
# ZIGBEE2MQTT_CONFIG_DEVICE_OPTIONS_DEBOUNCE=0

# --- OTA Updates ---
# ZIGBEE2MQTT_CONFIG_OTA_UPDATE_CHECK_INTERVAL=1440    # minutes between checks
# ZIGBEE2MQTT_CONFIG_OTA_DISABLE_AUTOMATIC_UPDATE_CHECK=false
