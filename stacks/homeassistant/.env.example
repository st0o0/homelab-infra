# ============================================================
# Optional — uncomment to override defaults
# ============================================================

# Home Assistant
# HA_SERIAL_DEVICE=/dev/serial1
# HA_PORT=8123
# HA_PATH_CONFIG=./data
# HA_MAC_DEFAULT=02:42:ac:11:00:02
# HA_MAC_VLAN=02:42:ac:12:00:02
# HA_VLAN_IP=10.44.88.254

# MQTT
# MQTT_PORT=8124
# MQTT_PATH_CONFIG=./mosquitto/config
# MQTT_PATH_DATA=./mosquitto/data
# MQTT_PATH_LOG=./mosquitto/log

# Zigbee2MQTT
# Z2M_PORT=8125
# Z2M_PATH_DATA=./zigbee2mqtt/data

# Matter
# MATTER_LOG_LEVEL=info
# MATTER_BLE_PROXY=true
# MATTER_PATH_DATA=./matter/data

# Njord
# NJORD_PORT=9090
# NJORD_HEALTH_PORT=9091
# NJORD_POLL_INTERVAL=01:00:00
# NJORD_FORECAST_DAYS=7
# NJORD_LOCATION_NAME=vreden
# NJORD_LOCATION_LAT=52.0379
# NJORD_LOCATION_LON=6.828

# Network
# HA_VLAN_PARENT=vlan88
# HA_VLAN_SUBNET=10.44.88.0/24

# TZ=Europe/Berlin
