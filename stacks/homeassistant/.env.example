# ============================================================
# Optional -- uncomment to override defaults
# ============================================================

# Home Assistant
# HA_SERIAL_DEVICE=/dev/serial1
# HA_PORT=8123
# HA_PATH_CONFIG=./data
# HA_BRIDGE_MAC=      # required, MAC on the default bridge network
# HA_IOT_MAC=         # required, MAC on the IoT VLAN
# HA_IOT_IP=          # required, IP of HA on the IoT VLAN
# HA_IOT_SUBNET=      # required, IoT VLAN subnet
# HA_IOT_PARENT=      # required, host VLAN interface (macvlan parent)

# MQTT
# MQTT_PORT=8124
# MQTT_PATH_CONFIG=./mosquitto/config
# MQTT_PATH_DATA=./mosquitto/data
# MQTT_PATH_LOG=./mosquitto/log

# Zigbee2MQTT
# Z2M_PORT=8125
# Z2M_PATH_DATA=./zigbee2mqtt/data

# Matter
# MATTER_LOG_LEVEL=info
# MATTER_BLE_PROXY=true
# MATTER_PATH_DATA=./matter/data

# TZ=Europe/Berlin

# ============================================================
# PostgreSQL (recorder backend)
# ============================================================
# HA_RECORDER_DB_URL=postgresql+psycopg2://USER:PASS@HOST:PORT/homeassistant
#
# Ensure the HA database exists on your PostgreSQL server:
#   CREATE DATABASE homeassistant;
#   CREATE USER homeassistant WITH PASSWORD 'changeme';
#   GRANT ALL PRIVILEGES ON DATABASE homeassistant TO homeassistant;
