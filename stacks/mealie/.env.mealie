###############################################################################
# Mealie Environment Variables
# https://docs.mealie.io/documentation/getting-started/installation/backend-config/
#
# All variables support the _FILE suffix for Docker secrets.
# Example: POSTGRES_PASSWORD_FILE=/run/secrets/db_password
###############################################################################

# =============================================================================
# General
# =============================================================================

# Application title displayed in the UI
# PUID=1000

# Process group ID
# PGID=1000

# Timezone
# TZ=UTC

# Application URL (used for links in emails and notifications)
# BASE_URL=http://localhost:9925

# API port
# API_PORT=9000

# Enable demo mode (read-only, no auth)
# DEMO=false

# Default group name for new installations
# DEFAULT_GROUP=Home

# Default email for admin user
# DEFAULT_EMAIL=changeme@example.com

# Default password for admin user
# DEFAULT_PASSWORD=

# Allow new user signups
# ALLOW_SIGNUP=true

# Max number of users (0 = unlimited)
# MAX_USERS=0

# Token expiration time in hours
# TOKEN_TIME=48

# Auto-update on container restart
# AUTO_FORM_URLS=

# Log level: INFO, DEBUG, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database engine: sqlite, postgres
# DB_ENGINE=sqlite

# PostgreSQL hostname
# POSTGRES_SERVER=

# PostgreSQL port
# POSTGRES_PORT=5432

# PostgreSQL username
# POSTGRES_USER=mealie

# PostgreSQL password
# POSTGRES_PASSWORD=

# PostgreSQL database name
# POSTGRES_DB=mealie

# PostgreSQL URL override (overrides individual vars)
# POSTGRES_URL_OVERRIDE=

# =============================================================================
# SMTP / Email
# =============================================================================

# SMTP server hostname
# SMTP_HOST=

# SMTP server port
# SMTP_PORT=587

# Sender email address
# SMTP_FROM_NAME=Mealie

# Sender email address
# SMTP_FROM_EMAIL=

# SMTP authentication type: tls, ssl, none
# SMTP_AUTH_STRATEGY=tls

# SMTP username
# SMTP_USER=

# SMTP password
# SMTP_PASSWORD=

# =============================================================================
# LDAP
# =============================================================================

# Enable LDAP authentication
# LDAP_AUTH_ENABLED=false

# LDAP server URL
# LDAP_SERVER_URL=

# LDAP TLS insecure (skip verification)
# LDAP_TLS_INSECURE=false

# LDAP TLS CA certificate file
# LDAP_TLS_CACERTFILE=

# Enable STARTTLS
# LDAP_ENABLE_STARTTLS=false

# LDAP base DN
# LDAP_BASE_DN=

# LDAP query bind DN
# LDAP_QUERY_BIND=

# LDAP query bind password
# LDAP_QUERY_PASSWORD=

# LDAP user filter
# LDAP_USER_FILTER=

# LDAP admin filter
# LDAP_ADMIN_FILTER=

# LDAP ID attribute
# LDAP_ID_ATTRIBUTE=uid

# LDAP mail attribute
# LDAP_MAIL_ATTRIBUTE=mail

# LDAP name attribute
# LDAP_NAME_ATTRIBUTE=cn

# =============================================================================
# OpenID Connect (OIDC)
# =============================================================================

# Enable OIDC authentication
# OIDC_AUTH_ENABLED=false

# OIDC configuration URL (.well-known/openid-configuration)
# OIDC_CONFIGURATION_URL=

# OIDC client ID
# OIDC_CLIENT_ID=

# OIDC client secret
# OIDC_CLIENT_SECRET=

# OIDC scopes
# OIDC_SCOPES=openid profile email

# OIDC provider name (displayed on login button)
# OIDC_PROVIDER_NAME=OAuth

# Automatically redirect to OIDC provider
# OIDC_AUTO_REDIRECT=false

# OIDC user group claim
# OIDC_USER_GROUP=

# OIDC admin group claim
# OIDC_ADMIN_GROUP=

# OIDC groups claim key
# OIDC_GROUPS_CLAIM=groups

# Remember OIDC session
# OIDC_REMEMBER_ME=false

# Sign OIDC token algorithm
# OIDC_SIGNING_ALGORITHM=RS256

# User provisioning (create user on first login)
# OIDC_USER_PROVISION=true

# =============================================================================
# Scraper / Recipe Import
# =============================================================================

# Use OpenAI for recipe parsing
# OPENAI_BASE_URL=

# OpenAI API key
# OPENAI_API_KEY=

# OpenAI model to use
# OPENAI_MODEL=gpt-4o

# Enable OpenAI image services
# OPENAI_ENABLE_IMAGE_SERVICES=false

# Request timeout for scraper (seconds)
# OPENAI_REQUEST_TIMEOUT=30

# Number of workers for recipe import
# OPENAI_WORKERS=2

# =============================================================================
# Theming
# =============================================================================

# Custom theme light primary color (hex)
# THEME_LIGHT_PRIMARY=#E58325

# Custom theme light accent color (hex)
# THEME_LIGHT_ACCENT=#007A33

# Custom theme light secondary color (hex)
# THEME_LIGHT_SECONDARY=#973542

# Custom theme dark primary color (hex)
# THEME_DARK_PRIMARY=#E58325

# Custom theme dark accent color (hex)
# THEME_DARK_ACCENT=#007A33

# Custom theme dark secondary color (hex)
# THEME_DARK_SECONDARY=#973542

# =============================================================================
# Security
# =============================================================================

# Allowed CORS origins (comma-separated, or * for all)
# SECURITY_ALLOWED_ORIGINS=

# Max login attempts before lockout
# SECURITY_MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
# SECURITY_USER_LOCKOUT_TIME=24
