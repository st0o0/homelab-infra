# ============================================================
# Required — stack will not start without these
# ============================================================
MEALIE_DB_PASS=changeme
MEALIE_DB_HOST=changeme
MEALIE_PATH_DATA=changeme

# ============================================================
# Optional — uncomment to override container defaults
# ============================================================
# MEALIE_PORT=9925
# MEALIE_ALLOW_SIGNUP=false
# MEALIE_ALLOW_PASSWORD_LOGIN=false
# MEALIE_BASE_URL=
# MEALIE_DB_USER=mealie
# MEALIE_DB_PORT=5432
# MEALIE_DB_NAME=mealie
# PUID=1000
# PGID=1000
# TZ=Europe/Berlin

# OIDC (all optional, leave empty to disable)
# MEALIE_OIDC_ENABLED=
# MEALIE_OIDC_PROVIDER_NAME=
# MEALIE_OIDC_CONFIG_URL=
# MEALIE_OIDC_CLIENT_ID=
# MEALIE_OIDC_CLIENT_SECRET=
# MEALIE_OIDC_SIGNUP_ENABLED=
# MEALIE_OIDC_USER_GROUP=
# MEALIE_OIDC_ADMIN_GROUP=
# MEALIE_OIDC_USER_HOUSEHOLD=
# MEALIE_OIDC_AUTO_REDIRECT=
# MEALIE_OIDC_REMEMBER_ME=
