# ============================================================
# Required — stack will not start without these
# ============================================================
# Generate hashes with: just k hash <password>
# Format: username:bcrypt-hash:role (comma-separated)
NTFY_AUTH_USERS='user1:$2a$10$HASH:admin,user2:$2a$10$HASH:user,grafana:$2a$10$HASH:user'
# Format: username:topic-pattern:permission (comma-separated)
NTFY_AUTH_ACCESS='user1:*:rw,user2:*:ro,grafana:alerts-*:wo'
# Format: username:token:label (comma-separated)
NTFY_AUTH_TOKENS='grafana:tk_CHANGEME:grafana-contact-point'

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# NTFY_PORT=8080
# TZ=Europe/Berlin
