# Required
REMOTE_WRITE_URL=changeme
LOGS_PUSH_URL=changeme

# Optional
# HOST_HOSTNAME=myhost          # defaults to system hostname

# Optional
# ALLOY_CONTAINER_NAME=alloy
# CADVISOR_CONTAINER_NAME=cadvisor
# SCRAPE_INTERVAL=30s
# TZ=Europe/Berlin

# Feature toggles (env-var only, no manual file copies needed)
# NUT_ENABLED=true              → enable UPS monitoring
# NUT_EXPORTER_TARGET=nut-exporter:9199
# SECURITY_LOGS_ENABLED=true    → enable security log collection (fail2ban, auditd, rkhunter, clamav, lynis)

# Bifrost mode: no file copy needed. Komodo selects it per host via
# stack.config.file_paths in komodo/resources/stacks.toml:
#   file_paths = ["compose.yml", "compose.override.bifrost.yaml"]
# Requires a running Bifrost container on the same host (deploy stacks/bifrost first)
# BIFROST_CONTAINER_NAME=bifrost
