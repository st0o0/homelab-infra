# ============================================================
# Required — stack will not start without these
# ============================================================
ALLOY_REMOTE_WRITE_URL=changeme
ALLOY_LOGS_PUSH_URL=changeme
GEOIPUPDATE_ACCOUNT_ID=changeme
GEOIPUPDATE_LICENSE_KEY=changeme
# ALLOY_NUT_EXPORTER_TARGET=nut-exporter:9199
#
# --- NUT exporter overrides (used by compose.override.nut-exporter.yaml) ---
# ALLOY_NUT_EXP_SERVER=nut-upsd
# ALLOY_NUT_EXP_SERVER_PORT=3493
# ALLOY_NUT_EXP_USER=changeme
# ALLOY_NUT_EXP_PASS=changeme

# ============================================================
# Optional — uncomment to override defaults
# ============================================================
# ALLOY_HOSTNAME=myhost
# ALLOY_SCRAPE_INTERVAL=30s
# ALLOY_NUT_ENABLED=false
# ALLOY_SECURITY_LOGS_ENABLED=false
#
# --- PVE metrics (exporter runs on Proxmox host as systemd service) ---
# ALLOY_PVE_METRICS_ENABLED=false
# ALLOY_PVE_EXPORTER_TARGET=proxmox-host:9221
#
# --- DB metrics (Phase 2) ---
# ALLOY_POSTGRES_METRICS_ENABLED=false
# ALLOY_POSTGRES_DSN=postgresql://monitoring:password@postgres:5432/postgres?sslmode=disable
# ALLOY_IMMICH_POSTGRES_DSN=postgresql://monitoring:password@immich-postgres:5432/immich?sslmode=disable
# ALLOY_REDIS_METRICS_ENABLED=false
# ALLOY_REDIS_ADDR=redis:6379
# ALLOY_REDIS_PASSWORD=changeme
# ALLOY_MONGODB_METRICS_ENABLED=false
# ALLOY_MONGODB_URI=mongodb://monitoring:password@mongodb:27017
# ALLOY_PIHOLE_METRICS_ENABLED=false
# ALLOY_PIHOLE_METRICS_TARGET=pihole-exporter:9617
#
# --- Exporter overrides (used by compose overrides) ---
# ALLOY_PIHOLE_EXPORTER_HOSTNAME=changeme            # comma-separated for multi-instance: host1,host2,host3
# ALLOY_PIHOLE_EXPORTER_PASSWORD=changeme             # comma-separated matching hostname order, or single value for all
# ALLOY_PIHOLE_EXPORTER_PORT=80                       # comma-separated per-instance, or single value for all
# ALLOY_PIHOLE_EXPORTER_PROTOCOL=http                 # comma-separated per-instance, or single value for all
#
# --- App metrics (Phase 1) ---
# ALLOY_AUTHENTIK_METRICS_ENABLED=false
# ALLOY_AUTHENTIK_METRICS_TARGET=authentik-server:9300
# ALLOY_BACKREST_METRICS_ENABLED=false
# ALLOY_BACKREST_METRICS_TARGET=backrest:9898
# ALLOY_VAULTWARDEN_METRICS_ENABLED=false
# ALLOY_VAULTWARDEN_METRICS_TARGET=vaultwarden:80
# ALLOY_VAULTWARDEN_METRICS_TOKEN=changeme
# ALLOY_IMMICH_METRICS_ENABLED=false
# ALLOY_IMMICH_METRICS_SERVER_TARGET=immich-server:8081
# ALLOY_IMMICH_METRICS_MICROSERVICES_TARGET=immich-server:8082
# ALLOY_JELLYFIN_METRICS_ENABLED=false
# ALLOY_JELLYFIN_METRICS_TARGET=jellyfin:8096
# ALLOY_HOMEASSISTANT_METRICS_ENABLED=false
# ALLOY_HOMEASSISTANT_METRICS_TARGET=homeassistant:8123
# ALLOY_HOMEASSISTANT_METRICS_TOKEN=changeme
# TZ=Europe/Berlin
#
# --- Caddy metrics (reverse proxy on same host) ---
# ALLOY_CADDY_METRICS_ENABLED=false
# ALLOY_CADDY_METRICS_TARGET=caddy:2019
#
# --- CrowdSec metrics (security engine on same host) ---
# ALLOY_CROWDSEC_METRICS_ENABLED=false
# ALLOY_CROWDSEC_METRICS_TARGET=crowdsec:6060
#
# --- GeoIP database update frequency (hours) ---
# GEOIPUPDATE_FREQUENCY=24
#
# --- cAdvisor tuning ---
# ALLOY_CADVISOR_DOCKER_ONLY=false
# ALLOY_CADVISOR_STORE_LABELS=true
#
# --- Go runtime tuning (use with compose.override.low-power.yaml) ---
# ALLOY_GOGC=100
# ALLOY_GOMEMLIMIT=200MiB
# ALLOY_GOMAXPROCS=2
