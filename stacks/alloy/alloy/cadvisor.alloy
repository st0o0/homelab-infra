prometheus.exporter.cadvisor "containers" {
  docker_host             = "unix:///var/run/docker.sock"
  docker_only             = coalesce(sys.env("CADVISOR_DOCKER_ONLY"), "false") == "true"
  store_container_labels  = coalesce(sys.env("CADVISOR_STORE_LABELS"), "true") == "true"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
}

prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    action       = "labeldrop"
    regex        = "container_label_com_docker_compose_.*"
  }

  rule {
    action       = "labeldrop"
    regex        = "container_label_org_opencontainers_.*"
  }
}
