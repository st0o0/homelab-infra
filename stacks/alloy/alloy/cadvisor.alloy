prometheus.exporter.cadvisor "containers" {
  docker_host             = "unix:///var/run/docker.sock"
  docker_only             = coalesce(sys.env("CADVISOR_DOCKER_ONLY"), "false") == "true"
  store_container_labels  = coalesce(sys.env("CADVISOR_STORE_LABELS"), "true") == "true"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
}

prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    action       = "labeldrop"
    regex        = "container_label_com_docker_compose_.*"
  }

  rule {
    action       = "labeldrop"
    regex        = "container_label_org_opencontainers_.*"
  }

  rule {
    action       = "labeldrop"
    regex        = "container_label_restartcount"
  }

  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "container_(cpu_(usage_seconds_total|cfs_(throttled_)?periods_total|system_seconds_total|user_seconds_total)|memory_(working_set_bytes|rss|cache|swap|max_usage_bytes)|spec_memory_limit_bytes|fs_(usage_bytes|reads_bytes_total|writes_bytes_total)|network_(receive|transmit)_(bytes_total|errors_total|packets_dropped_total)|start_time_seconds|last_seen|oom_events_total|health_state|pressure_(cpu|memory|io)_waiting_seconds_total)|machine_memory_bytes"
  }
}
