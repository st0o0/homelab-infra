otelcol.receiver.docker_stats "default" {
  endpoint            = "unix:///var/run/docker.sock"
  collection_interval = coalesce(env("SCRAPE_INTERVAL"), "30s")

  output {
    metrics = [otelcol.exporter.prometheus.docker.input]
  }
}

otelcol.exporter.prometheus "docker" {
  forward_to = [prometheus.remote_write.central.receiver]
}
