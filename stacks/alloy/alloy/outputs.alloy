prometheus.remote_write "central" {
  endpoint {
    url = sys.env("REMOTE_WRITE_URL")

    queue_config {
      max_shards           = 5
      max_samples_per_send = 5000
      batch_send_deadline  = "15s"
    }
  }
  wal {
    max_keepalive_time = "24h"
  }
  external_labels = {
    host = sys.env("HOST_HOSTNAME"),
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("LOGS_PUSH_URL") + "?_msg_field=msg,message,log,text&_stream_fields=host,job,filename,container,event_type,action,proto,priority,jail,scenario,status_class,domain"
  }
  external_labels = {
    host = sys.env("HOST_HOSTNAME"),
  }
}
