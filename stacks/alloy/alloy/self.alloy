prometheus.scrape "alloy" {
  targets = [{
    __address__ = "localhost:12345",
  }]
  forward_to      = [prometheus.relabel.alloy.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "alloy" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    source_labels = ["host"]
    target_label  = "endpoint"
  }

  rule {
    regex        = "host"
    action       = "labeldrop"
  }

  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "alloy_(component_(controller_running_components|evaluation_seconds_(sum|count))|config_last_load_successful|prometheus_relabel_cache_(hits|misses)|resources_process_(cpu_seconds_total|resident_memory_bytes))|loki_(source_(docker_target_entries_total|file_files_active_total)|write_(dropped_(entries|bytes)_total|sent_(entries|bytes)_total|request_duration_seconds_(sum|count)))|prometheus_(remote_(storage_(samples_(total|failed_total|retried_total|pending)|highest_timestamp_in_seconds|shards(_desired|_max)?|sent_batch_duration_seconds_(sum|count)|bytes_total)|write_wal_storage_active_series)|scrape_targets_gauge|target_scrape_pool_targets)|scrape_(samples_scraped|duration_seconds)|up"
  }
}
