prometheus.scrape "alloy" {
  targets = [{
    __address__ = "localhost:12345",
  }]
  forward_to      = [prometheus.relabel.alloy.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "alloy" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    source_labels = ["host"]
    target_label  = "endpoint"
  }

  rule {
    regex        = "host"
    action       = "labeldrop"
  }

  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "(alloy_component_(evaluation_seconds|dependencies_wait_seconds)|prometheus_(fanout_latency|target_interval_length_histogram_seconds|target_sync_length_histogram_seconds|remote_storage_sent_batch_duration_seconds)|remotecfg_request_duration_seconds|loki_write_request_duration_seconds)_(bucket|sum|count)"
  }

  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "alloy_component_graph_connection|net_conntrack_dialer_conn_failed_total|alloy_fanout_mapping_store_mappings_total"
  }
}
