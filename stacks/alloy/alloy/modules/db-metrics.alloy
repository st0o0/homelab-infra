declare "db_metrics" {
  argument "scrape_interval" {
    optional = true
    default  = "30s"
  }

  argument "forward_to" {
    optional = false
  }

  // Postgres
  argument "postgres_enabled" {
    optional = true
    default  = "false"
  }

  argument "postgres_dsn" {
    optional = true
    default  = "postgresql://invalid:5432/none?sslmode=disable"
  }

  argument "immich_postgres_dsn" {
    optional = true
    default  = "postgresql://invalid:5432/none?sslmode=disable"
  }

  // Redis
  argument "redis_enabled" {
    optional = true
    default  = "false"
  }

  argument "redis_addr" {
    optional = true
    default  = "redis:6379"
  }

  argument "redis_password" {
    optional = true
    default  = ""
  }

  // MongoDB
  argument "mongodb_enabled" {
    optional = true
    default  = "false"
  }

  argument "mongodb_uri" {
    optional = true
    default  = ""
  }

  // Pihole exporter (standalone container, scrape only)
  argument "pihole_enabled" {
    optional = true
    default  = "false"
  }

  argument "pihole_target" {
    optional = true
    default  = "pihole-exporter:9617"
  }

  // --- Postgres ---
  prometheus.exporter.postgres "main" {
    data_source_names = [argument.postgres_dsn.value]
    autodiscovery {
      enabled = true
    }
  }

  discovery.relabel "postgres_main" {
    targets = prometheus.exporter.postgres.main.targets
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
    rule {
      replacement   = argument.postgres_enabled.value
      target_label  = "__tmp_enabled"
    }
  }

  prometheus.scrape "postgres_main" {
    targets         = discovery.relabel.postgres_main.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "postgres"
  }

  prometheus.exporter.postgres "immich" {
    data_source_names = [argument.immich_postgres_dsn.value]
    autodiscovery {
      enabled = true
    }
  }

  discovery.relabel "postgres_immich" {
    targets = prometheus.exporter.postgres.immich.targets
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
    rule {
      replacement   = argument.postgres_enabled.value
      target_label  = "__tmp_enabled"
    }
  }

  prometheus.scrape "postgres_immich" {
    targets         = discovery.relabel.postgres_immich.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "immich-postgres"
  }

  // --- Redis ---
  prometheus.exporter.redis "main" {
    redis_addr     = argument.redis_addr.value
    redis_password = argument.redis_password.value
  }

  discovery.relabel "redis" {
    targets = prometheus.exporter.redis.main.targets
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
    rule {
      replacement   = argument.redis_enabled.value
      target_label  = "__tmp_enabled"
    }
  }

  prometheus.scrape "redis" {
    targets         = discovery.relabel.redis.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "redis"
  }

  // --- MongoDB ---
  prometheus.exporter.mongodb "main" {
    mongodb_uri = argument.mongodb_uri.value
  }

  discovery.relabel "mongodb" {
    targets = prometheus.exporter.mongodb.main.targets
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
    rule {
      replacement   = argument.mongodb_enabled.value
      target_label  = "__tmp_enabled"
    }
  }

  prometheus.scrape "mongodb" {
    targets         = discovery.relabel.mongodb.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "mongodb"
  }

  // --- Pi-hole exporter (standalone container) ---
  discovery.relabel "pihole" {
    targets = [{
      __address__   = argument.pihole_target.value,
      __tmp_enabled = argument.pihole_enabled.value,
    }]
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
  }

  prometheus.scrape "pihole" {
    targets         = discovery.relabel.pihole.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "pihole"
  }
}
