declare "auth_log" {
  argument "enabled" {
    optional = true
    default  = "false"
  }

  argument "forward_to" {
    optional = false
  }

  local.file_match "auth" {
    path_targets = [
      {__path__ = "/var/log/host/auth.log", job = "auth", __tmp_enabled = argument.enabled.value},
    ]
  }

  discovery.relabel "auth" {
    targets = local.file_match.auth.targets

    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
  }

  loki.source.file "auth" {
    targets    = discovery.relabel.auth.output
    forward_to = [loki.process.auth.receiver]
  }

  loki.process "auth" {
    stage.regex {
      expression = "^(?P<timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})"
    }

    stage.timestamp {
      source = "timestamp"
      format = "Jan  2 15:04:05"
    }

    // SSH accepted: "Accepted publickey for <user> from <ip>"
    stage.regex {
      expression = "sshd\\[\\d+\\]: Accepted \\S+ for (?P<ssh_accepted_user>\\S+) from (?P<ssh_accepted_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // SSH invalid user: "Failed password for invalid user <user> from <ip>"
    stage.regex {
      expression = "sshd\\[\\d+\\]: Failed password for invalid user (?P<ssh_invalid_user>\\S+) from (?P<ssh_invalid_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // SSH failed: "Failed password for <user> from <ip>"
    stage.regex {
      expression = "sshd\\[\\d+\\]: Failed password for (?P<ssh_failed_user>\\S+) from (?P<ssh_failed_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // Sudo success: "<user> : TTY=..."
    stage.regex {
      expression = "sudo:\\s+(?P<sudo_success_user>\\S+)\\s+: TTY="
    }

    // Sudo failed: "<user> : N incorrect password attempts"
    stage.regex {
      expression = "sudo:\\s+(?P<sudo_failed_user>\\S+)\\s+: \\d+ incorrect password attempt"
    }

    stage.metrics {
      metric.counter {
        name              = "auth_ssh_accepted_total"
        description       = "SSH logins accepted"
        source            = "ssh_accepted_user"
        action            = "inc"
        prefix            = ""
        max_idle_duration = "24h"
      }
      metric.counter {
        name              = "auth_ssh_failed_total"
        description       = "SSH logins failed"
        source            = "ssh_failed_user"
        action            = "inc"
        prefix            = ""
        max_idle_duration = "24h"
      }
      metric.counter {
        name              = "auth_ssh_invalid_user_total"
        description       = "SSH logins for non-existent users"
        source            = "ssh_invalid_user"
        action            = "inc"
        prefix            = ""
        max_idle_duration = "24h"
      }
      metric.counter {
        name              = "auth_sudo_success_total"
        description       = "Successful sudo invocations"
        source            = "sudo_success_user"
        action            = "inc"
        prefix            = ""
        max_idle_duration = "24h"
      }
      metric.counter {
        name              = "auth_sudo_failed_total"
        description       = "Failed sudo attempts"
        source            = "sudo_failed_user"
        action            = "inc"
        prefix            = ""
        max_idle_duration = "24h"
      }
    }

    forward_to = argument.forward_to.value
  }
}
