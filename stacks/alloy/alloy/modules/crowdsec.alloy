declare "crowdsec" {
  argument "enabled" {
    optional = true
    default  = "false"
  }

  argument "target" {
    optional = true
    default  = "crowdsec:6060"
  }

  argument "scrape_interval" {
    optional = true
    default  = "30s"
  }

  argument "forward_to" {
    optional = false
  }

  discovery.relabel "crowdsec" {
    targets = [{
      __address__   = argument.target.value,
      __tmp_enabled = argument.enabled.value,
    }]
    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
    rule {
      target_label = "instance"
      replacement  = sys.env("HOST_HOSTNAME")
    }
  }

  prometheus.scrape "crowdsec" {
    targets         = discovery.relabel.crowdsec.output
    forward_to      = argument.forward_to.value
    scrape_interval = argument.scrape_interval.value
    job_name        = "crowdsec"
    metrics_path    = "/metrics"
  }
}
