# ──────────────────────────────────────────────
# pgAdmin
# ──────────────────────────────────────────────

# required
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PATH_DATA=

# optional
# PGADMIN_PORT=5050

# ──────────────────────────────────────────────
# Mongonaut
# ──────────────────────────────────────────────

# required - mongodb connection string (e.g. mongodb://user:pass@mongodb:27017)
MONGO_CONNECTION_URL=

# required - secret for session auth (generate with: openssl rand -base64 32)
MONGONAUT_AUTH_SECRET=

# optional
# MONGONAUT_PORT=8081
# MONGONAUT_READONLY=false
