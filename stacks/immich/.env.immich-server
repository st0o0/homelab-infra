###############################################################################
# Immich Server Environment Variables
# https://immich.app/docs/install/environment-variables
#
# Many variables support the _FILE suffix for Docker secrets.
# Example: DB_PASSWORD_FILE=/run/secrets/db_password
###############################################################################

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# PostgreSQL hostname
DB_HOSTNAME=CHANGE_ME

# PostgreSQL port
# DB_PORT=5432

# PostgreSQL username
DB_USERNAME=CHANGE_ME

# PostgreSQL password
DB_PASSWORD=CHANGE_ME

# PostgreSQL database name
# DB_DATABASE_NAME=immich

# Full database URL (overrides individual DB_* vars)
# DB_URL=

# Database connection pool size
# DB_VECTOR_EXTENSION=pgvecto.rs

# =============================================================================
# Redis
# =============================================================================

# Redis hostname
REDIS_HOSTNAME=CHANGE_ME

# Redis port
# REDIS_PORT=6379

# Redis database number
# REDIS_DBINDEX=0

# Redis password
# REDIS_PASSWORD=

# Redis username
# REDIS_USERNAME=

# Redis socket path (overrides hostname/port)
# REDIS_SOCKET=

# Full Redis URL (overrides individual REDIS_* vars)
# REDIS_URL=

# =============================================================================
# Machine Learning
# =============================================================================

# Machine learning URL
# IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# Enable machine learning
# IMMICH_MACHINE_LEARNING_ENABLED=true

# ML model for CLIP (image search)
# MACHINE_LEARNING_CLIP_MODEL=ViT-B-32__openai

# ML model for facial recognition
# MACHINE_LEARNING_FACIAL_RECOGNITION_MODEL=buffalo_l

# ML cache folder
# MACHINE_LEARNING_CACHE_FOLDER=/cache

# ML request threads
# MACHINE_LEARNING_REQUEST_THREADS=0

# ML worker timeout in seconds
# MACHINE_LEARNING_WORKER_TIMEOUT=120

# =============================================================================
# Server / General
# =============================================================================

# Upload location for assets
# UPLOAD_LOCATION=/usr/src/app/upload

# Immich server port
# IMMICH_PORT=2283

# Immich host
# IMMICH_HOST=0.0.0.0

# Immich media location
# IMMICH_MEDIA_LOCATION=/usr/src/app/upload

# External domain (for shared links)
# IMMICH_API_URL_EXTERNAL=

# Trusted proxies (comma-separated CIDRs)
# IMMICH_TRUSTED_PROXIES=

# =============================================================================
# Telemetry
# =============================================================================

# Enable telemetry (anonymous usage data)
# IMMICH_TELEMETRY_INCLUDE=all

# Disable telemetry
# IMMICH_TELEMETRY_EXCLUDE=

# Metrics port
# IMMICH_METRICS_PORT=8081

# Enable Prometheus metrics
# IMMICH_METRICS=false

# Enable API metrics
# IMMICH_API_METRICS_PORT=8082

# Enable microservices metrics
# IMMICH_MICROSERVICES_METRICS_PORT=8083

# =============================================================================
# Workers / Job Configuration
# =============================================================================

# Number of worker threads
# IMMICH_WORKERS_INCLUDE=api

# Exclude specific workers
# IMMICH_WORKERS_EXCLUDE=

# Thumbnail generation concurrency
# IMMICH_MICROSERVICES_WORKERS=

# =============================================================================
# Storage / Paths
# =============================================================================

# Thumbnail storage location
# IMMICH_THUMBNAILS_LOCATION=

# Encoded video storage location
# IMMICH_ENCODED_VIDEO_LOCATION=

# Profile image location
# IMMICH_PROFILE_IMAGE_LOCATION=

# =============================================================================
# Transcoding
# =============================================================================

# FFmpeg threads (0 = auto)
# IMMICH_FFMPEG_THREADS=0

# Hardware acceleration: nvenc, qsv, vaapi, rkmpp, disabled
# IMMICH_FFMPEG_ACCEL=disabled

# Preferred HW device
# IMMICH_FFMPEG_ACCEL_DEVICE=

# =============================================================================
# Timezone / Locale
# =============================================================================

# Timezone
# TZ=UTC

# Node.js environment
# NODE_ENV=production

# =============================================================================
# Logging
# =============================================================================

# Log level: verbose, debug, log, warn, error
# IMMICH_LOG_LEVEL=log

# Enable color in logs
# NO_COLOR=
