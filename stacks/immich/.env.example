# ============================================================
# Required — stack will not start without these
# ============================================================
IMMICH_DB_HOST=changeme
IMMICH_DB_PASS=changeme
IMMICH_PATH_UPLOAD=changeme
IMMICH_PATH_CACHE=changeme
CIFS_IMMICH_MEDIA_HOST=changeme
CIFS_IMMICH_MEDIA_SHARE=changeme
CIFS_IMMICH_MEDIA_USER=changeme
CIFS_IMMICH_MEDIA_PASS=changeme

# ============================================================
# Optional — uncomment to override container defaults
# ============================================================
# IMMICH_PORT=2283
# IMMICH_DB_PORT=5432
# IMMICH_DB_USER=postgres
# IMMICH_DB_NAME=immich
# IMMICH_REDIS_HOSTNAME=valkey
# TZ=Europe/Berlin
# PUID=1000
# PGID=1000
