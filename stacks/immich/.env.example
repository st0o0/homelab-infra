# ============================================================
# Required — stack will not start without these
# ============================================================
IMMICH_DB_HOST=changeme
IMMICH_DB_PASS=changeme
IMMICH_REDIS_HOST=changeme
IMMICH_REDIS_PASS=changeme
IMMICH_PATH_UPLOAD=changeme
IMMICH_PATH_CACHE=changeme
IMMICH_PATH_CONFIG=changeme
CIFS_IMMICH_MEDIA_HOST=changeme
CIFS_IMMICH_MEDIA_SHARE=changeme
CIFS_IMMICH_MEDIA_USER=changeme
CIFS_IMMICH_MEDIA_PASS=changeme

# ============================================================
# OAuth (used by envsubst to generate immich.config.json)
# ============================================================
IMMICH_OAUTH_CLIENT_ID=changeme
IMMICH_OAUTH_CLIENT_SECRET=changeme
IMMICH_OAUTH_ISSUER_URL=changeme

# ============================================================
# Optional — uncomment to override container defaults
# ============================================================
# IMMICH_PORT=2283
# IMMICH_DB_PORT=5432
# IMMICH_DB_USER=postgres
# IMMICH_DB_NAME=immich
# IMMICH_REDIS_PORT=6379
# IMMICH_REDIS_DBINDEX=0
# IMMICH_TRUSTED_PROXIES=
# IMMICH_TELEMETRY_INCLUDE=all
# IMMICH_API_METRICS_PORT=8081
# IMMICH_MICROSERVICES_METRICS_PORT=8082
# IMMICH_ML_WORKERS=1
# IMMICH_ML_MODEL_TTL=600
# TZ=Europe/Berlin
# PUID=1000
# PGID=1000
