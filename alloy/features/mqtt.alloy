discovery.relabel "mqtt" {
  targets = [{
    __address__ = coalesce(sys.env("MQTT_EXPORTER_TARGET"), "mqtt-exporter:9234"),
  }]
  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "mqtt" {
  targets         = discovery.relabel.mqtt.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  job_name        = "mqtt"
}
