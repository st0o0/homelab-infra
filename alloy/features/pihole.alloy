discovery.relabel "pihole" {
  targets = [{
    __address__ = coalesce(sys.env("PIHOLE_METRICS_TARGET"), "pihole-exporter:9617"),
  }]

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "pihole" {
  targets         = discovery.relabel.pihole.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "90s"
  job_name        = "pihole"
}
