discovery.relabel "immich" {
  targets = [
    { __address__ = coalesce(sys.env("IMMICH_METRICS_SERVER_TARGET"), "immich-server:8081") },
    { __address__ = coalesce(sys.env("IMMICH_METRICS_MICROSERVICES_TARGET"), "immich-server:8082") },
  ]
  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "immich" {
  targets         = discovery.relabel.immich.output
  forward_to      = [prometheus.relabel.immich.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  job_name        = "immich"
}

prometheus.relabel "immich" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    action        = "drop"
    source_labels = ["__name__"]
    regex         = "django_http_requests_latency_seconds_by_view_method_bucket"
  }
}
