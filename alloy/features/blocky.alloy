prometheus.scrape "blocky" {
  targets = [
    { __address__ = coalesce(sys.env("BLOCKY_1_METRICS_TARGET"), "blocky:4000") },
    { __address__ = coalesce(sys.env("BLOCKY_2_METRICS_TARGET"), "blocky:4000") },
  ]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  scrape_timeout  = "10s"
  job_name        = "blocky"
  metrics_path    = "/metrics"
}
