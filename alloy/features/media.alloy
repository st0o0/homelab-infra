discovery.relabel "jellyfin" {
  targets = [{
    __address__ = coalesce(sys.env("JELLYFIN_EXPORTER_TARGET"), "media-jellyfin-exporter:9594"),
  }]
  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "jellyfin" {
  targets         = discovery.relabel.jellyfin.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  job_name        = "jellyfin"
}
