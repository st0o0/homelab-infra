discovery.relabel "media" {
  targets = [{
    __address__ = coalesce(sys.env("TENTACLE_TARGET"), "tentacle:9594"),
  }]
  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "media" {
  targets         = discovery.relabel.media.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  scrape_timeout  = "30s"
  metrics_path    = "/metrics"
  job_name        = "media"
}
