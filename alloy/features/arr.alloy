discovery.relabel "sonarr" {
  targets = [{
    __address__ = coalesce(sys.env("SONARR_EXPORTER_TARGET"), "arr-sonarr-exporter:9707"),
  }]
  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "sonarr" {
  targets         = discovery.relabel.sonarr.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  job_name        = "sonarr"
}

