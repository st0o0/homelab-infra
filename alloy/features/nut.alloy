discovery.relabel "mjolnir" {
  targets = [{
    __address__ = "mjolnir:9550",
  }]

  rule {
    replacement  = sys.env("HOST_HOSTNAME")
    target_label = "instance"
  }
}

prometheus.scrape "mjolnir" {
  targets         = discovery.relabel.mjolnir.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = coalesce(sys.env("SCRAPE_INTERVAL"), "30s")
  job_name        = "mjolnir"
  metrics_path    = "/metrics"
}
