declare "crowdsec" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "crowdsec_alerts" {
    path_targets = [
      {__path__ = "/var/log/host/crowdsec/alerts.ndjson", job = "crowdsec"},
    ]
  }

  loki.source.file "crowdsec_alerts" {
    targets    = local.file_match.crowdsec_alerts.targets
    forward_to = [loki.process.crowdsec_alerts.receiver]
  }

  loki.process "crowdsec_alerts" {
    stage.json {
      expressions = {
        time         = "time",
        scenario     = "scenario",
        ip           = "ip",
        type         = "type",
        duration     = "duration",
        country      = "country",
        asname       = "asname",
        events_count = "events_count",
      }
    }

    stage.regex {
      expression = "\"origin\":\\s*\"(?P<origin>[^\"]+)\""
    }

    stage.timestamp {
      source = "time"
      format = "2006-01-02T15:04:05Z"
    }

    stage.labels {
      values = {
        scenario = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "{{ .type }} {{ .ip }} ({{ .country }}/{{ .asname }}) {{ .scenario }} [{{ .duration }}]{{ if .events_count }} ({{ .events_count }} events{{ if .origin }}, {{ .origin }}{{ end }}){{ end }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
