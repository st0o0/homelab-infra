declare "crowdsec" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "crowdsec_alerts" {
    path_targets = [
      {__path__ = "/var/log/host/crowdsec/alerts.ndjson", job = "crowdsec"},
    ]
  }

  loki.source.file "crowdsec_alerts" {
    targets    = local.file_match.crowdsec_alerts.targets
    forward_to = [loki.process.crowdsec_alerts.receiver]
  }

  loki.process "crowdsec_alerts" {
    stage.json {
      expressions = {
        time         = "time",
        scenario     = "scenario",
        client_ip    = "ip",
        type         = "type",
        duration     = "duration",
        country      = "country",
        asname       = "asname",
        as_num       = "as_num",
        events_count = "events_count",
        simulated    = "simulated",
        scope        = "scope",
        range        = "range",
        start_at     = "start_at",
        stop_at      = "stop_at",
        machine_id   = "machine_id",
      }
    }

    stage.regex {
      expression = "\"origin\":\\s*\"(?P<origin>[^\"]+)\""
    }

    stage.timestamp {
      source = "time"
      format = "2006-01-02T15:04:05Z"
    }

    stage.geoip {
      source  = "client_ip"
      db      = "/geoip/GeoLite2-City.mmdb"
      db_type = "city"
    }

    stage.static_labels {
      values = {
        level = "warn",
      }
    }

    stage.labels {
      values = {
        scenario           = "",
        simulated          = "",
        scope              = "",
        client_ip          = "",
        geoip_country_code         = "",
        geoip_country_name         = "",
        geoip_location_latitude    = "",
        geoip_location_longitude   = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "CrowdSec {{ .type }} {{ .client_ip }} ({{ .country }}/{{ .asname }}) {{ .scenario }} [{{ .duration }}]{{ if .events_count }} ({{ .events_count }} events{{ if .origin }}, {{ .origin }}{{ end }}){{ end }}{{ if eq .simulated \"true\" }} [SIMULATED]{{ end }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
