declare "fail2ban" {
  argument "enabled" {
    optional = true
    default  = "false"
  }

  argument "forward_to" {
    optional = false
  }

  local.file_match "fail2ban" {
    path_targets = [
      {__path__ = "/var/log/host/fail2ban.log", job = "fail2ban", __tmp_enabled = argument.enabled.value},
    ]
  }

  discovery.relabel "fail2ban" {
    targets = local.file_match.fail2ban.targets

    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
  }

  loki.source.file "fail2ban" {
    targets    = discovery.relabel.fail2ban.output
    forward_to = [loki.process.fail2ban.receiver]
  }

  loki.process "fail2ban" {
    stage.multiline {
      firstline     = "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
      max_wait_time = "3s"
    }

    stage.regex {
      expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}),\\d+ fail2ban\\.(?P<component>\\S+)\\s+\\[\\d+\\]:\\s+(?P<priority>\\w+)\\s+(?:\\[(?P<jail>\\S+)\\]\\s+)?(?P<content>.+)"
    }
    stage.timestamp {
      source = "timestamp"
      format = "2006-01-02 15:04:05"
    }

    stage.template {
      source   = "level"
      template = "{{ if or (eq .priority \"ERROR\") }}error{{ else if eq .priority \"WARNING\" }}warn{{ else }}info{{ end }}"
    }

    stage.labels {
      values = {
        priority = "",
        jail     = "",
        level    = "",
      }
    }

    // Ban: "NOTICE  [<jail>] Ban <ip>"
    stage.regex {
      expression = "fail2ban\\.actions\\s+\\[\\d+\\]: NOTICE\\s+\\[(?P<ban_jail>\\S+)\\] Ban (?P<ban_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // Unban: "NOTICE  [<jail>] Unban <ip>"
    stage.regex {
      expression = "fail2ban\\.actions\\s+\\[\\d+\\]: NOTICE\\s+\\[(?P<unban_jail>\\S+)\\] Unban (?P<unban_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // Found: "INFO    [<jail>] Found <ip>"
    stage.regex {
      expression = "fail2ban\\.filter\\s+\\[\\d+\\]: INFO\\s+\\[(?P<found_jail>\\S+)\\] Found (?P<found_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    // Already banned: "NOTICE  [<jail>] Already banned <ip>"
    stage.regex {
      expression = "fail2ban\\.actions\\s+\\[\\d+\\]: NOTICE\\s+\\[(?P<already_jail>\\S+)\\] Already banned (?P<already_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    stage.template {
      source   = "formatted"
      template = "{{ if .ban_ip }}BAN {{ .ban_ip }} [{{ .ban_jail }}]{{ else if .unban_ip }}UNBAN {{ .unban_ip }} [{{ .unban_jail }}]{{ else if .found_ip }}FOUND {{ .found_ip }} [{{ .found_jail }}]{{ else if .already_ip }}ALREADY_BANNED {{ .already_ip }} [{{ .already_jail }}]{{ else }}{{ .content }}{{ end }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
