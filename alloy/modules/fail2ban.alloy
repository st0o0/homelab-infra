declare "fail2ban" {
  argument "enabled" {
    optional = true
    default  = "false"
  }

  argument "forward_to" {
    optional = false
  }

  local.file_match "fail2ban" {
    path_targets = [
      {__path__ = "/var/log/host/fail2ban.log", job = "fail2ban", __tmp_enabled = argument.enabled.value},
    ]
  }

  discovery.relabel "fail2ban" {
    targets = local.file_match.fail2ban.targets

    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }
  }

  loki.source.file "fail2ban" {
    targets    = discovery.relabel.fail2ban.output
    forward_to = [loki.process.fail2ban.receiver]
  }

  loki.process "fail2ban" {
    stage.multiline {
      firstline     = "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
      max_wait_time = "3s"
    }

    stage.regex {
      expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}),\\d+ fail2ban\\.(?P<component>\\S+)\\s+\\[\\d+\\]:\\s+(?P<priority>\\w+)\\s+(?:\\[(?P<jail>\\S+)\\]\\s+)?(?P<content>.+)"
    }
    stage.timestamp {
      source = "timestamp"
      format = "2006-01-02 15:04:05"
    }

    stage.template {
      source   = "level"
      template = "{{ if or (eq .priority \"ERROR\") }}error{{ else if eq .priority \"WARNING\" }}warn{{ else }}info{{ end }}"
    }

    stage.regex {
      expression = "\\[(?P<jail>\\S+)\\]\\s+(?P<action>Ban|Unban|Found|Already banned|Increase Ban|Restore Ban)\\s+(?P<client_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)"
    }

    stage.labels {
      values = {
        priority  = "",
        jail      = "",
        action    = "",
        client_ip = "",
        level     = "",
      }
    }

    stage.geoip {
      source  = "client_ip"
      db      = "/geoip/GeoLite2-City.mmdb"
      db_type = "city"
    }

    stage.labels {
      values = {
        geoip_country_code = "",
        geoip_country_name = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "{{ if .action }}{{ .action }} {{ .client_ip }} [{{ .jail }}]{{ else }}{{ .content }}{{ end }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
