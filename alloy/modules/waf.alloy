declare "waf" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "waf" {
    path_targets = [
      {__path__ = "/var/log/host/caddy/waf.log", job = "waf"},
    ]
  }

  loki.source.file "waf" {
    targets    = local.file_match.waf.targets
    forward_to = [loki.process.waf.receiver]
  }

  loki.process "waf" {
    stage.json {
      expressions = {
        client_ip = "transaction.client_ip",
        uri       = "transaction.request.uri",
        method    = "transaction.request.method",
        status    = "transaction.response.status",
      }
    }

    stage.regex {
      expression = "\"id\":\\s*(?P<rule_id>\\d+)"
    }

    stage.regex {
      expression = "\"severity\":\\s*(?P<severity>\\d+)"
    }

    stage.regex {
      expression = "\"msg\":\\s*\"(?P<rule_msg>[^\"]+)\""
    }

    stage.regex {
      expression = "attack-(?P<attack_category>[a-z]+)"
    }

    stage.match {
      selector = "{job=\"waf\"}"
      pipeline_name = "geoip"

      stage.geoip {
        source  = "client_ip"
        db      = "/geoip/GeoLite2-City.mmdb"
        db_type = "city"
      }
    }

    stage.static_labels {
      values = {
        level = "warn",
      }
    }

    stage.labels {
      values = {
        client_ip          = "",
        uri                = "",
        method             = "",
        rule_id            = "",
        severity           = "",
        attack_category    = "",
        geoip_country_code = "",
        geoip_country_name = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "WAF block rule={{ .rule_id }} {{ .method }} {{ .uri }} from {{ .client_ip }}{{ if .attack_category }} [{{ .attack_category }}{{ if .severity }}/sev{{ .severity }}{{ end }}]{{ end }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
