declare "caddy" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "caddy" {
    path_targets = [
      {__path__ = "/var/log/host/caddy/access.log", job = "caddy"},
    ]
  }

  loki.source.file "caddy" {
    targets    = local.file_match.caddy.targets
    forward_to = [loki.process.caddy.receiver]
  }

  loki.process "caddy" {
    stage.drop {
      expression = "\"uri\":\\s*\"/(health|ready|live|ping)"
    }

    stage.json {
      expressions = {
        ts            = "ts",
        level         = "level",
        client_ip     = "request.client_ip",
        host          = "request.host",
        uri           = "request.uri",
        method        = "request.method",
        user_agent    = "request.headers.User-Agent",
        status        = "status",
        duration      = "duration",
        response_size = "size",
      }
    }

    stage.timestamp {
      source = "ts"
      format = "RFC3339Nano"
    }

    stage.template {
      source   = "status_class"
      template = "{{ if ge .status 500 }}5xx{{ else if ge .status 400 }}4xx{{ else if ge .status 300 }}3xx{{ else }}2xx{{ end }}"
    }

    stage.match {
      selector = "{job=\"caddy\"}"
      pipeline_name = "geoip"

      stage.geoip {
        source  = "client_ip"
        db      = "/geoip/GeoLite2-City.mmdb"
        db_type = "city"
      }
    }

    stage.template {
      source   = "domain"
      template = "{{ regexReplaceAll \":443$\" .host \"\" }}"
    }

    stage.labels {
      values = {
        level              = "",
        client_ip          = "",
        domain             = "",
        uri                = "",
        method             = "",
        user_agent         = "",
        status             = "",
        status_class       = "",
        duration           = "",
        response_size      = "",
        geoip_country_code = "",
        geoip_country_name = "",
        geoip_city_name    = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "{{ .method }} {{ .status }} {{ .duration }}s {{ .domain }} {{ .uri }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
