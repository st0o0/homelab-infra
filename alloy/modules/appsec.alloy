declare "appsec" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "appsec" {
    path_targets = [
      {__path__ = "/var/log/host/crowdsec/appsec.ndjson", job = "appsec"},
    ]
  }

  loki.source.file "appsec" {
    targets    = local.file_match.appsec.targets
    forward_to = [loki.process.appsec.receiver]
  }

  loki.process "appsec" {
    stage.json {
      expressions = {
        time           = "time",
        scenario       = "scenario",
        client_ip      = "ip",
        country        = "country",
        asname         = "asname",
        as_num         = "as_num",
        log_type       = "log_type",
        rule_name      = "rule_name",
        target_uri     = "target_uri",
        target_host    = "target_host",
        method         = "method",
        inband_action  = "inband_action",
        matched_zones  = "matched_zones",
        user_agent     = "user_agent",
        req_uuid       = "req_uuid",
      }
    }

    stage.timestamp {
      source = "time"
      format = "2006-01-02T15:04:05Z"
    }

    stage.replace {
      expression = "^https?://[^/]+"
      replace    = ""
      source     = "target_uri"
    }

    stage.geoip {
      source  = "client_ip"
      db      = "/geoip/GeoLite2-City.mmdb"
      db_type = "city"
    }

    stage.static_labels {
      values = {
        level = "warn",
      }
    }

    stage.labels {
      values = {
        scenario           = "",
        log_type           = "",
        rule_name          = "",
        target_host        = "",
        country            = "",
        client_ip          = "",
        method             = "",
        inband_action      = "",
        geoip_country_code = "",
        geoip_country_name = "",
      }
    }

    stage.template {
      source   = "formatted"
      template = "AppSec [{{ .inband_action }}] {{ .method }} {{ .client_ip }} ({{ .country }}/{{ .asname }}) {{ .rule_name }} {{ .target_host }}{{ .target_uri }}"
    }

    stage.output {
      source = "formatted"
    }

    forward_to = argument.forward_to.value
  }
}
