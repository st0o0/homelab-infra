declare "honeypot" {
  argument "forward_to" {
    optional = false
  }

  discovery.docker "ran" {
    host = "unix:///var/run/docker.sock"
    filter {
      name   = "name"
      values = ["ran"]
    }
  }

  discovery.relabel "ran" {
    targets = discovery.docker.ran.targets

    rule {
      source_labels = ["__meta_docker_container_name"]
      regex         = "/(.*)"
      target_label  = "container"
    }

    rule {
      replacement  = "honeypot"
      target_label = "job"
    }
  }

  loki.source.docker "ran" {
    host       = "unix:///var/run/docker.sock"
    targets    = discovery.relabel.ran.output
    forward_to = [loki.process.honeypot.receiver]
  }

  loki.process "honeypot" {
    stage.json {
      expressions = {
        ts         = "time",
        level      = "level",
        msg        = "msg",
        protocol   = "protocol",
        source_ip  = "source_ip",
        action     = "action",
        session_id = "session_id",
      }
    }

    stage.timestamp {
      source = "ts"
      format = "RFC3339Nano"
    }

    stage.labels {
      values = {
        level    = "",
        protocol = "",
        src_ip   = "source_ip",
        action   = "",
      }
    }

    stage.output {
      source = "msg"
    }

    forward_to = argument.forward_to.value
  }
}
