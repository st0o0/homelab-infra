declare "honeypot" {
  argument "forward_to" {
    optional = false
  }

  local.file_match "caddy_honeypot" {
    path_targets = [
      {__path__ = "/var/log/host/caddy/honeypot.log", job = "honeypot"},
    ]
  }

  loki.source.file "caddy_honeypot" {
    targets    = local.file_match.caddy_honeypot.targets
    forward_to = [loki.process.caddy_honeypot.receiver]
  }

  loki.process "caddy_honeypot" {
    stage.json {
      expressions = {
        ts         = "ts",
        client_ip  = "request.client_ip",
        host       = "request.host",
        uri        = "request.uri",
        method     = "request.method",
        user_agent = "request.headers.User-Agent",
        status     = "status",
      }
    }

    stage.timestamp {
      source = "ts"
      format = "RFC3339Nano"
    }

    stage.match {
      selector = "{job=\"honeypot\"}"
      pipeline_name = "geoip"

      stage.geoip {
        source  = "client_ip"
        db      = "/geoip/GeoLite2-City.mmdb"
        db_type = "city"
      }
    }

    stage.template {
      source   = "domain"
      template = "{{ .host }}"
    }

    stage.labels {
      values = {
        client_ip          = "",
        domain             = "",
        uri                = "",
        method             = "",
        user_agent         = "",
        status             = "",
        geoip_country_code = "",
        geoip_city         = "",
        geoip_latitude     = "",
        geoip_longitude    = "",
      }
    }

    stage.json {
      expressions = {
        msg = "msg",
      }
    }

    stage.output {
      source = "msg"
    }

    forward_to = argument.forward_to.value
  }
}
