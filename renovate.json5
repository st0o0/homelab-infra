{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>st0o0/renovate-config',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
    'helpers:githubDigestChangelogs',
    'workarounds:doNotUpgradeFromAlpineStableToEdge',
  ],
  dependencyDashboard: false,
  ignorePaths: ['ansible/report/**'],
  commitMessageExtra: '({{packageFileDir}})',
  hostRules: [
    {
      matchHost: 'docker.io',
      concurrentRequestLimit: 2,
    },
    {
      matchHost: 'ghcr.io',
      concurrentRequestLimit: 2,
    },
  ],
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)compose\\.ya?ml$/',
      '/(^|/)compose\\.override\\.[\\w.-]+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'pip install (?<depName>\\S+)==(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'version:\\s+"(?<currentValue>[^"]+)"\\s*\\n\\s*#\\s*renovate:\\s*depName=(?<depName>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Pinned versions in shell scripts with renovate comments',
      managerFilePatterns: [
        '/scripts/.+\\.sh$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>.+))?\\n\\w+="(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      description: 'Inline renovate comments in workflow files',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        ':\\s*"?(?<currentValue>v?\\d[\\d.]*[^\\s"\'#]*)"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Group Caddy builder and runtime together (must stay version-aligned)',
      groupName: 'caddy',
      matchPackageNames: ['caddy'],
    },
    {
      description: 'Group Immich components together (must stay version-aligned)',
      groupName: 'immich',
      matchPackageNames: [
        'ghcr.io/immich-app/immich-server',
        'ghcr.io/immich-app/immich-machine-learning',
      ],
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'devcontainer-tooling',
      matchManagers: ['custom.regex'],
      matchFileNames: ['scripts/**/*.sh'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchPackageNames: [
        'ghcr.io/st0o0/mjolnir',
      ],
      pinDigests: true,
    },
    {
      enabled: false,
      matchPackageNames: [
        '/njord/',
        '/mediathekarr/',
      ],
    },
    {
      matchPackageNames: [
        'redis',
        'maxmindinc/geoipupdate',
      ],
      versioning: 'docker',
    },
    {
      description: 'Authentik requires sequential minor upgrades (no skipping)',
      matchPackageNames: ['ghcr.io/goauthentik/server'],
      separateMultipleMinor: true,
    },
    // sourceUrl overrides for correct release notes
    {
      matchPackageNames: ['caddy'],
      sourceUrl: 'https://github.com/caddyserver/caddy',
    },
    {
      matchPackageNames: ['ghcr.io/veerendra2/speedtest_exporter'],
      sourceUrl: 'https://github.com/veerendra2/speedtest_exporter',
    },
    {
      matchPackageNames: ['jlesage/firefox'],
      sourceUrl: 'https://github.com/jlesage/docker-firefox',
    },
    {
      matchPackageNames: ['ghcr.io/home-operations/sonarr'],
      sourceUrl: 'https://github.com/Sonarr/Sonarr',
    },
    {
      matchPackageNames: ['ghcr.io/home-operations/radarr'],
      sourceUrl: 'https://github.com/Radarr/Radarr',
    },
    {
      matchPackageNames: ['ghcr.io/home-operations/prowlarr'],
      sourceUrl: 'https://github.com/Prowlarr/Prowlarr',
    },
    {
      matchPackageNames: ['ghcr.io/home-operations/sabnzbd'],
      sourceUrl: 'https://github.com/sabnzbd/sabnzbd',
    },
    {
      matchPackageNames: [
        'ghcr.io/moghtech/komodo-core',
        'ghcr.io/moghtech/komodo-periphery',
      ],
      sourceUrl: 'https://github.com/moghtech/komodo',
    },
    {
      matchPackageNames: ['maxmindinc/geoipupdate'],
      sourceUrl: 'https://github.com/maxmind/geoipupdate',
    },
    {
      matchPackageNames: ['vaultwarden/server'],
      sourceUrl: 'https://github.com/dani-garcia/vaultwarden',
    },
    {
      matchPackageNames: [
        'ghcr.io/immich-app/immich-server',
        'ghcr.io/immich-app/immich-machine-learning',
        'ghcr.io/immich-app/postgres',
      ],
      sourceUrl: 'https://github.com/immich-app/immich',
    },
    {
      matchPackageNames: ['ghcr.io/goauthentik/server'],
      sourceUrl: 'https://github.com/goauthentik/authentik',
    },
    {
      matchPackageNames: ['ghcr.io/home-assistant/home-assistant'],
      sourceUrl: 'https://github.com/home-assistant/core',
    },
    {
      matchPackageNames: [
        'victoriametrics/victoria-metrics',
        'victoriametrics/vmalert',
        'victoriametrics/victoria-logs',
      ],
      sourceUrl: 'https://github.com/VictoriaMetrics/VictoriaMetrics',
    },
    {
      matchPackageNames: ['docker.io/valkey/valkey'],
      sourceUrl: 'https://github.com/valkey-io/valkey',
    },
    {
      matchPackageNames: ['sapcc/mosquitto-exporter'],
      sourceUrl: 'https://github.com/sapcc/mosquitto-exporter',
    },
    {
      matchPackageNames: ['sigoden/dufs'],
      sourceUrl: 'https://github.com/sigoden/dufs',
    },
    {
      matchPackageNames: ['dialmaster/youtarr'],
      sourceUrl: 'https://github.com/dialmaster/youtarr',
    },
    {
      matchPackageNames: ['ghcr.io/matter-js/matterjs-server'],
      sourceUrl: 'https://github.com/matter-js/matterjs-server',
    },
    {
      matchPackageNames: ['crowdsecurity/crowdsec'],
      sourceUrl: 'https://github.com/crowdsecurity/crowdsec',
    },
    {
      matchPackageNames: ['traefik/whoami'],
      sourceUrl: 'https://github.com/traefik/whoami',
    },
    {
      matchPackageNames: ['kopia/kopia'],
      sourceUrl: 'https://github.com/kopia/kopia',
    },
    {
      matchPackageNames: ['jellyfin/jellyfin'],
      sourceUrl: 'https://github.com/jellyfin/jellyfin',
    },
    {
      matchPackageNames: ['ghcr.io/advplyr/audiobookshelf'],
      sourceUrl: 'https://github.com/advplyr/audiobookshelf',
    },
    {
      matchPackageNames: ['ghcr.io/mealie-recipes/mealie'],
      sourceUrl: 'https://github.com/mealie-recipes/mealie',
    },
    {
      matchPackageNames: ['eclipse-mosquitto'],
      sourceUrl: 'https://github.com/eclipse-mosquitto/mosquitto',
    },
    {
      matchPackageNames: ['ghcr.io/koenkk/zigbee2mqtt'],
      sourceUrl: 'https://github.com/Koenkk/zigbee2mqtt',
    },
    {
      matchPackageNames: ['ghcr.io/paperless-ngx/paperless-ngx'],
      sourceUrl: 'https://github.com/paperless-ngx/paperless-ngx',
    },
    {
      matchPackageNames: ['apache/tika'],
      sourceUrl: 'https://github.com/apache/tika',
    },
    {
      matchPackageNames: ['gotenberg/gotenberg'],
      sourceUrl: 'https://github.com/gotenberg/gotenberg',
    },
    {
      matchPackageNames: ['ghcr.io/qdm12/gluetun'],
      sourceUrl: 'https://github.com/qdm12/gluetun',
    },
    {
      matchPackageNames: ['grafana/alloy'],
      sourceUrl: 'https://github.com/grafana/alloy',
    },
    {
      matchPackageNames: ['grafana/grafana'],
      sourceUrl: 'https://github.com/grafana/grafana',
    },
    {
      matchPackageNames: ['ghcr.io/seerr-team/seerr'],
      sourceUrl: 'https://github.com/seerr-team/seerr',
    },
    {
      matchPackageNames: ['ghcr.io/scottrobertson/seekarr'],
      sourceUrl: 'https://github.com/scottrobertson/seekarr',
    },
    {
      matchPackageNames: ['ghcr.io/raydak-labs/configarr'],
      sourceUrl: 'https://github.com/raydak-labs/configarr',
    },
    {
      matchPackageNames: ['ghcr.io/hansmi/prometheus-paperless-exporter'],
      sourceUrl: 'https://github.com/hansmi/prometheus-paperless-exporter',
    },
  ],
  'ansible-galaxy': {
    managerFilePatterns: [
      '/ansible/requirements\\.yml$/',
    ],
  },
}
