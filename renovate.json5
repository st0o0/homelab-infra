{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
    'helpers:githubDigestChangelogs',
    'workarounds:doNotUpgradeFromAlpineStableToEdge',
    ':dependencyDashboard',
  ],
  timezone: 'Europe/Berlin',
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  rebaseWhen: 'behind-base-branch',
  configMigration: true,
  commitMessagePrefix: 'chore(deps):',
  commitMessageExtra: '({{packageFileDir}})',
  assignees: ['st0o0'],
  suppressNotifications: ['prEditedNotification'],
  vulnerabilityAlerts: {
    enabled: true,
  },
  hostRules: [
    {
      matchHost: 'docker.io',
      concurrentRequestLimit: 2,
    },
    {
      matchHost: 'ghcr.io',
      concurrentRequestLimit: 2,
    },
  ],
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)compose\\.ya?ml$/',
      '/(^|/)compose\\.override\\.[\\w.-]+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'pip install (?<depName>\\S+)==(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'version:\\s+"(?<currentValue>[^"]+)"\\s*\\n\\s*#\\s*renovate:\\s*depName=(?<depName>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Pinned versions in shell scripts with renovate comments',
      managerFilePatterns: [
        '/scripts/.+\\.sh$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>.+))?\\n\\w+="(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      description: 'Inline renovate comments in workflow files',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        ':\\s*"?(?<currentValue>v?\\d[\\d.]*[^\\s"\'#]*)"?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Pin/pinDigest updates do not support minimumReleaseAge',
      matchUpdateTypes: ['pin', 'pinDigest'],
      minimumReleaseAge: null,
    },
    {
      description: 'Automerge digest-only updates nightly',
      matchUpdateTypes: ['digest'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      automergeSchedule: ['after 2am and before 5am'],
      minimumReleaseAge: null,
    },
    {
      description: 'Group Immich components together (must stay version-aligned)',
      groupName: 'immich',
      matchPackageNames: [
        'ghcr.io/immich-app/immich-server',
        'ghcr.io/immich-app/immich-machine-learning',
      ],
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'devcontainer-tooling',
      matchManagers: ['custom.regex'],
      matchFileNames: ['scripts/**/*.sh'],
      matchUpdateTypes: ['minor', 'patch'],
    },
    {
      matchPackageNames: [
        'ghcr.io/st0o0/mjolnir',
      ],
      pinDigests: true,
    },
    {
      enabled: false,
      matchPackageNames: [
        '/njord/',
        '/mediathekarr/',
      ],
    },
    {
      matchPackageNames: [
        'redis',
        'maxmindinc/geoipupdate',
      ],
      versioning: 'docker',
    },
    {
      description: 'Authentik requires sequential minor upgrades (no skipping)',
      matchPackageNames: ['ghcr.io/goauthentik/server'],
      matchUpdateTypes: ['minor'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Stateful databases can break on minor/major upgrades',
      matchPackageNames: [
        'mongo',
        'mariadb',
      ],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Postgres needs manual dump/restore for major upgrades',
      matchPackageNames: [
        'postgres',
        'ghcr.io/immich-app/postgres',
      ],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'Throttle frequently releasing images to weekly',
      matchPackageNames: [
        'ghcr.io/home-assistant/home-assistant',
        'ghcr.io/home-operations/sonarr',
        'ghcr.io/home-operations/radarr',
        'ghcr.io/home-operations/prowlarr',
        'ghcr.io/home-operations/sabnzbd',
        'ghcr.io/paperless-ngx/paperless-ngx',
      ],
      schedule: ['on monday'],
    },
  ],
  'ansible-galaxy': {
    managerFilePatterns: [
      '/ansible/requirements\\.yml$/',
    ],
  },
}
