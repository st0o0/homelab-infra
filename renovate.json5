{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:pinDigests',
    ':dependencyDashboard',
  ],
  timezone: 'Europe/Berlin',
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  minimumReleaseAge: '3 days',
  rebaseWhen: 'conflicted',
  configMigration: true,
  commitMessagePrefix: 'chore(deps):',
  assignees: ['st0o0'],
  suppressNotifications: ['prEditedNotification'],
  vulnerabilityAlerts: {
    enabled: true,
  },
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)compose\\.ya?ml$/',
      '/(^|/)compose\\.override\\.[\\w.-]+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'pip install (?<depName>\\S+)==(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'version:\\s+"(?<currentValue>[^"]+)"\\s*\\n\\s*#\\s*renovate:\\s*depName=(?<depName>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        'docker run[^\\n]*\\s(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>v?[\\d][\\d.]+[^\\s"\']*)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchPackageNames: [
        'ghcr.io/st0o0/mjolnir',
      ],
      pinDigests: true,
    },
    {
      enabled: false,
      matchPackageNames: [
        '/njord/',
        '/mediathekarr/',
      ],
    },
    {
      matchPackageNames: [
        'redis',
        'maxmindinc/geoipupdate',
      ],
      versioning: 'docker',
    },
  ],
  'ansible-galaxy': {
    managerFilePatterns: [
      '/ansible/requirements\\.yml$/',
    ],
  },
}
